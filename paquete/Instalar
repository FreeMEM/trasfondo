; Instalador de Trasfondo para el Installer del sistema (AmigaOS 3.0 a 3.2).
; Copia Trasfondo donde se elija (o a SYS:WBStartup, para que arranque con el Workbench) y sus
; preferencias, TrasfondoPrefs, a SYS:Prefs.

(set @app-name "Trasfondo")
(set #avisos "")

(welcome "Este programa instala Trasfondo, un monitor de recursos pintado en el fondo del Workbench, escrito en Dash.")

; --- Lo que necesita (solo avisa: se instala igual) ---
(if (< (/ (getversion "exec.library" (resident)) 65536) 39)
    (set #avisos (cat #avisos "- Trasfondo necesita AmigaOS 3.0 o superior.\n")))
(if (not (exists "LIBS:commodities.library"))
    (if (not (exists "SYS:Libs/commodities.library"))
        (set #avisos (cat #avisos "- No se encuentra commodities.library: Trasfondo funcionará, pero no saldrá en Exchange.\n"))))
(if (<> #avisos "")
    (message (cat "Se instalará igual, pero ojo:\n\n" #avisos)))

; --- Dónde ---
(set #arranque
    (askbool
        (prompt "¿Quieres que Trasfondo arranque solo cada vez que se abre el Workbench?\n\n"
                "Sí: se copia a SYS:WBStartup.\nNo: se copia al cajón que elijas.")
        (help @askbool-help)
        (choices "Sí" "No")
        (default 1)))
(if #arranque
    (set #destino "SYS:WBStartup")
    (set #destino
        (askdir
            (prompt "¿Dónde copio Trasfondo?")
            (help @askdir-help)
            (default "SYS:Utilities"))))
(set @default-dest #destino)

; --- Copiar ---
(copyfiles
    (prompt "Copiando Trasfondo")
    (help @copyfiles-help)
    (source "trasfondo")
    (dest #destino)
    (infos))
(copyfiles
    (prompt "Copiando sus preferencias")
    (help @copyfiles-help)
    (source "TrasfondoPrefs")
    (dest "SYS:Prefs")
    (infos))

(exit (cat "Trasfondo está en " #destino ".\n\n"
           (if #arranque
               "Arrancará solo con el Workbench. Para verlo ya, doble clic en su icono de SYS:WBStartup.\n\n"
               "Para arrancarlo, doble clic en su icono. Para que arranque siempre, cópialo a SYS:WBStartup.\n\n")
           "Qué se ve y cómo: SYS:Prefs/TrasfondoPrefs. Para pararlo: otra vez doble clic, o Eliminar en Exchange."))
