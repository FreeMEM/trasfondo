# Prueba de arrastrar en TrasfondoArchivos con el ratón (la lanza tests/prueba_archivos.py con este guion): en
# RAM:pa, a.txt arrastrado sobre el cajón d se mueve dentro (mismo disco); b.txt arrastrado a "RAM Disk" del lateral
# también. Las filas, medidas en una captura: la ventana se abre siempre igual (70 % de la pantalla, centrada). (Con
# Mayús se copiaría, pero input_button no deja tener Mayús pulsada.)

func arrastrar(x1: Int, y1: Int, x2: Int, y2: Int, q: Int)
    input_move_screen(x1, y1, 0)
    time_delay(10)
    input_button(1, true)
    time_delay(5)
    input_move_screen(x2, y2, 1)
    time_delay(10)
    input_button(1, false)
    time_delay(60)
end

func clic_en(x: Int, y: Int)
    input_move_screen(x, y, 0)
    time_delay(5)
    input_button(1, true)
    input_button(1, false)
    time_delay(5)
end

# la caja de la ventana del explorador: x, y (o -1)
func caja_x() -> Int
    n = wm_read()
    for i in (0..n - 1)
        if str_starts(wm_title(i), "Archivos")
            return wm_box(i, 0)
        end
    end
    return -1
end

func caja_y() -> Int
    n = wm_read()
    for i in (0..n - 1)
        if str_starts(wm_title(i), "Archivos")
            return wm_box(i, 1)
        end
    end
    return -1
end

Main
    ok = dir_create("RAM:pa")
    ok = dir_create("RAM:pa/d")
    ok = file_write_text("RAM:pa/a.txt", "aaa")
    ok = file_write_text("RAM:pa/b.txt", "bbb")
    ok = file_write_text("RAM:pa/c.txt", "ccc")
    run_program("DH0:Archivos RAM:pa")
    k = 0
    while caja_x() < 0 and k < 100
        time_delay(10)
        k = k + 1
    end
    time_delay(50)
    # medido en una captura (ventana en 155,115): la zona de dibujo empieza 11 a la derecha y 21 abajo; la primera
    # fila, 58 más abajo, de 19 de alto; el nombre, a 190 del borde; "RAM Disk" del lateral, 167 bajo la ventana
    x = caja_x() + 11 + 190
    y0 = caja_y() + 21 + 58 + 9
    Print "ventana #{caja_x()},#{caja_y()}"
    arrastrar(x, y0 + 19, x + 10, y0, 0)              # a.txt sobre d
    Print "a dentro de d #{file_exists(\"RAM:pa/d/a.txt\")} #{not file_exists(\"RAM:pa/a.txt\")}"
    arrastrar(x, y0 + 19, caja_x() + 50, caja_y() + 167, 0)   # b.txt al disco RAM
    Print "b a RAM: #{file_exists(\"RAM:b.txt\")} #{not file_exists(\"RAM:pa/b.txt\")}"
    # los botones de abajo (Ferrán García): c.txt, "Copiar", doble clic en d, "Pegar". Medido en una captura: la fila
    # de botones a 478 bajo la ventana; 8 botones de 86 píxeles desde 169 a la derecha de su borde
    bx = caja_x() + 15
    by = caja_y() + 478
    clic_en(x, y0 + 19)                               # c.txt (la lista: d, c.txt)
    clic_en(bx + 43, by)                              # Copiar
    clic_en(x, y0)
    clic_en(x, y0)                                    # doble clic: dentro de d
    time_delay(30)
    clic_en(bx + 2 * 86 + 43, by)                     # Pegar
    time_delay(60)
    Print "botones #{file_exists(\"RAM:pa/d/c.txt\")}"
    input_key(0x10, 8)
    time_delay(50)
    Print "fin"
end
