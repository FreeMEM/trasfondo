# Prueba de TrasfondoArchivos con el teclado, como una persona (la lanza tests/prueba_archivos.py, con
# DH0:Archivos): en RAM:pa, copiar a.txt (Amiga+C), entrar en el cajón d (Return) y pegar (Amiga+V); subir
# (Retroceso); a.txt a la papelera (Supr); renombrar b.txt a bx.txt (escribir "b" lo elige, F2, "x", Return); un
# cajón nuevo (Amiga+N, Return); borrarlo del todo (Mayús+Supr y "D" en la pregunta); cerrar (Amiga+Q).

func tecla(c: Int, q: Int)
    input_key(c, q)
    time_delay(25)
end

func esperar_archivos() -> Bool
    for k in (0..100)
        if input_active_title() == "Archivos: RAM:pa"
            return true
        end
        time_delay(10)
    end
    return false
end

Main
    ok = dir_create("RAM:pa")
    ok = dir_create("RAM:pa/d")
    t = ""
    for k in (1..2000)
        t = t + "0123456789"
    end
    ok = file_write_text("RAM:pa/a.txt", t)
    ok = file_set_comment("RAM:pa/a.txt", "nota")
    ok = file_write_text("RAM:pa/b.txt", "bbb")
    run_program("DH0:Archivos RAM:pa")
    Print "abierta #{esperar_archivos()}"
    time_delay(50)
    tecla(0x4D, 0)                 # abajo: d
    tecla(0x4D, 0)                 # abajo: a.txt
    tecla(0x33, 8)                 # Amiga+C
    tecla(0x4C, 0)                 # arriba: d
    tecla(0x44, 0)                 # Return: entra
    tecla(0x34, 8)                 # Amiga+V
    time_delay(100)
    Print "pegado #{file_size(\"RAM:pa/d/a.txt\") == 20000} " + file_comment("RAM:pa/d/a.txt")
    tecla(0x41, 0)                 # Retroceso: sube (d elegido)
    tecla(0x4D, 0)                 # abajo: a.txt
    tecla(0x46, 0)                 # Supr: a la papelera
    time_delay(50)
    Print "papelera #{not file_exists(\"RAM:pa/a.txt\")} #{file_exists(\"RAM:.Papelera/a.txt\")} #{str_contains(file_read_text(\"RAM:.Papelera/.indice\"), \"RAM:pa/a.txt\")}"
    tecla(0x35, 0)                 # "b": salta a b.txt
    tecla(0x51, 0)                 # F2
    tecla(0x32, 0)                 # "x" antes de ".txt"
    tecla(0x44, 0)                 # Return
    time_delay(25)
    Print "renombrado #{file_exists(\"RAM:pa/bx.txt\")} #{not file_exists(\"RAM:pa/b.txt\")}"
    tecla(0x36, 8)                 # Amiga+N
    tecla(0x44, 0)                 # Return: "New drawer"
    time_delay(25)
    Print "cajon nuevo #{file_exists(\"RAM:pa/New drawer\")}"
    tecla(0x46, 1)                 # Mayús+Supr
    time_delay(25)
    tecla(0x22, 0)                 # "D": Delete
    time_delay(75)
    Print "borrado #{not file_exists(\"RAM:pa/New drawer\")}"
    # dos paneles: F3; en el de la derecha (Tab), entrar en d; Tab otra vez, bx.txt y F5: copiado a d
    tecla(0x52, 0)                 # F3
    tecla(0x42, 0)                 # Tab: el de la derecha
    tecla(0x70, 0)                 # Inicio: d
    tecla(0x44, 0)                 # Return: entra
    tecla(0x42, 0)                 # Tab: el de la izquierda
    tecla(0x35, 0)                 # "b": bx.txt
    tecla(0x54, 0)                 # F5
    time_delay(50)
    Print "dos paneles #{file_exists(\"RAM:pa/d/bx.txt\")} #{file_exists(\"RAM:pa/bx.txt\")}"
    # información de bx.txt (Amiga+I) y "s" (Guardar): los permisos y el comentario quedan como estaban (s y sin w)
    ok = file_set_protection("RAM:pa/bx.txt", 64 + 4)
    ok = file_set_comment("RAM:pa/bx.txt", "hola")
    tecla(0x35, 0)                 # "b": bx.txt
    tecla(0x17, 8)                 # Amiga+I
    time_delay(25)
    Print "info " + input_active_title()
    tecla(0x21, 0)                 # "s": Guardar
    Print "info guardada #{file_protection(\"RAM:pa/bx.txt\") & 255 == 68} " + file_comment("RAM:pa/bx.txt")
    # bx.txt a la papelera (Supr) y Amiga+Z: vuelve, y sale del índice
    tecla(0x35, 0)                 # "b"
    tecla(0x46, 0)                 # Supr
    time_delay(25)
    fuera = not file_exists("RAM:pa/bx.txt")
    tecla(0x31, 8)                 # Amiga+Z
    time_delay(50)
    Print "deshacer #{fuera} #{file_exists(\"RAM:pa/bx.txt\")} #{not str_contains(file_read_text(\"RAM:.Papelera/.indice\"), \"bx.txt\")}"
    # filtro "bx" (Amiga+F, b, x, Return): lo primero que se ve es bx.txt (sin filtro sería el cajón d); Inicio, Supr
    # lo manda a la papelera; Amiga+Z lo devuelve
    tecla(0x23, 8)                 # Amiga+F
    tecla(0x35, 0)
    tecla(0x32, 0)
    tecla(0x44, 0)
    tecla(0x70, 0)                 # Inicio
    tecla(0x46, 0)                 # Supr
    time_delay(25)
    Print "filtro #{not file_exists(\"RAM:pa/bx.txt\")} #{file_exists(\"RAM:pa/d\")}"
    tecla(0x31, 8)                 # Amiga+Z
    time_delay(25)
    # buscar "a" en los subcajones (Amiga+B, a, Return): sale d/a.txt; Inicio, Supr: a la papelera; Amiga+Z
    tecla(0x35, 8)                 # Amiga+B
    tecla(0x20, 0)                 # "a"
    tecla(0x44, 0)                 # Return
    time_delay(50)
    tecla(0x70, 0)                 # Inicio
    tecla(0x46, 0)                 # Supr
    time_delay(25)
    Print "buscar #{not file_exists(\"RAM:pa/d/a.txt\")} #{file_exists(\"RAM:pa/bx.txt\")}"
    tecla(0x31, 8)                 # Amiga+Z
    time_delay(25)
    Print "buscar deshacer #{file_exists(\"RAM:pa/d/a.txt\")}"
    tecla(0x45, 0)                 # Esc: fuera de la búsqueda
    tecla(0x10, 8)                 # Amiga+Q
    time_delay(50)
    Print "cerrada #{input_active_title() != \"Archivos: RAM:pa\"}"
    Print "fin"
end
