# un texto del catálogo con sus huecos rellenos: %s o %1 con a, %2 con b, %3 con c
func con(texto: String, a: String) -> String
    return str_replace(str_replace(texto, "%s", a), "%1", a)
end

func con2(texto: String, a: String, b: String) -> String
    return str_replace(con(texto, a), "%2", b)
end

func con3(texto: String, a: String, b: String, c: String) -> String
    return str_replace(con2(texto, a, b), "%3", c)
end

