# TrasfondoBarra: la barra de arriba del Workbench, en lugar de la barra de título de la pantalla.
#
# Un prototipo: en el centro la hora, la fecha y el tiempo; a la derecha la CPU, la memoria y la temperatura de
# la PiStorm, cada cosa en su píldora. Solo con RTG (15 bits o más): en una pantalla de paleta no se ve bien.
# Al pulsar la hora, la fecha o el tiempo se abre el panel de resumen (TrasfondoPanel, en el mismo cajón); al
# pulsar la derecha, los ajustes rápidos (TrasfondoRapido).
# Se para lanzándola otra vez, o con Ctrl-C.
#
# Ajustes (TrasfondoPrefs, o los tooltypes): CIUDAD (el lugar del tiempo, "Málaga"), o LAT y LON (36.72, -4.42);
# sin ellos no hay tiempo.

@workbench_output "NIL:"
@version "TrasfondoBarra 2.8.3"

import "dibujo.dash"
import "tiempo.dash"
import "avisos.dash"
import "ajustes.dash"
import "tema.dash"

var ver_fecha: Bool = true    # lo que enseña la barra (BARRA_VER_*): la hora, los avisos y el botón, siempre
var ver_tiempo: Bool = true
var ver_cpu: Bool = true
var ver_mem: Bool = true
var ver_temp: Bool = true
var oculta: Bool = false     # escondida desde Exchange (Ocultar o Desactivar)
var formato_hora: String = "%H:%M"   # con segundos si SEGUNDOS=SI
var alto: Int = 24           # alto de la barra (en la barra de título, el de ella)
var alto_p: Int = 18         # el de una píldora
const MARGEN = 6             # entre el borde de la pantalla y la primera píldora
const HUECO = 6              # entre dos píldoras
const RELLENO = 10           # dentro de la píldora, a cada lado del texto
const ICONO = 16             # lo que ocupa un icono dentro de su píldora

var C_FONDO: Int = 0x101317
var C_PILDORA: Int = 0x262b33
var C_TEXTO: Int = 0xe8eaed
var C_SUAVE: Int = 0x9aa0a6
var C_ACENTO: Int = 0x8ab4f8
var C_CALIENTE: Int = 0xf28b82

var ancho: Int = 640
var fuente: Int = 0
var cpu: Int = -1            # CPU de la última medida, en tantos por mil; -1 antes de la primera
var temp: Int = -1           # la de la PiStorm, en décimas de grado; -1 sin Emu68
var panel: String = "TrasfondoPanel"   # la orden que lo abre: con la ruta del cajón de la barra
var reloj_x1: Int = 0        # dónde están la hora, la fecha y el tiempo: al pulsarlos se abre el panel
var reloj_x2: Int = 0
var rapido: String = "TrasfondoRapido"   # la orden de los ajustes rápidos
var derecha_x: Int = 0       # dónde empieza el grupo de la derecha: al pulsarlo se abren los ajustes rápidos
var tic: Int = 0             # vueltas del temporizador (5 por segundo)
var aviso: String = "TrasfondoAviso"   # la orden que enseña el último aviso
var avisos_tam: Int = -1     # el tamaño de ENV:Trasfondo.avisos la última vez que se miró
var n_avisos: Int = 0
var titulo: Bool = false     # ESTILO=TITULO: dentro de la barra de título de la pantalla, a la derecha, sin taparla
var ancho_t: Int = 0         # lo que mide entonces la ventana (cambia con los textos)
var sw: Int = 0              # el ancho de la pantalla
var gad: Int = 0             # lo que ocupa el botón de profundidad de la pantalla, a la derecha
var c_barra: Int = 0xaaaaaa  # los colores de la barra de título: su fondo y su texto
var c_barra_t: Int = 0x000000

# el ancho de una píldora con ese texto (y un icono delante, si icono)
func ancho_pildora(texto: String, icono: Bool) -> Int
    w = font_text_width(texto) + 2 * RELLENO
    if icono
        w = w + ICONO + 2
    end
    return w
end

# una píldora con su texto, en x; devuelve dónde acaba
func pildora_texto(x: Int, texto: String, rgb: Int) -> Int
    w = ancho_pildora(texto, false)
    y = (alto - alto_p) / 2
    redondo(x, y, x + w - 1, y + alto_p - 1, alto_p / 2, C_PILDORA)
    pluma(rgb)
    gfx_text_at(x + RELLENO, (alto - font_height()) / 2 + font_baseline(), texto)
    return x + w
end

# la píldora del tiempo: el icono y la temperatura
func pildora_tiempo(x: Int) -> Int
    texto = grados(t_temp)
    w = ancho_pildora(texto, true)
    y = (alto - alto_p) / 2
    redondo(x, y, x + w - 1, y + alto_p - 1, alto_p / 2, C_PILDORA)
    icono_tiempo(x + RELLENO - 2 + ICONO / 2, alto / 2, ICONO, t_codigo, t_de_dia, C_PILDORA)
    pluma(C_TEXTO)
    gfx_text_at(x + RELLENO + ICONO + 2, (alto - font_height()) / 2 + font_baseline(), texto)
    return x + w
end

# dos interruptores, el icono de los ajustes rápidos
func interruptores(cx: Int, cy: Int)
    redondo(cx - 6, cy - 5, cx + 6, cy - 1, 2, C_TEXTO)
    redondo(cx - 6, cy + 1, cx + 6, cy + 5, 2, C_TEXTO)
    pluma(C_PILDORA)
    gfx_circle_fill(cx + 3, cy - 3, 1)
    gfx_circle_fill(cx - 3, cy + 3, 1)
end

# una campana pequeña, centrada en (cx, cy)
func campana(cx: Int, cy: Int, rgb: Int)
    pluma(rgb)
    gfx_circle_fill(cx, cy - 2, 4)
    gfx_rect(cx - 4, cy - 2, cx + 4, cy + 3)
    gfx_rect(cx - 6, cy + 3, cx + 6, cy + 4)
    gfx_rect(cx - 1, cy + 6, cx + 1, cy + 7)
end

func ancho_avisos() -> Int
    if n_avisos == 0
        return ICONO + RELLENO + 4
    end
    return ancho_pildora("#{n_avisos}", true) - RELLENO + 4
end

# la píldora de los avisos: la campana y cuántos hay; un punto rojo si hay alguno
func pildora_avisos(x: Int) -> Int
    texto = ""
    if n_avisos > 0
        texto = "#{n_avisos}"
    end
    w = ancho_avisos()
    y = (alto - alto_p) / 2
    redondo(x, y, x + w - 1, y + alto_p - 1, alto_p / 2, C_PILDORA)
    cx = x + RELLENO - 2 + ICONO / 2
    campana(cx, alto / 2, C_TEXTO)
    if n_avisos > 0
        pluma(C_CALIENTE)
        gfx_circle_fill(cx + 5, alto / 2 - 6, 2)
        pluma(C_TEXTO)
        gfx_text_at(x + RELLENO + ICONO + 2, (alto - font_height()) / 2 + font_baseline(), texto)
    end
    return x + w
end

# mira si cambiaron los avisos; si llegó uno nuevo, lo enseña
func mirar_avisos() -> Bool
    tam = 0
    if file_exists(AVISOS)
        tam = file_size(AVISOS)
    end
    if tam == avisos_tam
        return false
    end
    avisos_tam = tam
    antes = n_avisos
    avisos_leer()
    n_avisos = avisos_cuantos()
    if n_avisos > antes
        run_program(aviso)
    end
    return true
end

func por_ciento(milesimas: Int) -> String
    return "#{(milesimas + 5) / 10}%"
end

# ---- dentro de la barra de título de la pantalla (ESTILO=TITULO) ----

const SEP = 12               # entre dos cosas
const BORDE_T = 6            # a cada lado

# la campana y los interruptores, pequeños, para una barra de título baja
func campana_t(cx: Int, cy: Int, rgb: Int)
    if alto >= 18
        campana(cx, cy, rgb)
        return
    end
    pluma(rgb)
    gfx_circle_fill(cx, cy - 1, 2)
    gfx_rect(cx - 2, cy - 1, cx + 2, cy + 2)
    gfx_rect(cx - 4, cy + 2, cx + 4, cy + 2)
    gfx_rect(cx, cy + 4, cx, cy + 4)
end

func interruptores_t(cx: Int, cy: Int, rgb: Int, fondo: Int)
    redondo(cx - 6, cy - 4, cx + 6, cy - 1, 1, rgb)
    redondo(cx - 6, cy + 1, cx + 6, cy + 4, 1, rgb)
    pluma(fondo)
    gfx_rect(cx + 2, cy - 3, cx + 3, cy - 2)
    gfx_rect(cx - 3, cy + 2, cx - 2, cy + 3)
end

# lo que ocupa el botón de profundidad de la pantalla (y los que haya a su lado), mirando la barra de título desde
# la derecha antes de abrir la ventana: sus bordes son líneas de arriba abajo de un color que no es el de la barra
# (el texto del título nunca llena todo el alto). Sin encontrarlas, un cálculo por el alto
func medir_botones() -> Int
    izq = 0
    x = sw - 1
    while x > sw - alto * 3 and x > 0
        c = screen_pixel_rgb(x, 2)
        linea = c != c_barra and c >= 0
        y = 3
        while linea and y < alto - 2
            if screen_pixel_rgb(x, y) != c
                linea = false
            end
            y = y + 1
        end
        if linea
            izq = x                       # la más a la izquierda: el borde del botón
        end
        x = x - 1
    end
    if izq > 0
        return sw - izq + 2
    end
    return alto * 2 + 3
end

func pintar_titulo()
    hora = date_text(formato_hora)
    fecha = ""
    if ver_fecha
        fecha = date_text("%a %d %b")
    end
    hay_tiempo = t_temp != -9999 and ver_tiempo
    s = alto - 4                         # el icono del tiempo
    total = mem_chip_total() + mem_fast_total()
    usada = 0
    if total > 0
        usada = (total - mem_total()) / (total / 1000)
    end
    var der: [String] = []
    var der_c: [Int] = []
    if cpu >= 0 and ver_cpu
        der.push("CPU " + por_ciento(cpu))
        der_c.push(c_barra_t)
    end
    if ver_mem
        der.push("MEM " + por_ciento(usada))
        der_c.push(c_barra_t)
    end
    if temp >= 0 and ver_temp
        der.push(grados(temp))
        if temp >= 700
            der_c.push(C_CALIENTE)
        else
            der_c.push(c_barra_t)
        end
    end
    t_avisos = ""
    if n_avisos > 0
        t_avisos = "#{n_avisos}"
    end
    # lo que mide todo
    w = BORDE_T + font_text_width(hora)
    if fecha != ""
        w = w + SEP + font_text_width(fecha)
    end
    if hay_tiempo
        w = w + SEP + s + 2 + font_text_width(grados(t_temp))
    end
    w = w + SEP + 10 + font_text_width(t_avisos)
    for d in der
        w = w + SEP + font_text_width(d)
    end
    w = w + SEP + 14 + BORDE_T
    # solo crece: encoger y moverse son dos pasos, y entre uno y otro se veía una raya junto al botón de profundidad
    # cada vez que cambiaba el ancho del texto de la CPU (Ferrán García). Lo que sobra queda a la izquierda
    sobra = 0
    if w < ancho_t
        sobra = ancho_t - w
        w = ancho_t
    end
    if w != ancho_t                      # a su sitio, pegada al botón de profundidad
        window_move(0, sw - gad - w, 0)
        window_resize(0, w, alto)
        ancho_t = w
    end
    pluma(c_barra)
    gfx_rect(0, 0, w - 1, alto - 1)
    base = (alto - font_height()) / 2 + font_baseline()
    x = BORDE_T + sobra
    reloj_x1 = 0
    pluma(c_barra_t)
    gfx_text_at(x, base, hora)
    x = x + font_text_width(hora) + SEP
    gfx_text_at(x, base, fecha)
    if fecha != ""
        x = x + font_text_width(fecha) + SEP
    end
    if hay_tiempo
        icono_tiempo(x + s / 2, alto / 2, s, t_codigo, t_de_dia, c_barra)
        x = x + s + 2
        pluma(c_barra_t)
        gfx_text_at(x, base, grados(t_temp))
        x = x + font_text_width(grados(t_temp)) + SEP
    end
    campana_t(x + 4, alto / 2, c_barra_t)
    if n_avisos > 0
        pluma(C_CALIENTE)
        gfx_circle_fill(x + 8, 3, 2)
        pluma(c_barra_t)
        gfx_text_at(x + 11, base, t_avisos)
    end
    x = x + 10 + font_text_width(t_avisos)
    reloj_x2 = x + SEP / 2
    derecha_x = reloj_x2
    x = x + SEP
    i = 0
    while i < der.length
        pluma(der_c[i])
        gfx_text_at(x, base, der[i])
        x = x + font_text_width(der[i]) + SEP
        i = i + 1
    end
    interruptores_t(x + 7, alto / 2, c_barra_t, c_barra)
end

func pintar()
    if oculta                            # escondida desde Exchange
        return
    end
    if titulo
        pintar_titulo()
        return
    end
    pluma(C_FONDO)
    gfx_rect(0, 0, ancho - 1, alto - 1)

    # izquierda
    pildora_texto(MARGEN, "Trasfondo", C_ACENTO)

    # centro: la hora, la fecha y el tiempo
    hora = date_text(formato_hora)
    fecha = ""
    if ver_fecha
        fecha = date_text("%A, %d %B")
    end
    hay_tiempo = t_temp != -9999 and ver_tiempo
    w = ancho_pildora(hora, false)
    if fecha != ""
        w = w + HUECO + ancho_pildora(fecha, false)
    end
    if hay_tiempo
        w = w + HUECO + ancho_pildora(grados(t_temp), true)
    end
    w = w + HUECO + ancho_avisos()
    x = (ancho - w) / 2
    reloj_x1 = x
    x = pildora_texto(x, hora, C_TEXTO)
    if fecha != ""
        x = pildora_texto(x + HUECO, fecha, C_TEXTO)
    end
    if hay_tiempo
        x = pildora_tiempo(x + HUECO)
    end
    x = pildora_avisos(x + HUECO)
    reloj_x2 = x

    # derecha, de derecha a izquierda
    total = mem_chip_total() + mem_fast_total()
    usada = 0
    if total > 0
        usada = (total - mem_total()) / (total / 1000)
    end
    var textos: [String] = []
    var colores: [Int] = []
    if temp >= 0 and ver_temp
        textos.push(grados(temp))
        if temp >= 700
            colores.push(C_CALIENTE)
        else
            colores.push(C_TEXTO)
        end
    end
    if ver_mem
        textos.push("MEM " + por_ciento(usada))
        colores.push(C_TEXTO)
    end
    if cpu >= 0 and ver_cpu
        textos.push("CPU " + por_ciento(cpu))
        colores.push(C_TEXTO)
    end
    # el botón de los ajustes rápidos, del todo a la derecha
    x = ancho - MARGEN - (ICONO + RELLENO + 4)
    y = (alto - alto_p) / 2
    redondo(x, y, x + ICONO + RELLENO + 3, y + alto_p - 1, alto_p / 2, C_PILDORA)
    interruptores(x + (ICONO + RELLENO + 4) / 2, alto / 2)
    x = x - HUECO
    i = 0
    while i < textos.length
        x = x - ancho_pildora(textos[i], false)
        pildora_texto(x, textos[i], colores[i])
        x = x - HUECO
        i = i + 1
    end
    derecha_x = x
end

Window Barra
    title ""
    width 1
    height 1
    left 0
    top 0
    borderless true
    closegadget false
    dragbar false
    depthgadget false
    activate false
end

# los colores del tema (tema.dash); sin él, los de arriba
func colores()
    C_FONDO = tema_color("FONDO", C_FONDO)
    C_PILDORA = tema_color("BOTON", C_PILDORA)
    C_TEXTO = tema_color("TEXTO", C_TEXTO)
    C_SUAVE = tema_color("SUAVE", C_SUAVE)
    C_ACENTO = tema_color("ACENTO", C_ACENTO)
    C_CALIENTE = tema_color("PELIGRO", C_CALIENTE)
end

# un programa en marcha, por el puerto de su single_instance
func corriendo(nombre: String) -> Bool
    n = ports_read()
    for i in (0..n - 1)
        if port_name(i) == nombre
            return true
        end
    end
    return false
end

Main
    colores()
    if not single_instance("TrasfondoBarra")
        Print "TrasfondoBarra was already running: stopping it"
    elif rtg_get_depth() < 15
        Print "TrasfondoBarra needs an RTG screen (15 bits or more)"
    else
        ancho = rtg_get_width()
        ok = rexx_port("TRASFONDO")   # los avisos de notify() y de los guiones ARexx
        # en Exchange, como el fondo (Ferrán García): Quitar la para; Ocultar o Desactivar la esconden
        ok = cx_broker("TrasfondoBarra", program_version(), "The bar at the top of the screen", 0)
        # PROGDIR: no vale en la orden: es de cada proceso, y el de run_program es otro
        if dir_change("PROGDIR:")
            carpeta = dir_current()
            if not str_ends(carpeta, ":")
                carpeta = carpeta + "/"
            end
            panel = "\"" + carpeta + "TrasfondoPanel\""
            aviso = "\"" + carpeta + "TrasfondoAviso\""
            rapido = "\"" + carpeta + "TrasfondoRapido\""
        end
        tiempo_iniciar(ajuste("BARRA_CIUDAD", "CIUDAD", ""), ajuste("BARRA_LAT", "LAT", ""), ajuste("BARRA_LON", "LON", ""))
        titulo = str_upper(ajuste("BARRA_ESTILO", "ESTILO", "COMPLETA")) == "TITULO"
        # lo que enseña (Ferrán García: la CPU, por ejemplo, ya puede estar en el fondo)
        ver_fecha = str_upper(ajuste("BARRA_VER_FECHA", "VER_FECHA", "SI")) != "NO"
        ver_tiempo = str_upper(ajuste("BARRA_VER_TIEMPO", "VER_TIEMPO", "SI")) != "NO"
        ver_cpu = str_upper(ajuste("BARRA_VER_CPU", "VER_CPU", "SI")) != "NO"
        ver_mem = str_upper(ajuste("BARRA_VER_MEMORIA", "VER_MEMORIA", "SI")) != "NO"
        ver_temp = str_upper(ajuste("BARRA_VER_TEMPERATURA", "VER_TEMPERATURA", "SI")) != "NO"
        if str_upper(ajuste("SEGUNDOS", "SEGUNDOS", "NO")) == "SI"   # (se pinta cada segundo)
            formato_hora = "%H:%M:%S"
        end
        tam = 13
        if titulo                    # en la barra de título de la pantalla: su alto, sus colores
            sw = ancho
            alto = wm_bar_height() - 1     # (sin la línea de debajo de la barra de título)
            tam = alto - 3
            if tam < 8
                tam = 8
            end
            if screen_pen_rgb(10) >= 0
                c_barra = screen_pen_rgb(10)
                c_barra_t = screen_pen_rgb(9)
            end
            gad = wm_bar_gadgets()          # dónde empiezan los botones de la pantalla, preguntado a ella
            if gad <= 0
                gad = medir_botones()           # (si no lo sabe: por los píxeles)
            end
        end
        Barra.open
        if not titulo
            window_resize(0, ancho, alto)
        end
        gfx_mode(0)                  # el texto sin fondo: encima de las píldoras
        fuente = 0
        if titulo and tam < 11               # tan pequeña, la escalada no se lee: la del sistema
            fuente = font_open("topaz.font", 8)
        end
        if fuente == 0
            fuente = font_open("CGTriumvirate.font", tam)
        end
        if fuente == 0
            fuente = font_open("helvetica.font", tam)
        end
        if fuente != 0
            font_use(fuente)
        end
        cpu_start()
        temp = pistorm_temperature()
        avisos_tam = 0
        if file_exists(AVISOS)               # los que ya había no se enseñan otra vez
            avisos_tam = file_size(AVISOS)
            avisos_leer()
            n_avisos = avisos_cuantos()
        end
        pintar()
        EventLoop
            On Timer 200
                if break_check()
                    Stop
                end
                c = cx_command()
                if c == 5
                    Stop
                elif (c == 1 or c == 3) and not oculta
                    oculta = true                # un punto en la esquina, sin pintar
                    window_move(0, 0, 0)
                    window_resize(0, 1, 1)
                elif (c == 2 or c == 4) and oculta
                    oculta = false
                    ancho_t = 0                  # (pintar la pone otra vez en su sitio)
                    if not titulo
                        window_resize(0, ancho, alto)
                    end
                    pintar()
                end
                av_puerto()                  # lo que llegue por ARexx (NOTIFY de notify(), COUNT, CLEAR)
                tiempo_paso()
                tic = tic + 1
                if tic >= 5
                    tic = 0
                    cpu_sample()
                    cpu = cpu_total()
                    pintar()
                elif t_cambio or mirar_avisos()
                    t_cambio = false
                    pintar()
                end
            end
            On Click
                # si ya estaba abierto, se está cerrando él solo (se pulsó fuera de él): no se abre otra vez
                if click_x() >= reloj_x1 and click_x() < reloj_x2
                    if not corriendo("TrasfondoPanel")
                        if titulo                # debajo de la hora, no en medio
                            run_program(panel + " X=#{sw - gad - ancho_t}")
                        else
                            run_program(panel)
                        end
                    end
                elif click_x() >= derecha_x
                    if not corriendo("TrasfondoRapido")
                        run_program(rapido)
                    end
                end
            end
            On Close
                Stop
            end
        end
    end
end
