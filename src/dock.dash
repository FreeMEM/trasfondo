# TrasfondoDock: el dock, en un borde de la pantalla, horizontal o vertical. Lleva los programas fijados (ENV: y
# ENVARC:Trasfondo.dock, uno por línea) y, detrás, los que tienen una ventana abierta en el Workbench, cada uno con
# su icono (.info, como lo pinta el Workbench) y un punto si está abierto. Pulsar uno trae su ventana delante o, si
# no está abierto, lo lanza (C:WBRun de 3.2, o como un doble clic). Con el botón derecho o manteniéndolo pulsado, un
# menú: abrir, abrir otro, en pila o como icono (un cajón), fijarlo o quitarlo. Un icono soltado encima desde el
# Workbench se fija donde cae (escondido, en la franja del borde); arrastrando un icono fijado se cambia de sitio, y
# sacándolo del dock se quita. Las esquinas dejan ver lo que hay detrás. Solo con RTG.
#
# Ajustes (TrasfondoPrefs, o los tooltypes): POSICION (ABAJO, ARRIBA, IZQUIERDA, DERECHA; ABAJO si no), ICONO (el
# lado mínimo de un icono, 40), HUECO (entre dos iconos, 4), FONDO (TEMA, TRANSPARENTE o COLOR) y COLOR (R,G,B).
# Se para lanzándolo otra vez, o con Ctrl-C.

@workbench_output "NIL:"
@version "TrasfondoDock 2.11.3"
@catalog "Trasfondo.catalog" 1       # el de Trasfondo: los textos, en inglés; el castellano, en el catálogo

import "dibujo.dash"
import "ajustes.dash"
import "textos.dash"
import "tema.dash"
import "cajones.dash"

const LISTA = "ENV:Trasfondo.dock"
const LISTA_ARC = "ENVARC:Trasfondo.dock"
const DE_SERIE = "SYS:Utilities/MultiView\nSYS:System/Shell\nSYS:Utilities/Clock\nSYS:Tools/Calculator\nSYS:Prefs\n"
const MARCA_ARCHIVOS = "ENVARC:Trasfondo.dock_archivos"   # ya se fijó el explorador una vez (ver fijar_archivos)
const ALTO_BARRA = 24        # la barra de arriba: el dock de arriba o de los lados sale debajo
const MARGEN = 6             # entre el dock y el borde de la pantalla
const RELLENO = 6            # dentro del dock, alrededor de las casillas
const HUECO = 4              # entre dos casillas, si no se dice otro (DOCK_HUECO)
const PAD = 5                # dentro de una casilla, alrededor del icono
const R = 16                 # radio del dock
const PILDORA = 64           # escondido: lo largo de la rayita que queda en el borde
const GRUESO = 4             # y lo gruesa
const CERCA = 24             # el ratón a menos de esto del dock no lo esconde
const ESPERA_ESCONDER = 900  # ms con el ratón lejos antes de esconderse
const ARRASTRE = 6           # lo que se mueve el ratón con el botón pulsado para que sea arrastrar
const FUERA = 40             # un icono soltado a más de esto del dock sale de él
const MANTENER = 500         # ms con el botón pulsado sin moverlo: el menú (el botón derecho va a la ventana activa)

var apagado: Bool = false    # escondido desde Exchange (Ocultar o Desactivar)

# El botón izquierdo, por Commodities (cx_watch_add, sin quitárselo a nadie): mouse_button mira el puerto del ratón y no
# ve un ratón USB (Poseidon) ni los clics que llegan por input.device; así la pulsación larga y el arrastre van con
# cualquier ratón (y se pueden probar en el emulador)
const W_PULSA = 1            # cx_command da 100 + esto
const W_SUELTA = 2
var cx_ok: Bool = false
var izq: Bool = false        # pulsado, según Commodities
var cx_pendiente: [Int] = [] # las órdenes de Exchange que llegaron mientras se miraba el botón

func mirar_cx()
    if not cx_ok
        return
    end
    c = cx_command()
    while c != 0
        if c == 100 + W_PULSA
            izq = true
        elif c == 100 + W_SUELTA
            izq = false
        else
            cx_pendiente.push(c)
        end
        c = cx_command()
    end
end

func pulsado() -> Bool
    mirar_cx()
    return izq or mouse_button(0)
end
var C_DOCK: Int = 0x1b1e23
var C_BORDE: Int = 0x30353d
var C_TEXTO: Int = 0xe8eaed
var C_TESELA: Int = 0x3c414a
var C_PLACA: Int = 0x262a31    # la placa de cada icono: entre el dock y C_TESELA
var hueco: Int = HUECO       # entre dos casillas
var transparente: Bool = false   # DOCK_FONDO=TRANSPARENTE: sin placa de fondo, se ve el escritorio
var img_fondo: Int = 0       # transparente: lo que hay detrás del dock, ya hecho imagen (0 sin hacer)
var C_PUNTO: Int = 0x9aa0a6
var C_MARCA: Int = 0x8ab4f8
var C_MENU: Int = 0x2a2e35
var C_MENU_SEL: Int = 0x3c4350

const OP_FIJAR = 1
const OP_QUITAR = 2
const OP_ABRIR = 3
const OP_PILA = 4            # un cajón fijado: en pila (subdock) o como su icono
const OP_LANZAR = 5          # abrirlo (como pulsarlo; en pila, el cajón en el Workbench)

struct Item
    ruta: String = ""        # la ruta real (file_real_path, como la da wm_path)
    icono: Int = 0           # de icon_load; 0 sin icono: una tesela con la inicial
    fijo: Bool = false
    win: Int = 0             # su ventana de delante (wm_id), 0 si no está abierto
    imagen: String = ""      # una imagen PNG para el dock (ruta|imagen en la lista, o la de WBDock), "" sin ella
    img: Int = 0             # esa imagen ya a la medida de la casilla (image_from_decoded_size), 0 sin ella
    pila: Bool = false       # un cajón que al pulsarlo despliega sus programas (ruta|PILA en la lista)
    cajon: Bool = false      # un cajón o un volumen: abierto, si su ventana está en el Workbench
end

var items: [Item] = []
var lado_min: Int = 40
var lado: Int = 40           # el ancho del dock por dentro (el alto, si es horizontal): el del icono más grande
var pos: [Int] = []          # dónde empieza cada icono a lo largo del dock, dentro de la ventana
var tam: [Int] = []          # lo que ocupa cada uno a lo largo del dock
var vertical: Bool = false
var posicion: String = "ABAJO"
var sw: Int = 0              # la pantalla
var sh: Int = 0
var dx: Int = 0              # el dock en la pantalla
var dy: Int = 0
var ancho: Int = 0
var alto: Int = 0
var bajo: [Int] = []         # lo que hay detrás de las cuatro esquinas, R x R cada una (antes de taparlas)
var leido_en: Int = 0        # time_ms de la última vez que se leyeron las esquinas
var fuera_de: [Int] = []     # unos puntos justo fuera del dock cuando se leyeron: si cambian (el Workbench pinta su
                             # imagen después de arrancar el dock, o se cambia el fondo), se leen otra vez
var pendiente: [Int] = []    # un cambio de esos puntos visto en la mirada anterior: cuenta si sigue igual en esta
var franja: [Int] = []       # el fondo a lo largo del borde donde va el dock, de punta a punta: las R filas de arriba y
                             # las R de abajo (columnas, si va de lado); de ahí salen las esquinas cuando crece o
                             # encoge, sin apartarse para leer lo que tapa (se veía encoger y crecer otra vez)
var franja_de: Int = -1      # dónde empieza (dy; dx si va de lado) y su grueso (alto; ancho) al leerla
var franja_grueso: Int = -1
var wbrun: Bool = false
var f_inicial: Int = 0
var vistos_id: [Int] = []    # las ventanas ya vistas y la ruta de su programa (wm_path va al disco)
var vistos_ruta: [String] = []
var menu: Int = 0            # la ventana del menú del botón derecho, 0 si no está
var menu_de: Int = -1        # de qué icono es
var menu_ops: [Int] = []     # qué hace cada línea (OP_*)
var menu_textos: [String] = []
var menu_alto: Int = 0       # el de una línea
var f_menu: Int = 0          # su letra (0: la de la ventana)
var encima: Int = -1         # el icono que tiene el ratón encima (resaltado, con su nombre), -1 ninguno
var etiqueta: Int = 0        # la ventanita con su nombre, 0 si no está
var esconder: Bool = false   # DOCK_ESCONDER: se esconde solo y sale al acercar el ratón a su borde
var escondido: Bool = false
var lejos_desde: Int = 0     # time_ms desde que el ratón está lejos (0: está cerca)
var px: Int = 0              # la rayita de cuando está escondido: dónde y cuánto
var py: Int = 0
var pw: Int = 0
var ph: Int = 0
var bajo_rayita: [Int] = []  # lo que hay detrás de la rayita
var tic: Int = 0

# ---- la lista ----

func nombre(r: String) -> String
    i = r.length - 1
    while i >= 0 and r[i:i + 1] != "/" and r[i:i + 1] != ":"
        i = i - 1
    end
    return r[i + 1:r.length]
end

# la ruta real si el fichero está; si no, la escrita (se verá con la tesela)
func real(r: String) -> String
    x = file_real_path(r)
    if x == ""
        return r
    end
    return x
end

func leer_fijos()
    texto = file_read_text(LISTA)
    if texto == nil
        texto = DE_SERIE
    end
    for l in str_split(texto, "\n")
        l = str_trim(l)
        if l != "" and not str_starts(l, ";")
            im = ""
            en_pila = false
            barra = str_find(l, "|")             # ruta|imagen: una imagen PNG propia para el dock; |PILA, en pila
            if barra > 0
                for o in str_split(l[barra + 1:l.length], "|")
                    o = str_trim(o)
                    if str_upper(o) == "PILA"
                        en_pila = true
                    elif o != ""
                        im = o
                    end
                end
                l = str_trim(l[0:barra])
            end
            r = real(l)
            if buscar(r) < 0
                it = Item(r, icon_load(r), true, 0)
                it.imagen = im
                it.pila = en_pila
                it.cajon = es_cajon(r)
                if im == ""
                    it.imagen = imagen_wbdock(r)
                end
                items.push(it)
            end
        end
    end
end

# El explorador (TrasfondoArchivos, en este cajón) se fija una vez, al final de los fijados: en el dock de serie y en
# el de quien ya tenía su lista. Si luego lo quita, no vuelve (MARCA_ARCHIVOS). Espera a que tenga su icono, que lo
# pone el fondo al arrancar o al actualizar (lo pidió el usuario: no encontraba el explorador)
func fijar_archivos()
    if file_exists(MARCA_ARCHIVOS)
        return
    end
    r = file_real_path("PROGDIR:TrasfondoArchivos")
    if r == "" or not file_exists(r + ".info")
        return
    end
    if buscar(r) < 0
        it = Item(r, icon_load(r), true, 0)
        it.imagen = imagen_wbdock(r)
        items.push(it)
        guardar()
    end
    ok = file_write_text(MARCA_ARCHIVOS, "1\n")
end

# Las imágenes de WBDock (el dock de CoffinOS: SYS:WBStartup/WBDock, una ruta y debajo "IMAGE fichero"): las usa
# este dock para los programas que no tienen la suya, y así se ven igual de bien sin configurar nada
var wb_rutas: [String] = []
var wb_imagenes: [String] = []
var wb_leido: Bool = false

func leer_wbdock()
    wb_leido = true
    t = file_read_text("SYS:WBStartup/WBDock")
    if t == nil
        return
    end
    ruta = ""
    for l in str_split(str_replace(t, "\r", ""), "\n")
        l = str_trim(l)
        if str_starts(str_upper(l), "IMAGE ")
            if ruta != ""
                wb_rutas.push(str_lower(real(ruta)))
                wb_imagenes.push(str_trim(l[6:l.length]))
            end
            ruta = ""
        elif l != "" and not str_starts(l, ";")
            ruta = l
        end
    end
end

# la imagen de WBDock para un programa: por su ruta real o, si no, por su nombre
func imagen_wbdock(r: String) -> String
    if not wb_leido
        leer_wbdock()
    end
    rl = str_lower(r)
    for i in (0..wb_rutas.length - 1)
        if wb_rutas[i] == rl
            return wb_imagenes[i]
        end
    end
    n = str_lower(nombre(r))
    for i in (0..wb_rutas.length - 1)
        if str_lower(nombre(wb_rutas[i])) == n
            return wb_imagenes[i]
        end
    end
    # las imágenes de dock de Barjack (en CoffinOS), por el nombre del programa: "SGrab 01.png". SYS:, no System:
    # (el disco de arranque de CoffinOS): sin un volumen System, el sistema pedía meterlo
    b = "SYS:Icons/Barjack/Docks/" + nombre(r) + " 01.png"
    if file_exists(b)
        return b
    end
    return ""
end

# su imagen, a la medida de la casilla (sin deformarla), si tiene y se puede leer
func cargar_imagen(it: Item)
    if it.img != 0 or it.imagen == "" or not file_exists(it.imagen)
        return
    end
    d = image_decode(it.imagen, lado_min * 2, lado_min * 2)
    if d == 0
        return
    end
    w = image_decoded_width(d)
    h = image_decoded_height(d)
    if w > 0 and h > 0
        if w >= h
            h = h * lado_min / w
            w = lado_min
        else
            w = w * lado_min / h
            h = lado_min
        end
        if w < 1
            w = 1
        end
        if h < 1
            h = 1
        end
        it.img = image_from_decoded_size(d, w, h)
    end
    image_decoded_free(d)
end

func guardar()
    texto = ""
    for it in items
        if it.fijo
            texto = texto + it.ruta
            if it.imagen != "" and it.imagen != imagen_wbdock(it.ruta)
                texto = texto + "|" + it.imagen
            end
            if it.pila
                texto = texto + "|PILA"
            end
            texto = texto + "\n"
        end
    end
    ok = file_write_text(LISTA, texto)
    ok = file_write_text(LISTA_ARC, texto)
end

# dos rutas, la misma (en el Amiga los nombres no distinguen mayúsculas: "CLOCK" y "Clock")
func igual(a: String, b: String) -> Bool
    return str_lower(a) == str_lower(b)
end

func buscar(r: String) -> Int
    for i in (0..items.length - 1)
        if igual(items[i].ruta, r)
            return i
        end
    end
    return -1
end

# ---- dónde va cada cosa ----

# lo que mide el icono i: a lo largo del dock (a) o de través (no a)
# todas las casillas iguales: el lado del icono y su margen (el icono, escalado para caber)
func mide(i: Int, a: Bool) -> Int
    return lado_min + 2 * PAD
end

func medir()
    lado = lado_min
    pos = []
    tam = []
    p = RELLENO
    for i in (0..items.length - 1)
        if mide(i, false) > lado
            lado = mide(i, false)
        end
        pos.push(p)
        tam.push(mide(i, true))
        p = p + mide(i, true) + hueco
    end
end

func caja()
    medir()
    largo = 2 * RELLENO + lado_min + 2 * PAD
    if items.length > 0
        largo = pos[items.length - 1] + tam[items.length - 1] + RELLENO
    end
    corto = 2 * RELLENO + lado
    ancho = largo
    alto = corto
    if vertical
        ancho = corto
        alto = largo
    end
    dx = (sw - ancho) / 2
    dy = sh - alto - MARGEN
    if posicion == "ARRIBA"
        dy = ALTO_BARRA + MARGEN
    elif posicion == "IZQUIERDA"
        dx = MARGEN
        dy = (sh - alto) / 2
    elif posicion == "DERECHA"
        dx = sw - ancho - MARGEN
        dy = (sh - alto) / 2
    end
end

# la celda del icono i en la ventana: esquina (icono_x, icono_y) y tamaño (celda_w, celda_h)
func icono_x(i: Int) -> Int
    if vertical
        return RELLENO
    end
    return pos[i]
end

func icono_y(i: Int) -> Int
    if vertical
        return pos[i]
    end
    return RELLENO
end

func celda_w(i: Int) -> Int
    if vertical
        return lado
    end
    return tam[i]
end

func celda_h(i: Int) -> Int
    if vertical
        return tam[i]
    end
    return lado
end

# el icono que hay en (x, y) de la ventana (con su mitad del hueco a cada lado); -1 si ninguno
func icono_en(x: Int, y: Int) -> Int
    p = x
    q = y
    if vertical
        p = y
        q = x
    end
    if q < RELLENO - hueco or q >= RELLENO + lado + hueco
        return -1
    end
    for i in (0..items.length - 1)
        if p >= pos[i] - hueco / 2 and p < pos[i] + tam[i] + hueco / 2
            return i
        end
    end
    return -1
end

# el sitio (0..n) más cercano a (x, y) de la ventana, para soltar ahí
func hueco_en(x: Int, y: Int) -> Int
    p = x
    if vertical
        p = y
    end
    for i in (0..items.length - 1)
        if p < pos[i] + tam[i] / 2
            return i
        end
    end
    return items.length
end

# ---- pintar ----

# los puntos de alrededor del dock, junto a cada esquina, por fuera; -1 el que tapa una ventana (un cajón abierto
# hasta abajo, una que se arrastra, un menú...): no es el fondo
func alrededor() -> [Int]
    var fondos: [Int] = []
    n = wm_read()
    for i in (0..n - 1)
        if (wm_flags(i) & 2) != 0
            fondos.push(wm_id(i))
        end
    end
    var xs: [Int] = [dx - 2, dx + R / 2, dx + ancho + 1, dx + ancho - R / 2, dx - 2, dx + R / 2, dx + ancho + 1,
                     dx + ancho - R / 2]
    var ys: [Int] = [dy + R / 2, dy - 2, dy + R / 2, dy - 2, dy + alto - R / 2, dy + alto + 1, dy + alto - R / 2,
                     dy + alto + 1]
    var r: [Int] = []
    for k in (0..7)
        w = wm_at(xs[k], ys[k])
        libre = w == 0
        for f in fondos
            if f == w
                libre = true
            end
        end
        if libre
            r.push(screen_pixel_rgb(xs[k], ys[k]))
        else
            r.push(-1)
        end
    end
    return r
end

# ¿cambió el fondo de alrededor desde que se leyeron las esquinas? Solo cuenta un punto que se ve ahora y lo que
# había cambiado ya en la mirada anterior y sigue igual: lo que pasa por encima un momento (iconos arrastrados,
# una ventana movida, la selección) no hace mover el dock. Con un botón del ratón pulsado, nada.
func cambio_alrededor() -> Bool
    if pulsado() or mouse_button(1)
        return false
    end
    var ahora: [Int] = alrededor()
    distinto = ahora.length != fuera_de.length
    if not distinto
        for k in (0..ahora.length - 1)
            if ahora[k] >= 0 and ahora[k] != fuera_de[k]
                distinto = true
            end
        end
    end
    if not distinto
        pendiente = []
        return false
    end
    igual_antes = pendiente.length == ahora.length
    if igual_antes
        for k in (0..ahora.length - 1)
            if ahora[k] != pendiente[k]
                igual_antes = false
            end
        end
    end
    pendiente = ahora
    return igual_antes
end

# el fondo de la franja, con el dock donde no la tape
# cuántas filas (columnas, si va de lado) lee la franja: las de las esquinas, R arriba y R abajo; transparente, todas
func lineas_franja(grueso: Int) -> Int
    if transparente
        return grueso
    end
    return 2 * R
end

# la fila (columna) del dock que es la línea l de la franja
func linea_franja(l: Int, grueso: Int) -> Int
    if transparente or l < R
        return l
    end
    return grueso - 2 * R + l
end

# el color de la pantalla detrás del punto (x, y) del dock, sacado de la franja (que vale y tiene esa línea)
func franja_px(x: Int, y: Int) -> Int
    if vertical
        c = x
        if not transparente and x >= R
            c = R + x - (ancho - R)
        end
        return franja[c * sh + dy + y]
    end
    r = y
    if not transparente and y >= R
        r = R + y - (alto - R)
    end
    return franja[r * sw + dx + x]
end

func leer_franja()
    franja = []
    if vertical
        for l in (0..lineas_franja(ancho) - 1)
            x0 = dx + linea_franja(l, ancho)
            for y in (0..sh - 1)
                franja.push(screen_pixel_rgb(x0, y))
            end
        end
        franja_de = dx
        franja_grueso = ancho
    else
        for l in (0..lineas_franja(alto) - 1)
            y0 = dy + linea_franja(l, alto)
            for x in (0..sw - 1)
                franja.push(screen_pixel_rgb(x, y0))
            end
        end
        franja_de = dy
        franja_grueso = alto
    end
end

# ¿sirve la franja para el dock de ahora? (otro grueso, por un icono más grande, u otro sitio: no)
func franja_vale() -> Bool
    if franja.length == 0
        return false
    end
    if vertical
        return franja_de == dx and franja_grueso == ancho
    end
    return franja_de == dy and franja_grueso == alto
end

# lo que hay detrás de las cuatro esquinas del dock, R x R cada una, sacado de la franja
func bajo_de_franja()
    soltar_fondo()
    bajo = []
    for c in (0..3)
        ox = 0
        if c % 2 == 1
            ox = ancho - R
        end
        oy = 0
        if c >= 2
            oy = alto - R
        end
        for j in (0..R - 1)
            for i in (0..R - 1)
                bajo.push(franja_px(ox + i, oy + j))
            end
        end
    end
end

# transparente: lo que hay detrás del dock, como imagen, de la franja (se hace al pintar, ya con la ventana)
func hacer_fondo()
    if img_fondo != 0 or not franja_vale()
        return
    end
    b = buffer_alloc(ancho * alto * 3)
    if b == 0
        return
    end
    o = 0
    for y in (0..alto - 1)
        for x in (0..ancho - 1)
            c = franja_px(x, y)
            if c < 0
                c = 0
            end
            buffer_set_word(b, o, c >> 8)
            buffer_set_byte(b, o + 2, c & 255)
            o = o + 3
        end
    end
    img_fondo = image_from_rgb(b, ancho, alto, false)
    buffer_free(b)
end

func soltar_fondo()
    if img_fondo != 0
        image_free(img_fondo)
        img_fondo = 0
    end
end

# lo que hay en la pantalla detrás de las esquinas del dock, con la ventana sin taparlas
func leer_bajo()
    leer_franja()
    bajo_de_franja()
    fuera_de = alrededor()
    pendiente = []
end

func pintar_esquinas()
    k = 0
    for c in (0..3)
        ox = 0
        if c % 2 == 1
            ox = ancho - R
        end
        oy = 0
        if c >= 2
            oy = alto - R
        end
        for j in (0..R - 1)
            for i in (0..R - 1)
                if k < bajo.length and bajo[k] >= 0
                    rtg_write_pixel(ox + i, oy + j, bajo[k])
                end
                k = k + 1
            end
        end
    end
end

# el punto de un programa abierto, por el lado de fuera del dock
func punto(i: Int)
    x = icono_x(i)
    y = icono_y(i)
    if vertical
        cy = y + tam[i] / 2
        cx = 3
        if posicion == "DERECHA"
            cx = ancho - 4
        end
        redondo(cx - 2, cy - 2, cx + 2, cy + 2, 2, C_PUNTO)
    else
        cx = x + tam[i] / 2
        cy = alto - 3
        if posicion == "ARRIBA"
            cy = 2
        end
        redondo(cx - 2, cy - 2, cx + 2, cy + 2, 2, C_PUNTO)
    end
end

# un icono, más grande o más pequeño hasta llenar lado por su lado más largo, sin deformarlo, en medio de la celda
func dibujar_icono(icono: Int, x: Int, y: Int, cw: Int, ch: Int, lado_i: Int)
    w = icon_width(icono)
    h = icon_height(icono)
    if w * 2 >= h * 3                   # uno de 1.3 o 3.x, dibujado para los píxeles de dos de alto de
        h = h * 2                         # 640x256: en una pantalla de píxeles cuadrados sale aplastado
    end
    if w > 0 and h > 0
        if w >= h
            h = h * lado_i / w
            w = lado_i
        else
            w = w * lado_i / h
            h = lado_i
        end
    end
    if h < 1
        h = 1
    end
    if w < 1
        w = 1
    end
    icon_draw_size(icono, x + (cw - w) / 2, y + (ch - h) / 2, w, h)
end

func pintar_icono(i: Int)
    it = items[i]
    x = icono_x(i)
    y = icono_y(i)
    cw = celda_w(i)
    ch = celda_h(i)
    # todas con la misma placa: así se ven iguales aunque los iconos del Workbench midan cada uno una cosa
    c = C_PLACA
    if i == encima
        c = C_TESELA
    end
    redondo(x, y, x + cw - 1, y + ch - 1, 10, c)
    if it.img != 0                          # su imagen de dock, ya a la medida
        w = image_width(it.img)
        h = image_height(it.img)
        image_draw(it.img, x + (cw - w) / 2, y + (ch - h) / 2)
    elif it.icono != 0
        dibujar_icono(it.icono, x, y, cw, ch, lado_min)
    else
        font_use(f_inicial)                 # sin icono: su inicial, sobre la misma placa
        font_style(2)
        centrado(x + cw / 2, y + ch / 2 - font_height() / 2 + font_baseline(), str_upper(nombre(it.ruta)[0:1]), C_TEXTO)
        font_style(0)
    end
    if it.win != 0
        punto(i)
    end
end

# el dock se compone fuera de la vista, en un bitmap como la pantalla, y se copia de una vez: así no se ve el fondo
# tapando los iconos mientras se vuelven a dibujar (parpadeaba al pasar el ratón; lo contó JaviTecH)
var oculto_w: Int = 0
var oculto_h: Int = 0
var oculto_ok: Bool = false

func oculto_listo() -> Bool
    if oculto_w != ancho or oculto_h != alto
        oculto_ok = bitmap_create(0, ancho, alto, 0)
        oculto_w = ancho
        oculto_h = alto
    end
    return oculto_ok
end

# marca: el sitio donde caería lo que se arrastra (-1 ninguno)
func pintar(marca: Int)
    # en la ventana del dock, aunque el menú esté abierto (con el menú de pulsación larga, el dock se pintaba dentro
    # del menú: salían sus dos primeros iconos en vez de las opciones; lo contó el usuario)
    ok = window_use(0)
    oculto = oculto_listo()
    if oculto
        bitmap_draw_to(0)
        gfx_mode(0)                    # (el texto, sin fondo, como en la ventana)
    end
    if transparente
        hacer_fondo()
    end
    if img_fondo != 0
        image_draw(img_fondo, 0, 0)
    else
        pintar_esquinas()
        redondo(0, 0, ancho - 1, alto - 1, R, C_BORDE)
        redondo(1, 1, ancho - 2, alto - 2, R - 1, C_DOCK)
    end
    for i in (0..items.length - 1)
        pintar_icono(i)
    end
    if marca >= 0
        p = RELLENO / 2
        if marca < items.length
            p = pos[marca] - hueco / 2 - 1
        elif items.length > 0
            p = pos[items.length - 1] + tam[items.length - 1] + hueco / 2 - 1
        end
        pluma(C_MARCA)
        if vertical
            gfx_rect(RELLENO, p, ancho - RELLENO - 1, p + 1)
        else
            gfx_rect(p, RELLENO, p + 1, alto - RELLENO - 1)
        end
    end
    if oculto
        bitmap_draw_screen()
        ok = window_use(0)             # (la copia, en el dock: no adonde se estuviera dibujando antes)
        bitmap_blit(0, 0, 0, ancho, alto, 0, 0)
    end
end

func esperar_tamano(w: Int, h: Int)
    k = 0
    while (Dock.width != w or Dock.height != h) and k < 100
        time_delay(1)
        k = k + 1
    end
end

func esperar_sitio(x: Int, y: Int)
    k = 0
    while (Dock.left != x or Dock.top != y) and k < 100
        time_delay(1)
        k = k + 1
    end
end

# a su sitio y tamaño nuevos: primero pequeña en medio, para leer lo que hay detrás de las esquinas sin taparlas
# (ChangeWindowBox no espera: se mueve cuando ya tiene el tamaño, o lo pisaría con el de antes)
func colocar()
    caja()
    window_resize(0, 40, 20)
    esperar_tamano(40, 20)
    # (en medio del dock, si cabe entre las dos mitades de la franja; si no, en medio de la pantalla)
    px = dx + (ancho - 40) / 2
    py = dy + (alto - 20) / 2
    if transparente or (vertical and ancho < 2 * R + 44) or (not vertical and alto < 2 * R + 24)
        px = (sw - 40) / 2
        py = (sh - 20) / 2
    end
    window_move(0, px, py)
    esperar_sitio(px, py)
    time_delay(10)                     # (el Workbench repinta lo que deja ver)
    leer_bajo()
    window_move(0, dx, dy)
    esperar_sitio(dx, dy)
    window_resize(0, ancho, alto)
    esperar_tamano(ancho, alto)
    pintar(-1)
end

# a su sitio y tamaño nuevos sin apartarse (cuando entra o sale un programa): las esquinas, de la franja; si no
# sirve, colocar(). Al crecer, primero se mueve; al encoger, primero cambia de tamaño (siempre dentro de la pantalla)
func recolocar()
    etiqueta_quitar()                  # (los iconos cambian de sitio: el nombre de debajo del ratón, otra vez)
    encima = -1
    caja()
    if not franja_vale()
        colocar()
        return
    end
    bajo_de_franja()
    if ancho >= Dock.width and alto >= Dock.height
        window_move(0, dx, dy)
        esperar_sitio(dx, dy)
        window_resize(0, ancho, alto)
        esperar_tamano(ancho, alto)
    else
        window_resize(0, ancho, alto)
        esperar_tamano(ancho, alto)
        window_move(0, dx, dy)
        esperar_sitio(dx, dy)
    end
    pintar(-1)
    time_delay(10)                     # (el Workbench repinta lo que deja ver al encoger)
    fuera_de = alrededor()
    pendiente = []
end

# el punto de los programas abiertos, sin pintar todo el dock (que parpadea): su sitio con el color del dock y
# su trozo de borde, y el punto si está abierto
func pintar_puntos()
    ok = window_use(0)                 # (siempre en la ventana del dock, venga de donde venga)
    if transparente                    # el fondo no es de un color: todo de nuevo (es copiar la imagen)
        pintar(-1)
        return
    end
    for i in (0..items.length - 1)
        cx = 0
        cy = 0
        if vertical
            cy = icono_y(i) + tam[i] / 2
            cx = 3
            if posicion == "DERECHA"
                cx = ancho - 4
            end
        else
            cx = icono_x(i) + tam[i] / 2
            cy = alto - 3
            if posicion == "ARRIBA"
                cy = 2
            end
        end
        pluma(C_DOCK)
        gfx_rect(cx - 2, cy - 2, cx + 2, cy + 2)
        if not vertical
            pluma(C_BORDE)
            if posicion == "ARRIBA"
                gfx_rect(cx - 2, 0, cx + 2, 0)
            else
                gfx_rect(cx - 2, alto - 1, cx + 2, alto - 1)
            end
        end
        if items[i].win != 0
            punto(i)
        end
    end
end

# ---- los programas abiertos ----

func ruta_de(i: Int, id: Int) -> String
    for k in (0..vistos_id.length - 1)
        if vistos_id[k] == id
            return vistos_ruta[k]
        end
    end
    return wm_path(i)
end

# 0 nada cambió, 1 hay que repintar, 2 hay que colocar (cambió la lista)
func refrescar() -> Int
    n = wm_read()
    var ids: [Int] = []
    var rutas: [String] = []
    for i in (0..n - 1)
        f = wm_flags(i)
        # (ni las propias, ni las de fondo o sin bordes: la barra, los paneles; ni las del Workbench, sus cajones)
        if (f & 38) == 0 and wm_task(i) != "Workbench"
            id = wm_id(i)
            r = ruta_de(i, id)
            ids.push(id)
            rutas.push(r)
        end
    end
    vistos_id = ids
    vistos_ruta = rutas
    estado = 0
    var nuevos: [Item] = []
    for it in items
        w = 0
        for k in (0..ids.length - 1)
            if w == 0 and igual(rutas[k], it.ruta)
                w = ids[k]
            end
        end
        if w == 0 and it.cajon                # un cajón: su ventana del Workbench (lo contó Ferrán García)
            for i in (0..n - 1)
                if w == 0 and cajon_en_ventana(i, it.ruta)
                    w = wm_id(i)
                end
            end
        end
        if it.fijo or w != 0
            if (w != 0) != (it.win != 0) and estado == 0
                estado = 1
            end
            it.win = w
            nuevos.push(it)
        else
            icon_free(it.icono)
            estado = 2
        end
    end
    items = nuevos
    for k in (0..ids.length - 1)
        if rutas[k] != "" and buscar(rutas[k]) < 0
            nuevo = Item(rutas[k], icon_load(rutas[k]), false, ids[k])
            nuevo.imagen = imagen_wbdock(rutas[k])
            cargar_imagen(nuevo)
            items.push(nuevo)
            estado = 2
        end
    end
    return estado
end

# ---- lo que se hace ----

# Un cajón (o un volumen) se abre en el Workbench, como con un doble clic, y no con C:WBRun: el WBRun 2.2 de Aminet
# (el de CaffeineOS, con parm.library) solo carga programas y el cajón no se abría (lo contó Ferrán García). Si ya
# está abierto, viene delante su ventana; en 3.0 y 3.1, en TrasfondoArchivos o un aviso (cajones.dash)
func lanzar(r: String)
    if es_cajon(r)
        cajon_abrir(r, "TrasfondoDock")
        return
    end
    if wbrun
        ok = run_program("C:WBRun \"" + r + "\"")
    elif not wb_open(r)
        ok = run_program("\"" + r + "\"")
    end
end

# Las piezas de Trasfondo se paran lanzándolas otra vez (single_instance). Desde el dock, pulsar una que ya está en
# marcha (el fondo no tiene ventana: no sale con su punto) la apagaba sin querer (Ferrán García vio irse el fondo
# trasteando con el dock). Ahora se le pide que se muestre, como Mostrar en Exchange
func pieza_en_marcha(r: String) -> String
    n = str_lower(nombre(r))
    var piezas: [String] = ["Trasfondo", "TrasfondoBarra", "TrasfondoDock", "TrasfondoVentanas"]
    for p in piezas
        if n == str_lower(p)
            k = ports_read()
            for j in (0..k - 1)
                if port_name(j) == p
                    return p
                end
            end
        end
    end
    return ""
end

func pulsar(i: Int)
    it = items[i]
    p = ""
    if it.win == 0
        p = pieza_en_marcha(it.ruta)
    end
    if it.pila
        # (si se acaba de cerrar al pulsar su icono, que se quede cerrada: pulsarlo otra vez la cierra)
        if not (pila_cerrada_de == i and time_ms() - pila_cerrada_en < 1000)
            pila_abrir(i)
        end
    elif it.win != 0 and wm_front(it.win)
        ok = wm_activate(it.win)
    elif p != ""
        ok = cx_send(p, 19)                 # (CXCMD_APPEAR)
    else
        lanzar(it.ruta)
    end
end

# un icono de la lista a otro sitio (0..n, antes del que esté ahí), fijado
func mover(i: Int, sitio: Int)
    it = items[i]
    it.fijo = true
    var nuevos: [Item] = []
    for k in (0..items.length)
        if k == sitio
            nuevos.push(it)
        end
        if k < items.length and k != i
            nuevos.push(items[k])
        end
    end
    items = nuevos
    guardar()
end

# los fijados delante, en su orden; detrás, los abiertos sin fijar
func ordenar()
    var nuevos: [Item] = []
    for it in items
        if it.fijo
            nuevos.push(it)
        end
    end
    for it in items
        if not it.fijo
            nuevos.push(it)
        end
    end
    items = nuevos
end

func quitar(i: Int)
    it = items[i]
    it.fijo = false
    guardar()
    ordenar()
    if it.win == 0
        icon_free(it.icono)
        var nuevos: [Item] = []
        for k in items
            if k.fijo or k.win != 0
                nuevos.push(k)
            end
        end
        items = nuevos
    end
end

# un icono soltado desde el Workbench: fijado en el sitio donde cayó
func soltado(r0: String, x: Int, y: Int)
    r = real(r0)
    if str_ends(r, ".info")
        r = r[0:r.length - 5]
    end
    i = buscar(r)
    if i < 0
        suelto = Item(r, icon_load(r), true, 0)
        suelto.imagen = imagen_wbdock(r)
        suelto.cajon = es_cajon(r)
        cargar_imagen(suelto)
        items.push(suelto)
        i = items.length - 1
    end
    mover(i, hueco_en(x, y))
end

# con el botón pulsado sobre el icono i: 0 fue un clic, 1 se arrastró (ya está hecho), 2 se mantuvo sin moverlo
# (el menú)
func arrastrar(i: Int) -> Int
    x0 = wm_pointer_x()
    y0 = wm_pointer_y()
    t0 = time_ms()
    movido = false
    sitio = -1
    while pulsado() and time_ms() - t0 < 30000      # (sin soltar 30 s: algo se perdió)
        px = wm_pointer_x()
        py = wm_pointer_y()
        if not movido and (abs(px - x0) > ARRASTRE or abs(py - y0) > ARRASTRE)
            movido = true
            etiqueta_quitar()              # (el nombre se quedaba encima de donde estaba)
        end
        if not movido and time_ms() - t0 >= MANTENER
            return 2
        end
        if movido
            s = hueco_en(px - dx, py - dy)
            if fuera(px, py)
                s = -1
            end
            if s != sitio
                sitio = s
                pintar(sitio)
            end
        end
        time_delay(1)
    end
    if not movido
        return 0
    end
    px = wm_pointer_x()
    py = wm_pointer_y()
    if fuera(px, py)
        quitar(i)
    else
        s = hueco_en(px - dx, py - dy)
        if s != i and s != i + 1 or not items[i].fijo
            mover(i, s)
        end
    end
    return 1
end

func fuera(px: Int, py: Int) -> Bool
    return px < dx - FUERA or px > dx + ancho + FUERA or py < dy - FUERA or py > dy + alto + FUERA
end

# ---- el menú del botón derecho ----

func usar_letra()
    if f_menu != 0
        font_use(f_menu)
    end
end

func menu_cerrar()
    if menu != 0
        window_close(menu)
        menu = 0
        ok = window_use(0)
        devolver_foco()
    end
end

# ---- el botón derecho ----
# Intuition da el botón derecho a la ventana activa (y RMBTRAP solo vale en ella): con otra activa, sobre el dock
# salían los menús de esa otra. Con el ratón un momento sobre un icono, el dock se activa (sus clics derechos, a su
# menú); al irse, vuelve a activa la de antes. Los menús del resto del sistema no se tocan (lo pidió el usuario)
const ACTIVAR_TRAS = 200     # ms sobre un icono
var antes_activa: Int = 0    # la ventana activa antes de activarse el dock, 0 ninguna
var sobre_desde: Int = 0     # time_ms desde que el ratón está sobre un icono sin el dock activo

# ¿es del dock la ventana activa (el dock, su menú, su pila)?
func activa_nuestra() -> Bool
    a = wm_active()
    if a == 0
        return false
    end
    n = wm_read()
    for k in (0..n - 1)
        if wm_id(k) == a
            return (wm_flags(k) & 32) != 0
        end
    end
    return false
end

# (solo si nadie se la llevó: con un clic fuera del menú, esa otra ventana se queda activa)
func devolver_foco()
    if antes_activa != 0 and icono_del_raton() < 0
        if wm_active() == 0 or activa_nuestra()
            ok = wm_activate(antes_activa)
        end
        antes_activa = 0
    end
end

func activar_al_pasar()
    if menu != 0 or pila != 0 or escondido or apagado
        sobre_desde = 0
        return
    end
    if icono_del_raton() >= 0
        if activa_nuestra()
            sobre_desde = 0
        elif sobre_desde == 0
            sobre_desde = time_ms()
        elif time_ms() - sobre_desde >= ACTIVAR_TRAS
            sobre_desde = 0
            a = wm_active()
            if a != 0
                antes_activa = a
            end
            ok = window_use(0)
            window_activate(0)
        end
    else
        sobre_desde = 0
        if antes_activa != 0
            mx = wm_pointer_x()
            my = wm_pointer_y()
            if (mx < dx or my < dy or mx >= dx + ancho or my >= dy + alto) and activa_nuestra()
                ok = wm_activate(antes_activa)
            end
            if mx < dx or my < dy or mx >= dx + ancho or my >= dy + alto
                antes_activa = 0
            end
        end
    end
end

func menu_pintar(sel: Int)
    if menu == 0 or not window_use(menu)
        return
    end
    w = 0
    pluma(C_BORDE)
    gfx_rect(0, 0, menu_ancho() - 1, menu_textos.length * menu_alto + 7)
    pluma(C_MENU)
    gfx_rect(1, 1, menu_ancho() - 2, menu_textos.length * menu_alto + 6)
    usar_letra()
    for k in (0..menu_textos.length - 1)
        y = 4 + k * menu_alto
        if k == sel
            pluma(C_MENU_SEL)
            gfx_rect(3, y, menu_ancho() - 4, y + menu_alto - 1)
        end
        centrado(menu_ancho() / 2, y + (menu_alto - font_height()) / 2 + font_baseline(), menu_textos[k], C_TEXTO)
    end
    ok = window_use(0)                 # lo que se pinte después es del dock
end

func menu_ancho() -> Int
    w = 120
    usar_letra()
    for t in menu_textos
        if font_text_width(t) + 24 > w
            w = font_text_width(t) + 24
        end
    end
    return w
end

func menu_abrir(i: Int)
    menu_cerrar()
    it = items[i]
    menu_de = i
    menu_ops = []
    menu_textos = []
    # lo mismo con el botón derecho que manteniendo pulsado: abrir, otro más, pila o icono, fijar o quitar
    menu_ops.push(OP_LANZAR)
    menu_textos.push(tr(MSG_LANZAR, "Open"))
    if it.win != 0 and not it.cajon          # (un cajón tiene una ventana en el Workbench)
        menu_ops.push(OP_ABRIR)
        menu_textos.push(tr(MSG_ABRIR, "Open another"))
    end
    if it.fijo and dir_read(it.ruta) >= 0
        menu_ops.push(OP_PILA)
        if it.pila
            menu_textos.push(tr(MSG_COMO_CAJON, "Show as an icon"))
        else
            menu_textos.push(tr(MSG_COMO_PILA, "Show as a stack"))
        end
    end
    if it.fijo
        menu_ops.push(OP_QUITAR)
        menu_textos.push(tr(MSG_QUITAR, "Remove from dock"))
    else
        menu_ops.push(OP_FIJAR)
        menu_textos.push(tr(MSG_FIJAR, "Keep in dock"))
    end
    usar_letra()
    menu_alto = font_height() + 8
    w = menu_ancho()
    h = menu_textos.length * menu_alto + 8
    # junto al icono, por el lado de dentro de la pantalla
    x = dx + icono_x(i) + celda_w(i) / 2 - w / 2
    y = dy - h - 4
    if posicion == "ARRIBA"
        y = dy + alto + 4
    elif posicion == "IZQUIERDA"
        x = dx + ancho + 4
        y = dy + icono_y(i)
    elif posicion == "DERECHA"
        x = dx - w - 4
        y = dy + icono_y(i)
    end
    if x < 0
        x = 0
    end
    if x + w > sw
        x = sw - w
    end
    menu = window_create("", x, y, w, h, 2 + 4 + 8 + 16)
    if menu != 0
        window_activate(menu)
        gfx_mode(0)                    # (el texto, sin fondo)
        menu_pintar(-1)
        ok = window_use(0)
    end
end

func menu_elegir(y: Int)
    k = (y - 4) / menu_alto
    op = 0
    if k >= 0 and k < menu_ops.length
        op = menu_ops[k]
    end
    i = menu_de
    menu_cerrar()
    if i < 0 or i >= items.length
        return
    end
    if op == OP_FIJAR
        items[i].fijo = true
        guardar()
        pintar(-1)
    elif op == OP_QUITAR
        n = items.length
        quitar(i)
        if items.length != n
            recolocar()
        else
            pintar(-1)
        end
    elif op == OP_ABRIR
        lanzar(items[i].ruta)
    elif op == OP_LANZAR
        if items[i].pila
            cajon_abrir(items[i].ruta, "TrasfondoDock")
        else
            pulsar(i)
        end
    elif op == OP_PILA
        items[i].pila = not items[i].pila
        guardar()
    end
end

# ---- la pila: un cajón del dock que despliega sus programas (los subdocks de AmiDock; lo pidieron Ernesto Laura
# de la Fuente y Ferrán García) ----
# Una ventanita junto a su icono, hacia dentro de la pantalla: una fila por cada cosa del cajón con icono (su icono y
# su nombre) y, al final, una para abrir el cajón entero. Pulsar una la abre (como en el dock) y cierra la pila;
# pulsar fuera, o su icono otra vez, la cierra

const PILA_MAX = 12          # filas como mucho (el resto, con "Abrir el cajón")
const PILA_ICONO = 32        # el lado de sus iconos

var pila: Int = 0            # su ventana, 0 si no está
var pila_de: Int = -1        # de qué icono del dock
var pila_rutas: [String] = []
var pila_nombres: [String] = []
var pila_iconos: [Int] = []
var pila_fila: Int = 0       # el alto de una fila
var pila_ancho: Int = 0
var pila_x: Int = 0          # su sitio en la pantalla
var pila_y: Int = 0
var pila_sel: Int = -1       # la fila con el ratón encima
var pila_cerrada_de: Int = -1   # la que se cerró hace nada (ver pulsar)
var pila_cerrada_en: Int = 0

func unir(a: String, b: String) -> String
    if str_ends(a, ":") or str_ends(a, "/")
        return a + b
    end
    return a + "/" + b
end

func pila_cerrar()
    if pila != 0
        window_close(pila)
        pila = 0
        pila_cerrada_de = pila_de
        pila_cerrada_en = time_ms()
        ok = window_use(0)
        devolver_foco()
    end
    for ic in pila_iconos
        icon_free(ic)
    end
    pila_iconos = []
    pila_rutas = []
    pila_nombres = []
    pila_sel = -1
end

func pila_pintar()
    if pila == 0 or not window_use(pila)
        return
    end
    n = pila_rutas.length + 1
    h = n * pila_fila + 8
    pluma(C_BORDE)
    gfx_rect(0, 0, pila_ancho - 1, h - 1)
    pluma(C_MENU)
    gfx_rect(1, 1, pila_ancho - 2, h - 2)
    usar_letra()
    for k in (0..n - 1)
        y = 4 + k * pila_fila
        if k == pila_sel
            pluma(C_MENU_SEL)
            gfx_rect(3, y, pila_ancho - 4, y + pila_fila - 1)
        end
        texto = tr(MSG_ABRIR_CAJON, "Open the drawer")
        if k < pila_rutas.length
            texto = pila_nombres[k]
            if pila_iconos[k] != 0
                dibujar_icono(pila_iconos[k], 8, y, PILA_ICONO, pila_fila, PILA_ICONO)
            end
        end
        pluma(C_TEXTO)
        gfx_text_at(16 + PILA_ICONO, y + (pila_fila - font_height()) / 2 + font_baseline(), texto)
    end
    ok = window_use(0)
end

func pila_abrir(i: Int)
    pila_cerrar()
    menu_cerrar()
    etiqueta_quitar()
    it = items[i]
    n = dir_read(it.ruta)
    if n < 0                              # ya no es un cajón: como antes
        lanzar(it.ruta)
        return
    end
    # lo que tiene icono, por su nombre (dir_read ya los da en orden)
    var nombres: [String] = []
    for k in (0..n - 1)
        nm = dir_entry_name(k)
        if str_ends(str_lower(nm), ".info") and str_lower(nm) != "disk.info" and nm.length > 5
            nombres.push(nm[0:nm.length - 5])
        end
    end
    usar_letra()
    pila_fila = PILA_ICONO + 8
    if font_height() + 8 > pila_fila
        pila_fila = font_height() + 8
    end
    # cuántas filas caben entre el dock y el otro borde (o en el alto de la pantalla, de lado)
    sitio = sh - ALTO_BARRA - 16
    if posicion == "ABAJO"
        sitio = dy - ALTO_BARRA - 12
    elif posicion == "ARRIBA"
        sitio = sh - (dy + alto) - 12
    end
    caben = (sitio - 8) / pila_fila - 1
    if caben > PILA_MAX
        caben = PILA_MAX
    end
    for nm in nombres
        if pila_rutas.length < caben
            pila_rutas.push(unir(it.ruta, nm))
            pila_nombres.push(nm)
        end
    end
    w = 140
    for nm in pila_nombres
        if font_text_width(nm) + PILA_ICONO + 28 > w
            w = font_text_width(nm) + PILA_ICONO + 28
        end
    end
    if font_text_width(tr(MSG_ABRIR_CAJON, "Open the drawer")) + PILA_ICONO + 28 > w
        w = font_text_width(tr(MSG_ABRIR_CAJON, "Open the drawer")) + PILA_ICONO + 28
    end
    if w > sw / 2
        w = sw / 2
    end
    pila_ancho = w
    h = (pila_rutas.length + 1) * pila_fila + 8
    # junto al icono, hacia dentro de la pantalla (como el menú)
    x = dx + icono_x(i) + celda_w(i) / 2 - w / 2
    y = dy - h - 4
    if posicion == "ARRIBA"
        y = dy + alto + 4
    elif posicion == "IZQUIERDA"
        x = dx + ancho + 4
        y = dy + icono_y(i) + celda_h(i) / 2 - h / 2
    elif posicion == "DERECHA"
        x = dx - w - 4
        y = dy + icono_y(i) + celda_h(i) / 2 - h / 2
    end
    if x + w > sw
        x = sw - w
    end
    if x < 0
        x = 0
    end
    if y + h > sh
        y = sh - h
    end
    if y < ALTO_BARRA
        y = ALTO_BARRA
    end
    pila_de = i
    pila_sel = -1
    pila_x = x
    pila_y = y
    pila = window_create("", x, y, w, h, 2 + 4 + 8 + 16)
    if pila == 0
        pila_rutas = []
        pila_nombres = []
        return
    end
    window_activate(pila)
    gfx_mode(0)                          # (el texto, sin fondo)
    for r in pila_rutas                  # (con la ventana ya abierta: los iconos, para su pantalla)
        pila_iconos.push(icon_load(r))
    end
    pila_pintar()
end

# la fila de la pila en y (de su ventana); -1 ninguna
func pila_fila_en(y: Int) -> Int
    if pila_fila <= 0
        return -1
    end
    k = (y - 4) / pila_fila
    if y < 4 or k < 0 or k > pila_rutas.length
        return -1
    end
    return k
end

func pila_elegir(y: Int)
    k = pila_fila_en(y)
    if k < 0
        return
    end
    r = items[pila_de].ruta
    if k < pila_rutas.length
        r = pila_rutas[k]
    end
    pila_cerrar()
    if k == pila_rutas.length
        cajon_abrir(r, "TrasfondoDock")    # el cajón entero, en el Workbench
    else
        lanzar(r)
    end
end

# el ratón sobre la pila: su fila, resaltada
func pila_mirar()
    if pila == 0
        return
    end
    mx = wm_pointer_x() - pila_x
    k = pila_fila_en(wm_pointer_y() - pila_y)
    if mx < 0 or mx >= pila_ancho
        k = -1
    end
    if k != pila_sel
        pila_sel = k
        pila_pintar()
    end
end

Window Dock
    title ""
    width 40
    height 20
    left 0
    top 0
    borderless true
    closegadget false
    dragbar false
    depthgadget false
    activate false
    rmbtrap true
end

# los colores del tema (tema.dash); sin él, los de arriba
# ---- el nombre del icono que tiene el ratón encima ----

func etiqueta_quitar()
    if etiqueta != 0
        window_close(etiqueta)
        etiqueta = 0
        ok = window_use(0)
    end
end

func etiqueta_poner(i: Int)
    etiqueta_quitar()
    texto = nombre(items[i].ruta)
    if texto == ""
        texto = items[i].ruta
    end
    usar_letra()
    w = font_text_width(texto) + 20
    h = font_height() + 10
    x = dx + icono_x(i) + celda_w(i) / 2 - w / 2
    y = dy - h - 6
    if posicion == "ARRIBA"
        y = dy + alto + 6
    elif posicion == "IZQUIERDA"
        x = dx + ancho + 6
        y = dy + icono_y(i) + celda_h(i) / 2 - h / 2
    elif posicion == "DERECHA"
        x = dx - w - 6
        y = dy + icono_y(i) + celda_h(i) / 2 - h / 2
    end
    if x < 0
        x = 0
    end
    if x + w > sw
        x = sw - w
    end
    # (sin activarse, 32: robaba el foco a la ventana del usuario, y el botón derecho iba a ella)
    etiqueta = window_create("", x, y, w, h, 2 + 4 + 8 + 16 + 32)
    if etiqueta != 0
        gfx_mode(0)
        pluma(C_BORDE)
        gfx_rect(0, 0, w - 1, h - 1)
        pluma(C_MENU)
        gfx_rect(1, 1, w - 2, h - 2)
        usar_letra()
        centrado(w / 2, 5 + font_baseline(), texto, C_TEXTO)
        ok = window_use(0)
    end
end

# el ratón sobre el dock: qué icono tiene encima (-1 si ninguno o fuera)
func icono_del_raton() -> Int
    mx = wm_pointer_x() - dx
    my = wm_pointer_y() - dy
    if mx < 0 or my < 0 or mx >= ancho or my >= alto
        return -1
    end
    return icono_en(mx, my)
end

func mirar_encima()
    i = -1
    if menu == 0 and pila == 0
        i = icono_del_raton()
    end
    if i != encima
        encima = i
        pintar(-1)
        if i >= 0
            etiqueta_poner(i)
        else
            etiqueta_quitar()
        end
    end
end

# ---- esconderse ----

# la rayita: en el borde de la pantalla, en medio del lado del dock
# Escondido, la ventana del dock es una franja a lo largo de su sitio, pegada al borde (ZONA de grueso): se ve la
# rayita en medio y es donde se suelta un icono arrastrado desde el Workbench (el puntero se para en el borde: es
# fácil de acertar). Arrastrando, el dock no sale: la franja se resalta y lo soltado se fija ahí (lo pidió el usuario)
const ZONA = 8
var resaltada: Bool = false  # la franja, resaltada: se está arrastrando algo encima

func rayita()
    pw = ancho
    ph = ZONA
    px = dx
    py = sh - ph
    if posicion == "ARRIBA"
        py = ALTO_BARRA
    elif vertical
        pw = ZONA
        ph = alto
        py = dy
        px = 0
        if posicion == "DERECHA"
            px = sw - pw
        end
    end
end

# el ratón llega al borde del dock escondido: a la mitad de fuera del sitio del dock, o más allá
func raton_en_borde() -> Bool
    mx = wm_pointer_x()
    my = wm_pointer_y()
    if posicion == "ABAJO"
        return my >= dy + alto / 2 and mx >= dx and mx < dx + ancho
    elif posicion == "ARRIBA"
        return my <= dy + alto / 2 and my >= ALTO_BARRA - 2 and mx >= dx and mx < dx + ancho
    elif posicion == "IZQUIERDA"
        return mx <= dx + ancho / 2 and my >= dy and my < dy + alto
    end
    return mx >= dx + ancho / 2 and my >= dy and my < dy + alto
end

# el ratón está lejos del dock
func raton_lejos() -> Bool
    mx = wm_pointer_x()
    my = wm_pointer_y()
    return mx < dx - CERCA or mx >= dx + ancho + CERCA or my < dy - CERCA or my >= dy + alto + CERCA
end

func esconder_ya()
    menu_cerrar()
    pila_cerrar()
    etiqueta_quitar()
    encima = -1
    rayita()
    # primero pequeña (en su esquina, lejos de la franja), y lo de detrás de la franja ya sin el dock encima
    window_resize(0, pw, ph)
    esperar_tamano(pw, ph)
    if posicion == "ARRIBA"            # (del lado de dentro: arriba y a la izquierda tocaría la franja)
        window_move(0, dx, dy + alto - ph)
        esperar_sitio(dx, dy + alto - ph)
    elif posicion == "IZQUIERDA"
        window_move(0, dx + ancho - pw, dy)
        esperar_sitio(dx + ancho - pw, dy)
    end
    time_delay(10)                     # (el Workbench repinta lo que deja ver)
    bajo_rayita = []
    for j in (0..ph - 1)
        for i in (0..pw - 1)
            bajo_rayita.push(screen_pixel_rgb(px + i, py + j))
        end
    end
    window_move(0, px, py)
    esperar_sitio(px, py)
    escondido = true
    pintar_rayita()
end

func pintar_rayita()
    ok = window_use(0)
    k = 0
    for j in (0..ph - 1)
        for i in (0..pw - 1)
            if k < bajo_rayita.length and bajo_rayita[k] >= 0
                rtg_write_pixel(i, j, bajo_rayita[k])
            end
            k = k + 1
        end
    end
    # la rayita, en medio y del lado del borde; resaltada, a lo largo de toda la franja y del color de marcar
    l = PILDORA
    c = C_PUNTO
    if resaltada
        l = pw
        if vertical
            l = ph
        end
        c = C_MARCA
    end
    if vertical
        x0 = 1
        if posicion == "DERECHA"
            x0 = pw - GRUESO - 1
        end
        y0 = ph / 2 - l / 2
        redondo(x0, y0, x0 + GRUESO - 1, y0 + l - 1, 2, c)
    else
        y0 = ph - GRUESO - 1
        if posicion == "ARRIBA"
            y0 = 1
        end
        x0 = pw / 2 - l / 2
        redondo(x0, y0, x0 + l - 1, y0 + GRUESO - 1, 2, c)
    end
end

func mostrar_ya()
    escondido = false
    resaltada = false
    lejos_desde = 0
    window_move(0, dx, dy)             # antes de crecer, donde quepa (pegada al borde no puede)
    esperar_sitio(dx, dy)
    recolocar()
end

# cada décima de segundo: el nombre del icono de debajo del ratón y, si se esconde solo, cuándo
func vigilar()
    if apagado                           # escondido desde Exchange: hasta que lo muestre
        return
    end
    if escondido
        # con otra pantalla delante (la de DOpus), el puntero sigue moviéndose en la del Workbench: el dock salía
        # y la ponía delante (lo contó Ernesto Laura de la Fuente)
        borde = raton_en_borde() and wm_screen_front()
        if borde and pulsado()
            if not resaltada               # arrastrando algo: la franja recibe lo que se suelte
                resaltada = true
                pintar_rayita()
            end
        elif borde
            mostrar_ya()
        elif resaltada
            resaltada = false
            pintar_rayita()
        end
        return
    end
    mirar_encima()
    pila_mirar()
    activar_al_pasar()
    if esconder and menu == 0 and pila == 0
        if raton_lejos()
            if lejos_desde == 0
                lejos_desde = time_ms()
            elif time_ms() - lejos_desde > ESPERA_ESCONDER
                esconder_ya()
            end
        else
            lejos_desde = 0
        end
    end
end

# a medio camino entre dos colores
func mezcla(a: Int, b: Int) -> Int
    r = (((a >> 16) & 255) + ((b >> 16) & 255)) / 2
    g = (((a >> 8) & 255) + ((b >> 8) & 255)) / 2
    z = ((a & 255) + (b & 255)) / 2
    return (r << 16) | (g << 8) | z
end

# un color escrito R,G,B (0 a 255 cada uno), como 0xRRGGBB; -1 si no lo es
func color_rgb(t: String) -> Int
    var p: [String] = str_split(str_replace(t, " ", ""), ",")
    if p.length != 3
        return -1
    end
    c = 0
    for s in p
        if s == ""
            return -1
        end
        n = Int(s)
        if n < 0 or n > 255
            return -1
        end
        c = (c << 8) | n
    end
    return c
end

func colores()
    C_DOCK = tema_color("PANEL", C_DOCK)
    C_BORDE = tema_color("BORDE", C_BORDE)
    C_TEXTO = tema_color("TEXTO", C_TEXTO)
    C_TESELA = tema_color("BOTON", C_TESELA)
    hueco = Int(ajuste("DOCK_HUECO", "HUECO", "4"))
    if hueco < 0
        hueco = 0
    elif hueco > 64
        hueco = 64
    end
    fondo = str_upper(ajuste("DOCK_FONDO", "FONDO", "TEMA"))
    transparente = fondo == "TRANSPARENTE"
    if fondo == "COLOR"
        c = color_rgb(ajuste("DOCK_COLOR", "COLOR", ""))
        if c >= 0
            C_DOCK = c
            C_BORDE = mezcla(c, C_TESELA)
        end
    end
    C_PLACA = mezcla(C_DOCK, C_TESELA)
    C_PUNTO = tema_color("SUAVE", C_PUNTO)
    C_MARCA = tema_color("ACENTO", C_MARCA)
    C_MENU = tema_color("TARJETA", C_MENU)
    C_MENU_SEL = tema_color("BOTON", C_MENU_SEL)
end

Main
    colores()
    if not single_instance("TrasfondoDock")
        Print "TrasfondoDock was already running: stopping it"
    elif rtg_get_depth() < 15
        Print "TrasfondoDock needs an RTG screen (15 bits or more)"
    else
        # en Exchange, como el fondo (Ferrán García): Quitar lo para; Ocultar o Desactivar lo esconden
        cx_ok = cx_broker("TrasfondoDock", program_version(), tr(MSG_CX_DOCK, "Program launcher at the edge of the screen"), 0)
        if cx_ok
            ok = cx_watch_add("rawmouse mouse_leftpress", W_PULSA)
            ok = cx_watch_add("rawmouse upstroke mouse_leftpress", W_SUELTA)
        end
        posicion = str_upper(ajuste("DOCK_POSICION", "POSICION", "ABAJO"))
        vertical = posicion == "IZQUIERDA" or posicion == "DERECHA"
        lado_min = Int(ajuste("DOCK_ICONO", "ICONO", "40"))
        esconder = str_upper(ajuste("DOCK_ESCONDER", "ESCONDER", "NO")) == "SI"
        if lado_min < 16
            lado_min = 16
        end
        wbrun = file_exists("C:WBRun")
        sw = rtg_get_width()
        sh = rtg_get_height()
        leer_fijos()
        fijar_archivos()
        caja()
        leer_bajo()                    # (antes de abrir: nada tapa las esquinas)
        Dock.open
        ok = app_window(0)
        f_inicial = font_open("CGTriumvirate.font", lado / 2)
        f_menu = font_open("CGTriumvirate.font", 13)
        if f_menu == 0
            f_menu = font_open("helvetica.font", 13)
        end
        gfx_mode(0)
        # los iconos de antes de abrir no tenían la pantalla de la ventana: otra vez, con ella
        for it in items
            icon_free(it.icono)
            it.icono = icon_load(it.ruta)
            cargar_imagen(it)
        end
        e = refrescar()
        caja()
        window_move(0, dx, dy)
        esperar_sitio(dx, dy)
        window_resize(0, ancho, alto)
        esperar_tamano(ancho, alto)
        if e == 2
            colocar()
        else
            pintar(-1)
        end
        EventLoop
            On Timer 100
                if break_check()
                    Stop
                end
                mirar_cx()
                c = 0
                if cx_pendiente.length > 0
                    c = cx_pendiente[0]
                    cx_pendiente.remove(0)
                end
                if c == 5
                    Stop
                elif (c == 1 or c == 3) and not apagado
                    apagado = true
                    if not escondido
                        esconder_ya()
                    end
                elif (c == 2 or c == 4) and apagado
                    apagado = false
                    mostrar_ya()
                end
                vigilar()
                tic = tic + 1
                if tic % 3 == 0 and escondido and not apagado
                    # soltado en la franja: el dock sale y lo fija donde cayó (a lo largo, como en el dock)
                    d = app_drop()
                    if d != ""
                        ax = app_drop_x() + px - dx
                        ay = app_drop_y() + py - dy
                        mostrar_ya()
                        while d != ""
                            soltado(d, ax, ay)
                            d = app_drop()
                        end
                        recolocar()
                        leido_en = time_ms()
                    end
                end
                if tic % 3 == 0 and not escondido   # lo de siempre, cada 0,3 s
                    d = app_drop()
                    cambio = false
                    while d != ""
                        soltado(d, app_drop_x(), app_drop_y())
                        cambio = true
                        d = app_drop()
                    end
                    e = refrescar()
                    # (lo de alrededor, como mucho cada 2 s y sin el menú abierto, que está pegado al dock)
                    releer = false
                    if menu == 0 and time_ms() - leido_en > 2000
                        releer = cambio_alrededor()
                    end
                    if releer
                        colocar()
                        leido_en = time_ms()
                    elif cambio or e == 2
                        recolocar()
                        leido_en = time_ms()
                    elif e == 1
                        pintar_puntos()
                    end
                end
            end
            On Click
                if menu != 0 and event_window() == menu
                    menu_elegir(click_y())
                elif pila != 0 and event_window() == pila
                    pila_elegir(click_y())
                elif event_window() == 0
                    menu_cerrar()
                    pila_cerrar()
                    i = icono_en(click_x(), click_y())
                    if i >= 0
                        a = arrastrar(i)
                        if a == 1
                            recolocar()
                        elif a == 2
                            menu_abrir(i)
                        else
                            pulsar(i)
                        end
                    end
                end
            end
            On RightClick
                if event_window() == 0
                    pila_cerrar()
                    i = icono_en(click_x(), click_y())
                    if i >= 0
                        menu_abrir(i)
                    else
                        menu_cerrar()
                    end
                end
            end
            On Inactive
                if menu != 0 and event_window() == menu
                    k = 0                    # que acabe el clic de fuera antes de cerrarlo (ver apartar del panel)
                    while pulsado() and k < 100
                        time_delay(1)
                        k = k + 1
                    end
                    time_delay(3)
                    menu_cerrar()
                elif pila != 0 and event_window() == pila
                    k = 0                    # (lo mismo que el menú)
                    while pulsado() and k < 100
                        time_delay(1)
                        k = k + 1
                    end
                    time_delay(3)
                    pila_cerrar()
                end
            end
            On Close
                Stop
            end
        end
    end
end
