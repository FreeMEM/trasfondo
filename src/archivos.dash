func menu(ev: Int) -> Bool
    if ev == ID_M_NUEVO
        empezar_edicion(2)
    elif ev == ID_M_ABRIR
        if cursor >= 0
            abrir(cursor)
        end
    elif ev == ID_M_RENOMBRAR
        empezar_edicion(1)
    elif ev == ID_M_INFO_DE
        abrir_info()
    elif ev == ID_I_GUARDAR
        guardar_info()
    elif ev == ID_I_CANCELAR
        mui_window_close(i_win)
        i_abierta = false
    elif ev == ID_M_PAPELERA
        a_la_papelera()
    elif ev == ID_M_DEVOLVER
        devolver()
    elif ev == ID_M_BORRAR
        borrar_del_todo()
    elif ev == ID_M_VACIAR
        vaciar_papelera()
    elif ev == ID_M_SALIR
        return false
    elif ev == ID_M_CORTAR or ev == ID_M_COPIAR
        porta = elegidas()
        porta_cortar = ev == ID_M_CORTAR
    elif ev == ID_M_PEGAR
        pegar()
    elif ev == ID_M_DESHACER
        deshacer()
    elif ev == ID_M_TODO
        for k in (0..orden.length - 1)
            elegido[orden[k]] = true
        end
    elif ev == ID_M_NADA
        nada()
    elif ev == ID_M_LISTA
        poner_vista(false)
    elif ev == ID_M_ICONOS
        poner_vista(true)
    elif ev == ID_M_DOS
        dos_paneles_si(not dos_paneles)
    elif ev == ID_M_POR_NOMBRE or ev == ID_M_POR_TAMANO or ev == ID_M_POR_FECHA
        por = ev - ID_M_POR_NOMBRE
        al_reves = por != 0                      # tamaño y fecha: lo más grande y lo más nuevo primero
        ordenar()
    elif ev == ID_M_INFO
        con_info = not con_info
        ordenar()
    elif ev == ID_M_ACTUALIZAR
        lateral()
        leer(ruta, true)
    elif ev == ID_M_ATRAS
        ir_atras()
    elif ev == ID_M_ADELANTE
        ir_adelante()
    elif ev == ID_M_ARRIBA
        subir()
    elif ev == ID_M_IR
        empezar_edicion(3)
    elif ev == ID_M_FILTRO
        empezar_edicion(4)
    end
    return true
end

Main
    colores()
    if mui_app_begin("TrasfondoArchivos", "TRASFONDOARCHIVOS") == 0
        Print "TrasfondoArchivos needs MUI"
        return
    end
    letra = abrir_fuente(13)
    inicio = ajuste("ARCHIVOS_INICIO", "INICIO", "SYS:")
    if arg_count() > 0
        inicio = arg(0)                          # TrasfondoArchivos Work:Proyectos
    end
    win = mui_window_begin("Archivos", 1)
        menus()
        lienzo = mui_canvas(420, 240)
    mui_window_end()
    mui_window_size(win, 70, 70)
    crear_info()
    mui_canvas_buffered(lienzo, true)
    mui_canvas_on_draw(lienzo, pintar)
    mui_canvas_on_input(lienzo, ID_LIENZO)
    mui_canvas_on_move(lienzo, ID_MOVER)
    mui_canvas_on_drag(lienzo, ID_ARRASTRE)
    mui_canvas_take_keys(lienzo, true)
    mui_on_drop(win, ID_SOLTAR)
    lateral()
    leer(inicio, false)
    if ruta == ""
        leer("SYS:", false)
    end
    if not mui_window_open(win)
        Print "TrasfondoArchivos: the window could not be opened"
        mui_app_end()
        return
    end
    seguir = true
    while seguir
        ev = 0
        if op_activa
            ev = mui_poll_event()
            if ev == 0
                op_paso()
                if not op_activa or time_ms() % 8 == 0
                    repintar()
                end
                continue
            end
        else
            ev = mui_wait_event_signals(file_notify_signal())
        end
        if ev == -1
            seguir = false
        elif ev == 0
            if vigilado != 0 and file_changed(vigilado) and not op_activa
                leer(ruta, true)
                repintar()
            end
            if dos_paneles and b_vigilado != 0 and file_changed(b_vigilado) and not op_activa
                cambiar_panel()
                leer(ruta, true)
                cambiar_panel()
                mui_set_text(win, "Archivos: " + ruta)
                repintar()
            end
        elif ev == ID_LIENZO
            b = mui_canvas_button(lienzo)
            w = mui_canvas_wheel(lienzo)
            k = mui_canvas_key(lienzo)
            q = mui_canvas_qualifiers(lienzo)
            if w != 0
                if panel_en(mui_canvas_mouse_x(lienzo)) != panel   # la rueda mueve el panel de debajo
                    cambiar_panel()
                    rueda(w)
                    cambiar_panel()
                else
                    rueda(w)
                end
            elif k >= 0
                tecla(k, q, mui_canvas_char(lienzo))
            elif b == 1
                clic(mui_canvas_mouse_x(lienzo), mui_canvas_mouse_y(lienzo), q)
            end
            repintar()
        elif ev == ID_ARRASTRE
            arrastre(mui_canvas_drag(lienzo), mui_canvas_mouse_x(lienzo), mui_canvas_mouse_y(lienzo), mui_canvas_qualifiers(lienzo))
            repintar()
        elif ev == ID_SOLTAR
            # iconos del Workbench soltados aquí: copiados (o movidos si es el mismo disco) a este cajón
            var traidos: [String] = []
            p = app_drop()
            while p != ""
                traidos.push(p)
                p = app_drop()
            end
            if traidos.length > 0
                copiar_a(traidos, ruta, volumen(traidos[0]) == volumen(ruta))
            end
            repintar()
        elif ev == ID_MOVER
            antes_e = encima
            antes_l = lat_encima
            encima = -1
            lat_encima = -1
            if mui_canvas_pointer_inside(lienzo)
                mx = mui_canvas_pointer_x(lienzo)
                my = mui_canvas_pointer_y(lienzo)
                encima = bajo(mx, my)
                lat_encima = lateral_bajo(mx, my)
            end
            if encima != antes_e or lat_encima != antes_l
                repintar()
            end
        else
            seguir = menu(ev)
            repintar()
        end
    end
    if op_copia != 0
        ok = file_copy_end(op_copia, false)
    end
    mui_app_end()
end
