# Trasfondo: un "top" gráfico en el fondo del Workbench, detrás de los iconos y sin clics.
#
# Arriba a la derecha del escritorio: la CPU en uso y su historia del último minuto, la memoria libre
# y las tareas que más CPU toman; debajo, los discos (lo ocupado de cada volumen) y la red (lo que entra y
# sale por segundo y la señal de la WiFi si el driver la da). Con Roadshow, bytes de cada interfaz; con otra
# pila (MiamiDx, AmiTCP), paquetes, preguntados al driver de red. Se actualiza cada segundo.
# Se para lanzándolo otra vez, o con Ctrl-C.
#
# Es una commodity: desde Exchange se oculta y se muestra (sigue midiendo), se desactiva (deja de medir)
# y se elimina. Tooltypes: CX_PRIORITY, CX_POPKEY (tecla para ocultar y mostrar), CX_POPUP=NO (arranca oculto).

# desde el icono no escribe nada: una ventana de consola taparía el panel (y la de "ya estaba en marcha",
# con WAIT, se quedaría abierta)
@workbench_output "NIL:"

const ANCHO = 260
const HISTORIA = 60          # segundos de historia de la CPU
const TAREAS = 6             # tareas que se enseñan, si el tooltype TAREAS no dice otra cosa
const SECCIONES = "CPU,MEMORIA,TAREAS,DISCOS,RED"
const ALTO_GRAFICA = 32
const DISCOS = 8             # volúmenes que se enseñan, como mucho
const REDES = 3              # interfaces de red, como mucho

const CX_OCULTAR = 1         # las órdenes de cx_wait
const CX_MOSTRAR = 2
const CX_DESACTIVAR = 3
const CX_ACTIVAR = 4
const CX_ELIMINAR = 5
const CX_TECLA = 6

var secciones: [String] = [] # lo que se enseña y en qué orden (tooltype MOSTRAR): cpu, memoria, tareas, discos, red
var tareas_max: Int = TAREAS
var prefs: String = ""       # ENV:Trasfondo.prefs (lo escribe TrasfondoPrefs): manda sobre los tooltypes
var tecla_puesta: String = ""
var historia: [Int] = []     # CPU total de cada segundo, en tantos por mil (la más nueva al final)
var n_tareas: Int = 0
var linea: Int = 10          # alto de una línea de texto
var c_texto: Int = 1
var c_suave: Int = 1
var c_cpu: Int = 3
var colores: Bool = false
var c_fondo: Int = 1
var paleta: Bool = false      # pantalla de 256 colores o menos: el velo sería una trama de puntos
var lienzo: Int = 0          # el panel en el fondo; 0 si está oculto
var visible: Bool = true     # lo que quiere el usuario (desactivado, el panel no está aunque lo quiera)
var activo: Bool = true      # midiendo la CPU
var alto_lienzo: Int = 0     # el alto con que se creó el panel: si cambia lo que hay que enseñar, se crea otro

var d_nombre: [String] = []  # los volúmenes, sin RAM Disk
var d_kb: [Int] = []         # tamaño en KB; -1 si no contestó
var d_libre: [Int] = []

var r_nombre: [String] = []  # los interfaces de red de Roadshow, sin lo0; sin Roadshow, los drivers de red
var r_paquetes: Bool = false # los contadores son paquetes (sin Roadshow), no bytes
var r_arriba: [Int] = []     # 1 conectado
var r_bytes_in: [Int] = []   # los contadores de la lectura anterior, para la velocidad
var r_bytes_out: [Int] = []
var r_entra: [Int] = []      # bytes (o paquetes) por segundo; -1 si el driver no los da
var r_sale: [Int] = []
var r_wifi: [Int] = []       # lo que dio wifi_read: 0 leída, 1 sin respuesta, 2 no es WiFi, 4 desconectada
var r_senal: [Int] = []      # dBm
var r_ms: Int = 0            # cuándo fue la lectura anterior

func por_ciento(milesimas: Int) -> String
    return "#{milesimas / 10},#{milesimas % 10} %"
end

func kb(bytes: Int) -> String
    k = bytes / 1024
    if k >= 10240
        return "#{k / 1024} MB"
    end
    return "#{k} KB"
end

# un tamaño en KB, como lo diría Info
func tam(k: Int) -> String
    if k >= 1048576
        g = k / 104858                   # décimas de GB
        return "#{g / 10},#{g % 10} GB"
    end
    if k >= 10240
        return "#{k / 1024} MB"
    end
    return "#{k} KB"
end

func velocidad(b: Int) -> String
    if b >= 1048576
        m = b / 104858
        return "#{m / 10},#{m % 10} MB/s"
    end
    if b >= 1024
        k = b * 10 / 1024
        return "#{k / 10},#{k % 10} KB/s"
    end
    return "#{b} B/s"
end

func paquetes(p: Int) -> String
    return "#{p} paq/s"
end

func calidad(dbm: Int) -> String
    if dbm >= -50
        return "excelente"
    elif dbm >= -60
        return "buena"
    elif dbm >= -70
        return "regular"
    end
    return "mala"
end

# la línea de la WiFi de un interfaz: solo si es WiFi
func con_wifi(i: Int) -> Bool
    return r_wifi[i] == 0 or r_wifi[i] == 1 or r_wifi[i] == 4
end

# un ajuste: de ENV:Trasfondo.prefs (NOMBRE=valor, una línea cada uno) si está ahí; si no, el tooltype
# (o el argumento del Shell)
func conf(nombre: String, defecto: String) -> String
    var lineas: [String] = str_split(str_replace(prefs, "\r", ""), "\n")
    for i in (0..lineas.length - 1)
        l = str_trim(lineas[i])
        igual = str_find(l, "=")
        if igual > 0 and str_upper(str_trim(l[0:igual])) == nombre
            return str_trim(l[igual + 1:l.length])
        end
    end
    return tooltype(nombre, defecto)
end

# lee ENV:Trasfondo.prefs; true si cambió desde la última vez
func leer_prefs() -> Bool
    texto = file_read_text("ENV:Trasfondo.prefs")
    if texto == nil
        texto = ""
    end
    if texto == prefs
        return false
    end
    prefs = texto
    return true
end

# la tecla rápida de los ajustes ("" la quita)
func poner_tecla()
    tecla = conf("CX_POPKEY", "")
    if tecla != tecla_puesta
        if not cx_hotkey(tecla) and tecla != ""
            Print "Trasfondo: la tecla rápida no vale: " + tecla
        end
        tecla_puesta = tecla
    end
end

# MOSTRAR=CPU,MEMORIA,TAREAS,DISCOS,RED (en el orden que se quiera; también en inglés) y TAREAS=6
func leer_secciones()
    texto = conf("MOSTRAR", tooltype("SHOW", SECCIONES))
    secciones = []
    var nombres: [String] = str_split(str_replace(str_lower(texto), ",", " "), " ")
    for i in (0..nombres.length - 1)
        s = str_trim(nombres[i])
        if s == "memory" or s == "mem"
            s = "memoria"
        elif s == "tasks"
            s = "tareas"
        elif s == "disks"
            s = "discos"
        elif s == "net" or s == "network" or s == "wifi"
            s = "red"
        end
        if (s == "cpu" or s == "memoria" or s == "tareas" or s == "discos" or s == "red") and not hay(s)
            secciones.push(s)
        end
    end
    if secciones.length == 0
        secciones = ["cpu", "memoria", "tareas", "discos", "red"]
    end
    tareas_max = Int(conf("TAREAS", tooltype("TASKS", "#{TAREAS}")))
    if tareas_max < 1
        tareas_max = 1
    elif tareas_max > 20
        tareas_max = 20
    end
end

func hay(s: String) -> Bool
    for i in (0..secciones.length - 1)
        if secciones[i] == s
            return true
        end
    end
    return false
end

func alto_seccion(s: String) -> Int
    if s == "cpu"
        return ALTO_GRAFICA
    elif s == "memoria"
        return linea * 2
    elif s == "tareas"
        return linea * tareas_max
    elif s == "discos"
        return linea * d_nombre.length
    end
    if r_nombre.length == 0              # la red
        return 0
    end
    alto = linea
    for i in (0..r_nombre.length - 1)
        alto = alto + linea
        if con_wifi(i)
            alto = alto + linea
        end
    end
    return alto
end

func alto_panel() -> Int
    alto = 6 + linea
    primero = true
    for i in (0..secciones.length - 1)
        a = alto_seccion(secciones[i])
        if a > 0
            if primero
                alto = alto + 4
            else
                alto = alto + 6
            end
            alto = alto + a
            primero = false
        end
    end
    return alto + 6
end

func leer_discos()
    d_nombre = []
    d_kb = []
    d_libre = []
    n = disks_read(500)
    for i in (0..n - 1)
        nombre = disk_name(i)
        if nombre != "RAM Disk" and d_nombre.length < DISCOS
            d_nombre.push(nombre)
            d_kb.push(disk_kb(i))
            d_libre.push(disk_free_kb(i))
        end
    end
end

func leer_red()
    ahora = time_ms()
    decimas = (ahora - r_ms) / 100      # décimas de segundo desde la lectura anterior
    if decimas < 1
        decimas = 1
    end
    var nombre: [String] = []
    var arriba: [Int] = []
    var b_in: [Int] = []
    var b_out: [Int] = []
    var entra: [Int] = []
    var sale: [Int] = []
    var wifi: [Int] = []
    var senal: [Int] = []
    m = net_ifs_read()
    r_paquetes = m < 0
    if m < 0                             # sin Roadshow: los drivers de red en uso, con cualquier pila
        m = net_drivers_read()
    end
    for i in (0..m - 1)
        n = ""
        if r_paquetes
            n = net_driver_name(i)
        else
            n = net_if_name(i)
        end
        if n != "lo0" and nombre.length < REDES
            nombre.push(n)
            w = 0
            d = 0
            bi = 0
            bo = 0
            if r_paquetes
                w = wifi_read_device(n, 0, 300)
                d = net_driver_read(n, 0, 300)
                bi = net_driver_packets_in()
                bo = net_driver_packets_out()
                if w == 4
                    arriba.push(0)
                else
                    arriba.push(1)
                end
            else
                w = wifi_read(n, 300)
                d = 0
                bi = net_if_bytes_in(i)
                bo = net_if_bytes_out(i)
                if net_if_up(i)
                    arriba.push(1)
                else
                    arriba.push(0)
                end
            end
            b_in.push(bi)
            b_out.push(bo)
            e = 0
            s = 0
            if d != 0
                e = -1
                s = -1
            end
            for j in (0..r_nombre.length - 1)
                if r_nombre[j] == n and d == 0 and r_entra[j] >= 0
                    e = (bi - r_bytes_in[j]) * 10 / decimas
                    s = (bo - r_bytes_out[j]) * 10 / decimas
                end
            end
            entra.push(e)
            sale.push(s)
            wifi.push(w)
            if w == 0
                senal.push(wifi_signal())
            else
                senal.push(0)
            end
        end
    end
    r_nombre = nombre
    r_arriba = arriba
    r_bytes_in = b_in
    r_bytes_out = b_out
    r_entra = entra
    r_sale = sale
    r_wifi = wifi
    r_senal = senal
    r_ms = ahora
end

func pintar_cpu(w: Int, yy: Int)
    # la historia: una barra por segundo, de abajo arriba
    gfx_blend_rect(6, yy, w - 7, yy + ALTO_GRAFICA - 1, 0x000000, 90)
    paso = (w - 12) / HISTORIA
    x0 = w - 6 - paso * historia.length
    gfx_pen(c_cpu)
    for i in (0..historia.length - 1)
        alto = historia[i] * ALTO_GRAFICA / 1000
        if alto > 0
            gfx_rect(x0 + i * paso, yy + ALTO_GRAFICA - alto, x0 + i * paso + paso - 2, yy + ALTO_GRAFICA - 1)
        end
    end
end

func pintar_memoria(w: Int, yy: Int)
    gfx_pen(c_texto)
    gfx_text_at(6, yy + font_baseline(), "Chip libre")
    t = kb(mem_chip_free())
    gfx_text_at(w - 6 - font_text_width(t), yy + font_baseline(), t)
    yy = yy + linea
    gfx_text_at(6, yy + font_baseline(), "Fast libre")
    t = kb(mem_fast_free())
    gfx_text_at(w - 6 - font_text_width(t), yy + font_baseline(), t)
end

func pintar_tareas(w: Int, yy: Int)
    # las tareas que más toman: nombre, % y una barra detrás
    n = n_tareas
    if n > tareas_max
        n = tareas_max
    end
    for i in (0..n - 1)
        carga = cpu_task_load(i)
        largo = (w - 12) * carga / 1000
        if largo > 0
            gfx_blend_rect(6, yy, 6 + largo, yy + linea - 2, 0x40C0FF, 110)
        end
        gfx_pen(c_suave)
        nombre = cpu_task_name(i)
        if nombre.length > 24
            nombre = nombre[0:24]
        end
        gfx_text_at(8, yy + font_baseline(), nombre)
        t = por_ciento(carga)
        gfx_text_at(w - 8 - font_text_width(t), yy + font_baseline(), t)
        yy = yy + linea
    end
end

func pintar_discos(w: Int, yy: Int)
    t = ""
    # los discos: el nombre, lo ocupado (barra y %) y el tamaño
    for i in (0..d_nombre.length - 1)
        if d_kb[i] > 0
            usado = (d_kb[i] - d_libre[i]) / (d_kb[i] / 1000 + 1)      # tantos por mil, sin desbordar
            largo = (w - 12) * usado / 1000
            if largo > 0
                gfx_blend_rect(6, yy, 6 + largo, yy + linea - 2, 0x60D080, 90)
            end
            t = "#{usado / 10} % de " + tam(d_kb[i])
        elif d_kb[i] == 0
            t = "vacío"
        else
            t = "sin respuesta"
        end
        gfx_pen(c_suave)
        nombre = d_nombre[i]
        if nombre.length > 14
            nombre = nombre[0:14]
        end
        gfx_text_at(8, yy + font_baseline(), nombre)
        gfx_text_at(w - 8 - font_text_width(t), yy + font_baseline(), t)
        yy = yy + linea
    end
end

func pintar_red(w: Int, yy: Int)
    t = ""
    # la red: lo que entra y sale por segundo, y la señal de la WiFi
    col = font_text_width("999,9 KB/s") + 10        # ancho de la columna de lo que sale
    gfx_pen(c_texto)
    gfx_text_at(6, yy + font_baseline(), "Red")
    gfx_text_at(w - 8 - col - font_text_width("entra"), yy + font_baseline(), "entra")
    gfx_text_at(w - 8 - font_text_width("sale"), yy + font_baseline(), "sale")
    yy = yy + linea
    for i in (0..r_nombre.length - 1)
        gfx_pen(c_suave)
        nombre = r_nombre[i]
        if nombre.length > 7 and nombre[nombre.length - 7:] == ".device"
            nombre = nombre[0:nombre.length - 7]          # "wifipi.device": "wifipi"
        end
        gfx_text_at(8, yy + font_baseline(), nombre)
        if r_arriba[i] == 1 and r_entra[i] < 0
            t = "sin datos"
            gfx_text_at(w - 8 - font_text_width(t), yy + font_baseline(), t)
        elif r_arriba[i] == 1
            if r_paquetes
                t = paquetes(r_entra[i])
            else
                t = velocidad(r_entra[i])
            end
            gfx_text_at(w - 8 - col - font_text_width(t), yy + font_baseline(), t)
            if r_paquetes
                t = paquetes(r_sale[i])
            else
                t = velocidad(r_sale[i])
            end
            gfx_text_at(w - 8 - font_text_width(t), yy + font_baseline(), t)
        else
            t = "desconectado"
            gfx_text_at(w - 8 - font_text_width(t), yy + font_baseline(), t)
        end
        yy = yy + linea
        if con_wifi(i)
            if r_wifi[i] == 0
                fuerza = (r_senal[i] + 90) * 1000 / 60              # -90 dBm nada, -30 todo
                if fuerza > 1000
                    fuerza = 1000
                end
                if fuerza > 0
                    gfx_blend_rect(6, yy, 6 + (w - 12) * fuerza / 1000, yy + linea - 2, 0x40C0FF, 90)
                end
                t = "#{r_senal[i]} dBm, " + calidad(r_senal[i])
            elif r_wifi[i] == 1
                t = "sin respuesta"
            else
                t = "desconectada"
            end
            gfx_text_at(16, yy + font_baseline(), "WiFi")
            gfx_text_at(w - 8 - font_text_width(t), yy + font_baseline(), t)
            yy = yy + linea
        end
    end
end

func pintar(x, y, w, h)
    if not colores                       # las plumas, de la pantalla en la que se pinta
        c_texto = color_pen(240, 240, 240)
        c_suave = color_pen(200, 210, 220)
        c_cpu = color_pen(80, 200, 255)
        c_fondo = color_pen(16, 24, 32)
        paleta = rtg_get_depth() <= 8   # la del panel, que es la de la pantalla
        colores = true
    end
    if paleta                            # sin color real, el velo sería un moteado ilegible sobre un fondo claro
        gfx_pen(c_fondo)
        gfx_rect(0, 0, w - 1, h - 1)
    else
        gfx_blend_rect(0, 0, w - 1, h - 1, 0x101820, 150)   # velo oscuro: el fondo se ve a través
    end
    font_style(2)
    gfx_pen(c_texto)
    yy = 6
    gfx_text_at(6, yy + font_baseline(), "Trasfondo")
    total = 0
    if historia.length > 0
        total = historia[historia.length - 1]
    end
    t = "CPU " + por_ciento(total)
    gfx_text_at(w - 6 - font_text_width(t), yy + font_baseline(), t)
    font_style(0)
    yy = yy + linea
    primero = true
    for i in (0..secciones.length - 1)
        s = secciones[i]
        a = alto_seccion(s)
        if a > 0
            if primero
                yy = yy + 4
            else
                yy = yy + 6
            end
            primero = false
            if s == "cpu"
                pintar_cpu(w, yy)
            elif s == "memoria"
                pintar_memoria(w, yy)
            elif s == "tareas"
                pintar_tareas(w, yy)
            elif s == "discos"
                pintar_discos(w, yy)
            else
                pintar_red(w, yy)
            end
            yy = yy + a
        end
    end
end

# los discos y la red, que deciden el alto del panel: solo con el panel a la vista
func medir_paneles()
    if hay("discos")
        leer_discos()
    end
    if hay("red")
        leer_red()
    end
end

func mostrar()
    if lienzo == 0
        alto_lienzo = alto_panel()
        lienzo = desktop_canvas(-4, 4, ANCHO, alto_lienzo)
        if lienzo == 0
            Print "Trasfondo: no puedo pintar en el fondo del Workbench"
        else
            desktop_canvas_on_draw(lienzo, pintar)
        end
    end
end

func ocultar()
    if lienzo != 0
        desktop_canvas_free(lienzo)
        lienzo = 0
    end
end

# una orden de Exchange (o la tecla rápida)
func obedecer(orden: Int)
    if orden == CX_OCULTAR
        visible = false
        ocultar()
    elif orden == CX_MOSTRAR
        visible = true
    elif orden == CX_TECLA
        visible = not visible
    elif orden == CX_DESACTIVAR and activo
        ocultar()
        cpu_stop()
        historia = []
        activo = false
    elif orden == CX_ACTIVAR and not activo
        activo = cpu_start()
        if activo
            n_tareas = cpu_sample()
        end
    end
    if not visible
        ocultar()
    elif activo and lienzo == 0
        medir_paneles()
        mostrar()
        if lienzo != 0
            desktop_canvas_update(lienzo)        # al momento, sin esperar al segundo siguiente
        end
    end
end

Main
    # lanzarlo otra vez lo para (y Ctrl-C, o Break desde la Shell, o Eliminar en Exchange)
    if not single_instance("Trasfondo")
        Print "Trasfondo ya estaba en marcha: se para"
    elif not cpu_start()
        Print "Trasfondo: no puedo medir la CPU (hace falta OS 2.04 o posterior)"
    else
        linea = font_height() + 1
        leer_prefs()
        leer_secciones()
        if cx_broker("Trasfondo", "Trasfondo 0.4", "Monitor de recursos en el fondo", Int(conf("CX_PRIORITY", "0")))
            poner_tecla()
        end
        visible = str_upper(conf("CX_POPUP", "YES")) != "NO"
        n_tareas = cpu_sample()
        if visible
            medir_paneles()
            mostrar()
        end
        if not visible or lienzo != 0
            proximo = time_ms() + 1000       # cada segundo justo, aunque lleguen órdenes entre medias
            while true
                espera = proximo - time_ms()
                if espera < 1
                    espera = 1
                end
                orden = cx_wait(espera)
                if orden == -1 or orden == CX_ELIMINAR
                    break
                elif orden > 0
                    obedecer(orden)
                else                         # pasó el segundo
                    proximo = proximo + 1000
                    if proximo < time_ms()
                        proximo = time_ms() + 1000
                    end
                    if activo
                        n_tareas = cpu_sample()
                        historia.push(cpu_total())
                        if historia.length > HISTORIA
                            historia.remove(0)
                        end
                    end
                    if leer_prefs()          # TrasfondoPrefs cambió los ajustes
                        leer_secciones()
                        poner_tecla()
                    end
                    if lienzo != 0
                        medir_paneles()
                        if alto_panel() != alto_lienzo      # otro disco, otra red, otras secciones: otro alto
                            ocultar()
                            mostrar()
                        end
                    end
                    if lienzo != 0
                        desktop_canvas_update(lienzo)
                    end
                end
            end
        end
    end
end
