# Los avisos de Trasfondo 2.0: una lista en ENV:Trasfondo.avisos, uno por línea, del más viejo al más nuevo:
#   hora <tab> quién avisa <tab> título <tab> texto
# Los deja la orden Avisa (o cualquiera que escriba ahí una línea así). La barra los cuenta y enseña el
# último un momento; el panel los lista y los descarta.

const AVISOS = "ENV:Trasfondo.avisos"
const AVISOS_TOPE = 50       # los más viejos se tiran

var av_hora: [String] = []
var av_de: [String] = []
var av_titulo: [String] = []
var av_texto: [String] = []

# un texto que se pueda guardar en una línea con tabuladores
func av_limpio(t: String) -> String
    return str_replace(str_replace(str_replace(t, "\t", " "), "\r", ""), "\n", " ")
end

func avisos_leer()
    av_hora = []
    av_de = []
    av_titulo = []
    av_texto = []
    texto = file_read_text(AVISOS)
    if texto == nil
        return
    end
    for l in str_split(texto, "\n")
        p = str_split(l, "\t")
        if p.length >= 4
            av_hora.push(p[0])
            av_de.push(p[1])
            av_titulo.push(p[2])
            av_texto.push(p[3])
        end
    end
end

func avisos_guardar()
    if av_hora.length == 0
        file_delete(AVISOS)
        return
    end
    texto = ""
    for i in (0..av_hora.length - 1)
        texto = texto + av_hora[i] + "\t" + av_de[i] + "\t" + av_titulo[i] + "\t" + av_texto[i] + "\n"
    end
    file_write_text(AVISOS, texto)
end

func avisos_nuevo(de: String, titulo: String, texto: String)
    avisos_leer()
    av_hora.push(date_text("%H:%M"))
    av_de.push(av_limpio(de))
    av_titulo.push(av_limpio(titulo))
    av_texto.push(av_limpio(texto))
    while av_hora.length > AVISOS_TOPE
        av_hora.remove(0)
        av_de.remove(0)
        av_titulo.remove(0)
        av_texto.remove(0)
    end
    avisos_guardar()
end

func avisos_quitar(i: Int)
    if i >= 0 and i < av_hora.length
        av_hora.remove(i)
        av_de.remove(i)
        av_titulo.remove(i)
        av_texto.remove(i)
        avisos_guardar()
    end
end

func avisos_cuantos() -> Int
    return av_hora.length
end

# ---- el puerto ARexx de la barra: TRASFONDO ----
#   NOTIFY TITLE="..." [TEXT="..."] [FROM="..."]   (o NOTIFY "título" "texto" "quién"; también TITULO, TEXTO, DE)
#   COUNT                                          cuántos avisos hay (en RESULT)
#   CLEAR                                          los quita todos
# Lo que manda notify() de Dash, y lo que quiera cualquier guion: ADDRESS TRASFONDO 'NOTIFY "Copia hecha"'.

# las palabras de una orden, con las comillas quitadas ("a b" es una)
func av_palabras(orden: String) -> [String]
    var r: [String] = []
    actual = ""
    dentro = false
    hay = false
    for i in (0..orden.length - 1)
        c = orden[i:i + 1]
        if c == "\""
            dentro = not dentro
            hay = true
        elif c == " " and not dentro
            if hay
                r.push(actual)
            end
            actual = ""
            hay = false
        else
            actual = actual + c
            hay = true
        end
    end
    if hay
        r.push(actual)
    end
    return r
end

# lo que va tras CLAVE= si la palabra empieza así (sin mirar mayúsculas); nil si no
func av_clave(palabra: String, claves: [String]) -> String
    for k in claves
        if str_starts(str_upper(palabra), k + "=")
            return palabra[k.length + 1:palabra.length]
        end
    end
    return nil
end

# una orden que llegó al puerto: la hace y la contesta
func av_orden(orden: String)
    var p: [String] = av_palabras(orden)
    if p.length == 0
        rexx_reply(10, "")
        return
    end
    que = str_upper(p[0])
    if que == "NOTIFY"
        titulo = ""
        texto = ""
        de = "ARexx"
        sueltas = 0
        for i in (1..p.length - 1)
            var t_: [String] = ["TITLE", "TITULO"]
            var x_: [String] = ["TEXT", "TEXTO"]
            var d_: [String] = ["FROM", "DE"]
            v = av_clave(p[i], t_)
            if v != nil
                titulo = v
            else
                v = av_clave(p[i], x_)
                if v != nil
                    texto = v
                else
                    v = av_clave(p[i], d_)
                    if v != nil
                        de = v
                    elif sueltas == 0
                        titulo = p[i]
                        sueltas = 1
                    elif sueltas == 1
                        texto = p[i]
                        sueltas = 2
                    else
                        de = p[i]
                    end
                end
            end
        end
        if titulo == "" and texto == ""
            rexx_reply(10, "")
            return
        end
        avisos_nuevo(de, titulo, texto)
        rexx_reply(0, "")
    elif que == "COUNT"
        avisos_leer()
        rexx_reply(0, "#{avisos_cuantos()}")
    elif que == "CLEAR"
        file_delete(AVISOS)
        rexx_reply(0, "")
    else
        rexx_reply(10, "")
    end
end

# las órdenes que hayan llegado (en cada vuelta del bucle)
func av_puerto()
    orden = rexx_get()
    while orden != ""
        av_orden(orden)
        orden = rexx_get()
    end
end
