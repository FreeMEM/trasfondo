# TrasfondoPrefs: las preferencias de Trasfondo en una ventana, como las de SYS:Prefs, por secciones:
# - Fondo: qué secciones se ven, cuántas tareas, la tecla rápida, cada cuánto mide, el fondo (con velo o fijo) y
#   su color, si arranca oculto y si busca versiones nuevas.
# - Barra: el lugar del tiempo (una ciudad, o latitud y longitud).
# - Dock: en qué borde, el tamaño de los iconos y sus lanzadores (ENVARC:Trasfondo.dock, en Ed).
# - Ventanas: el hueco entre ventanas, el mosaico automático y las teclas.
# - Arranque: qué piezas arrancan con el Workbench (sus iconos de proyecto en SYS:WBStartup).
# Usar las deja en ENV:Trasfondo.prefs (hasta reiniciar); Guardar, también en ENVARC:. El fondo las nota en un
# segundo; la barra, el dock y las ventanas, si están en marcha y cambió lo suyo, se vuelven a arrancar.
# Lo que no está en ese fichero lo siguen diciendo los tooltypes del icono de cada pieza.
# Las piezas están en el cajón que dice ENV:Trasfondo.cajon (lo escribe el instalador).
#
#   TrasfondoPrefs ARRANCAR    arranca (o vuelve a arrancar) las piezas que arrancan con el Workbench

@workbench_output "NIL:"
@version "TrasfondoPrefs 2.9.2"
@catalog "Trasfondo.catalog" 1       # el mismo que Trasfondo: los textos, en inglés; el castellano, en el catálogo

import "textos.dash"
import "tema.dash"
import "paleta.dash"

const SECCIONES = "fecha,cpu,temperatura,memoria,tareas,discos,red"
const COLORES = "16,24,32|0,0,0|48,48,48|16,40,96|16,56,32|72,16,24|48,24,72"   # los de MSG_COLORES, en su orden
const DOCK_DE_SERIE = "SYS:Utilities/MultiView\nSYS:System/Shell\nSYS:Utilities/Clock\nSYS:Tools/Calculator\nSYS:Prefs\n"
const PIEZAS = "Trasfondo|TrasfondoBarra|TrasfondoDock|TrasfondoVentanas"

# los gadgets de cada clase
const G_CASILLA = 0
const G_NUMERO = 1
const G_TEXTO = 2
const G_CICLO = 3

var prefs: String = ""
var cajon: String = ""                 # donde están las piezas ("" si no se sabe)
var valores: {String: String} = {}     # cada ajuste, como irá al fichero
var antes_v: {String: String} = {}     # y como estaba al abrir
var antes: [String] = []               # las secciones del fondo, en su orden
var claves: [String] = ["fecha", "cpu", "temperatura", "memoria", "grafica_memoria", "tareas", "discos", "red", "grafica_red"]
var dock_editado: Bool = false
var arr_antes: {String: String} = {}   # las marcas de Arranque al abrir: Usar solo toca las que cambian

# los gadgets de la página que se ve: su número, su ajuste, su clase y, los ciclos, sus valores (con |)
var g_num: [Int] = []
var g_clave: [String] = []
var g_clase: [Int] = []
var g_opciones: [String] = []

# medidas de la ventana
var f: Int = 8
var fila: Int = 16
var m: Int = 12
var hueco: Int = 8
var ancho: Int = 400
var alto: Int = 300
var x_campo: Int = 0
var filas_s: Int = 5
var columna: Int = 0
var alto_boton: Int = 14

# gadgets fijos
var g_seccion: Int = -1
var g_guardar: Int = -1
var g_usar: Int = -1
var g_cancelar: Int = -1
var g_actualizar: Int = -1
var g_estado: Int = -1
var g_lanzadores: Int = -1
var seccion: Int = 0
var y_muestras: Int = 0                # dónde van las muestras de los colores (página 4)

# un ajuste de las preferencias (NOMBRE=valor), o el defecto
func conf(nombre: String, defecto: String) -> String
    var lineas: [String] = str_split(str_replace(prefs, "\r", ""), "\n")
    for l in lineas
        igual = str_find(l, "=")
        if igual > 0 and str_upper(str_trim(l[0:igual])) == nombre
            return str_trim(l[igual + 1:l.length])
        end
    end
    return defecto
end

# las secciones de MOSTRAR, en su orden y con los nombres de Trasfondo (también acepta los ingleses)
func secciones_de(texto: String) -> [String]
    var r: [String] = []
    var nombres: [String] = str_split(str_replace(str_lower(texto), ",", " "), " ")
    for n in nombres
        s = str_trim(n)
        if s == "memory" or s == "mem"
            s = "memoria"
        elif s == "tasks"
            s = "tareas"
        elif s == "disks"
            s = "discos"
        elif s == "net" or s == "network" or s == "wifi"
            s = "red"
        elif s == "date" or s == "time" or s == "clock" or s == "hora" or s == "reloj"
            s = "fecha"
        elif s == "temp" or s == "temperature" or s == "pistorm"
            s = "temperatura"
        elif s == "netgraph" or s == "graficared"
            s = "grafica_red"
        elif s == "memgraph" or s == "graficamemoria"
            s = "grafica_memoria"
        end
        if s == "fecha" or s == "cpu" or s == "temperatura" or s == "memoria" or s == "grafica_memoria" or s == "tareas" or s == "discos" or s == "red" or s == "grafica_red"
            r.push(s)
        end
    end
    return r
end

func esta(lista: [String], s: String) -> Bool
    for x in lista
        if x == s
            return true
        end
    end
    return false
end

# el número de la opción de un ciclo que tiene ese valor (0 si ninguna)
func opcion(opciones: String, valor: String) -> Int
    var l: [String] = str_split(opciones, "|")
    i = 0
    while i < l.length
        if l[i] == valor
            return i
        end
        i = i + 1
    end
    return 0
end

func si(b: Bool) -> String
    if b
        return "SI"
    end
    return "NO"
end

# ¿está en marcha esa pieza? (su puerto de single_instance)
func corriendo(nombre: String) -> Bool
    n = ports_read()
    i = 0
    while i < n
        if port_name(i) == nombre
            return true
        end
        i = i + 1
    end
    return false
end

# arranca una pieza; si ya estaba en marcha, la para antes (lanzarla otra vez la para)
func arrancar(nombre: String)
    if cajon == ""
        return
    end
    orden = "Run >NIL: \"" + cajon + nombre + "\""
    if corriendo(nombre)
        run_command(orden)
        vueltas = 0
        while corriendo(nombre) and vueltas < 100
            time_delay(5)
            vueltas = vueltas + 1
        end
    end
    run_command(orden)
end

# para una pieza en marcha (lanzarla otra vez la para: su single_instance le manda un Ctrl-C)
func parar(nombre: String)
    if cajon == "" or not corriendo(nombre)
        return
    end
    run_command("Run >NIL: \"" + cajon + nombre + "\"")
    vueltas = 0
    while corriendo(nombre) and vueltas < 100
        time_delay(5)
        vueltas = vueltas + 1
    end
end

# solo si está en marcha (para que tome sus ajustes nuevos)
func rearrancar(nombre: String)
    if corriendo(nombre)
        arrancar(nombre)
    end
end

func en_arranque(nombre: String) -> Bool
    return file_exists("SYS:WBStartup/" + nombre + ".info")
end

# ---- la ventana ----

func casilla(x: Int, y: Int, texto: String, clave: String)
    g_num.push(gt_checkbox(x, y, 26, f + 3, texto, valores[clave] == "SI"))
    g_clave.push(clave)
    g_clase.push(G_CASILLA)
    g_opciones.push("")
end

func numero(y: Int, texto: String, clave: String, ancho_n: Int)
    g_num.push(gt_integer(x_campo, y, ancho_n, f + 6, texto, Int(valores[clave])))
    g_clave.push(clave)
    g_clase.push(G_NUMERO)
    g_opciones.push("")
end

func campo(y: Int, texto: String, clave: String)
    g_num.push(gt_string(x_campo, y, ancho - x_campo - m, f + 6, texto, valores[clave], 60))
    g_clave.push(clave)
    g_clase.push(G_TEXTO)
    g_opciones.push("")
end

# un ciclo: nombres (lo que se ve) y opciones (lo que va al fichero), con |
func ciclo(y: Int, texto: String, clave: String, nombres: String, opciones: String)
    g_num.push(gt_cycle(x_campo, y, ancho - x_campo - m, f + 6, texto, nombres))
    g_clave.push(clave)
    g_clase.push(G_CICLO)
    g_opciones.push(opciones)
end

# lo que dicen los gadgets de la página, a valores
func recoger()
    i = 0
    while i < g_num.length
        c = g_clase[i]
        if c == G_CASILLA
            valores[g_clave[i]] = si(gt_get_value(g_num[i]) != 0)
        elif c == G_NUMERO
            n = gt_get_value(g_num[i])
            valores[g_clave[i]] = "#{n}"
        elif c == G_TEXTO
            valores[g_clave[i]] = str_trim(gt_get_string(g_num[i]))
        else
            var l: [String] = str_split(g_opciones[i], "|")
            k = gt_get_value(g_num[i])
            if k >= 0 and k < l.length
                valores[g_clave[i]] = l[k]
            end
        end
        i = i + 1
    end
end

# el tema que dicen los valores de la página de colores: su texto (tema.dash), o "" para los de siempre
func tema_actual() -> String
    if valores["TEMA"] != "FONDO"
        return ""
    end
    if valores["TEMA_ESQUEMA"] == "WORKBENCH"
        return tema_workbench()        # (sin imagen que leer)
    end
    img = valores["TEMA_IMAGEN"]
    if img == ""
        img = imagen_del_fondo()
    end
    if img == "" or not acento_de(img)
        acento_h = 210                 # (sin imagen que leer: el azul de siempre)
        acento_s = 600
    end
    return tema_de(valores["TEMA_ESQUEMA"], valores["TEMA_MODO"] == "CLARO")
end

func pintar_con(c: Int)
    gfx_pen(color_pen((c >> 16) & 255, (c >> 8) & 255, c & 255))
end

# un texto en (x, y), con y la línea de arriba del texto
func texto_en(x: Int, y: Int, s: String, c: Int)
    pintar_con(c)
    gfx_text_at(x, y + font_baseline(), s)
end

# una píldora: rectángulo de color con un texto dentro; devuelve su ancho
func pildora(x: Int, y: Int, h: Int, s: String, fondo: Int, letra: Int) -> Int
    w = font_text_width(s) + 10
    pintar_con(fondo)
    gfx_rect(x, y, x + w - 1, y + h - 1)
    texto_en(x + 5, y + (h - font_height()) / 2, s, letra)
    return w
end

# cómo quedará, en pequeño, con los colores del tema (los de siempre si no hay tema): la barra arriba, un panel con
# su tarjeta, el día de hoy y un botón, y el dock abajo, sobre un escritorio oscuro
func muestras()
    tema_texto = tema_actual()
    tema_leido = true
    c_fondo = tema_color("FONDO", 0x101317)
    c_panel = tema_color("PANEL", 0x16191d)
    c_tarjeta = tema_color("TARJETA", 0x23272e)
    c_boton = tema_color("BOTON", 0x30353d)
    c_borde = tema_color("BORDE", 0x30353d)
    c_tenue = tema_color("TENUE", 0x5f6368)
    c_suave = tema_color("SUAVE", 0x9aa0a6)
    c_texto = tema_color("TEXTO", 0xe8eaed)
    c_acento = tema_color("ACENTO", 0x8ab4f8)
    c_sobre = tema_color("SOBRE_ACENTO", 0x16191d)
    c_claro = tema_color("CLARO", 0xf1f3f4)
    c_peligro = tema_color("PELIGRO", 0xf28b82)
    gfx_mode(0)
    x0 = m
    y0 = y_muestras
    w = ancho - m * 2
    h = alto - m - alto_boton - hueco - y0
    fh = font_height()
    # el escritorio
    pintar_con(0x30343a)
    gfx_rect(x0, y0, x0 + w - 1, y0 + h - 1)
    # la barra
    bh = fh + 6
    pintar_con(c_fondo)
    gfx_rect(x0, y0, x0 + w - 1, y0 + bh - 1)
    px = pildora(x0 + 3, y0 + 2, bh - 4, "Trasfondo", c_boton, c_acento)
    reloj = "12:00"
    pw = font_text_width(reloj) + 10
    px = pildora(x0 + (w - pw) / 2, y0 + 2, bh - 4, reloj, c_boton, c_texto)
    cpu = "CPU 92%"
    pw = font_text_width(cpu) + 10
    px = pildora(x0 + w - pw - 3, y0 + 2, bh - 4, cpu, c_boton, c_peligro)
    mem = "MEM 11%"
    pw2 = font_text_width(mem) + 10
    px = pildora(x0 + w - pw - pw2 - 7, y0 + 2, bh - 4, mem, c_boton, c_suave)
    # un panel a la derecha, bajo la barra
    pw = w * 45 / 100
    ph = h - bh - 8
    xp = x0 + w - pw - 4
    yp = y0 + bh + 4
    pintar_con(c_borde)
    gfx_rect(xp, yp, xp + pw - 1, yp + ph - 1)
    pintar_con(c_panel)
    gfx_rect(xp + 1, yp + 1, xp + pw - 2, yp + ph - 2)
    # su tarjeta: un título, un texto suave y los días, con hoy marcado
    th = fh * 3 + 12
    pintar_con(c_tarjeta)
    gfx_rect(xp + 5, yp + 5, xp + pw - 6, yp + 5 + th - 1)
    texto_en(xp + 10, yp + 8, "Trasfondo 2.0", c_texto)
    texto_en(xp + 10, yp + 9 + fh, "Workbench 3.2", c_suave)
    dx = xp + 10
    dy = yp + 10 + fh * 2
    for d in (2..6)
        s = "#{d}"
        if d == 4
            pintar_con(c_acento)
            gfx_rect(dx - 2, dy - 1, dx + font_text_width("00") + 1, dy + fh)
            texto_en(dx, dy, s, c_sobre)
        else
            texto_en(dx, dy, s, c_tenue)
        end
        dx = dx + font_text_width("00") + 8
    end
    # dos botones: uno normal y uno encendido (claro)
    yb = yp + 5 + th + 5
    if yb + fh + 4 < yp + ph - 4
        bw = pildora(xp + 5, yb, fh + 4, "Wi-Fi", c_claro, c_fondo)
        bw = pildora(xp + 5 + bw + 5, yb, fh + 4, "Off", c_boton, c_texto)
    end
    # el dock, abajo a la izquierda: teselas y el punto de uno abierto
    t = fh + 8
    dw = 4 * (t + 4) + 6
    dh = t + 10
    xd = x0 + 6
    yd = y0 + h - dh - 4
    pintar_con(c_borde)
    gfx_rect(xd, yd, xd + dw - 1, yd + dh - 1)
    pintar_con(c_panel)
    gfx_rect(xd + 1, yd + 1, xd + dw - 2, yd + dh - 2)
    for k in (0..3)
        tx = xd + 5 + k * (t + 4)
        pintar_con(c_boton)
        gfx_rect(tx, yd + 4, tx + t - 1, yd + 4 + t - 1)
    end
    pintar_con(c_suave)
    gfx_rect(xd + 5 + t / 2 - 1, yd + dh - 4, xd + 5 + t / 2 + 1, yd + dh - 3)
end

# el tema a ENV: (y a ENVARC: al guardar); con los de siempre, fuera
func escribir_tema(guardar: Bool)
    texto = tema_actual()
    if texto == ""
        file_delete(TEMA)
        if guardar
            file_delete(TEMA_ARC)
        end
        return
    end
    ok = file_write_text(TEMA, texto)
    if guardar
        ok = file_write_text(TEMA_ARC, texto)
    end
end

# ¿es e un gadget de la página?
func de_la_pagina(e: Int) -> Bool
    for g in g_num
        if g == e
            return true
        end
    end
    return false
end

# la página n (0 fondo, 1 barra, 2 dock, 3 ventanas, 4 colores, 5 arranque), con la fila de arriba y los botones
func pagina(n: Int, linea_version: String)
    gt_init()
    gfx_clear()
    g_num = []
    g_clave = []
    g_clase = []
    g_opciones = []
    g_actualizar = -1
    g_estado = -1
    g_lanzadores = -1
    seccion = n
    y = m
    g_seccion = gt_cycle(x_campo, y, ancho - x_campo - m, f + 6, tr(MSG_SECCION, "Section"), tr(MSG_SECCIONES, "Background|Bar|Dock|Windows|Colours|Startup"))
    y = y + fila + hueco
    x = m
    ancho_n = screen_font_text_width("000") + 24
    if n == 0
        var etiquetas: [String] = [tr(MSG_VER_FECHA, "Show the date and time"), tr(MSG_VER_CPU, "Show the CPU graph"), tr(MSG_VER_TEMP, "Show the Pi temperature"), tr(MSG_VER_MEMORIA, "Show the free memory"), tr(MSG_VER_GMEM, "Show the memory graph"), tr(MSG_VER_TAREAS, "Show the tasks"), tr(MSG_VER_DISCOS, "Show the disks"), tr(MSG_VER_RED, "Show the network and WiFi"), tr(MSG_VER_GRED, "Show the network graph")]
        i = 0
        while i < claves.length
            x_s = x
            if i >= filas_s
                x_s = x + columna
            end
            casilla(x_s, y + (i % filas_s) * fila, etiquetas[i], "VER_" + claves[i])
            i = i + 1
        end
        # los segundos, en el hueco que queda en la rejilla (al lado de "Buscar versiones" no cabían: Ferrán García)
        x_s = x
        if i >= filas_s
            x_s = x + columna
        end
        casilla(x_s, y + (i % filas_s) * fila, tr(MSG_SEGUNDOS, "Show the seconds"), "SEGUNDOS")   # (fondo y barra)
        y = y + filas_s * fila + 4
        numero(y, tr(MSG_CUANTAS, "Tasks shown"), "TAREAS", ancho_n)
        casilla(x_campo + ancho_n + 16, y + 1, tr(MSG_OCULTO, "Start hidden"), "OCULTO")
        y = y + fila + 2
        campo(y, tr(MSG_TECLA, "Hotkey"), "CX_POPKEY")
        y = y + fila + 2
        # las unidades que se enseñan (Ferrán García): "Work, Descargas"; vacío, todas menos las vacías
        campo(y, tr(MSG_UNIDADES, "Disks shown"), "UNIDADES")
        y = y + fila + 2
        ciclo(y, tr(MSG_CADA, "Measure every"), "CADA", "1 s|2 s|5 s|10 s", "1|2|5|10")
        y = y + fila + 2
        ciclo(y, tr(MSG_FONDO, "Background"), "FONDO", tr(MSG_FONDOS, "See-through|Solid"), "VELO|FIJO")
        y = y + fila + 2
        ciclo(y, tr(MSG_POSICION, "Position"), "POSICION", tr(MSG_ESQUINAS, "Top right|Top left|Bottom right|Bottom left"), "ARRIBA_DERECHA|ARRIBA_IZQUIERDA|ABAJO_DERECHA|ABAJO_IZQUIERDA")
        y = y + fila + 2
        # los colores de la lista; uno puesto a mano (tooltype o prefs) sale al final, para no perderlo
        nombres = tr(MSG_COLORES, "Night blue|Black|Grey|Blue|Green|Wine|Purple")
        opciones = COLORES
        if not esta(str_split(COLORES, "|"), valores["COLOR"])
            nombres = nombres + "|" + con(tr(MSG_OTRO, "Other (%s)"), valores["COLOR"])
            opciones = opciones + "|" + valores["COLOR"]
        end
        ciclo(y, tr(MSG_COLOR, "Colour"), "COLOR", nombres, opciones)
        y = y + fila + 2
        casilla(x, y, tr(MSG_BUSCAR, "Look for new versions on GitHub"), "BUSCAR")
        y = y + fila + 2
        t_actualizar = tr(MSG_ACTUALIZAR, "Update")
        ancho_act = screen_font_text_width(t_actualizar) + 24
        g_estado = gt_text(x, y, ancho - m * 2 - ancho_act - 8, alto_boton, "", linea_version)
        g_actualizar = gt_button(ancho - m - ancho_act, y, ancho_act, alto_boton, t_actualizar)
    elif n == 1
        ciclo(y, tr(MSG_ESTILO, "Style"), "BARRA_ESTILO", tr(MSG_ESTILOS, "Whole bar|In the title bar"), "COMPLETA|TITULO")
        y = y + fila + 2
        # detrás de las ventanas, como la barra de título del Workbench (Ferrán García), o siempre delante, a la vista
        ciclo(y, tr(MSG_PROFUNDIDAD, "Depth"), "BARRA_PROFUNDIDAD", tr(MSG_PROFUNDIDADES, "Behind the windows|In front of the windows"), "DETRAS|DELANTE")
        y = y + fila + 2
        # lo que enseña la barra (Ferrán García): la hora, los avisos y el botón de los ajustes, siempre
        gt_text(m, y, x_campo - m - 4, f + 6, "", tr(MSG_B_ENSENA, "Shows"))
        paso_b = (ancho - x_campo - m) / 3
        casilla(x_campo, y, tr(MSG_B_FECHA, "Date"), "BARRA_VER_FECHA")
        casilla(x_campo + paso_b, y, tr(MSG_B_TIEMPO, "Weather"), "BARRA_VER_TIEMPO")
        casilla(x_campo + paso_b * 2, y, tr(MSG_B_CPU, "CPU"), "BARRA_VER_CPU")
        y = y + fila
        casilla(x_campo, y, tr(MSG_B_MEMORIA, "Memory"), "BARRA_VER_MEMORIA")
        casilla(x_campo + paso_b, y, tr(MSG_B_TEMP, "Temperature"), "BARRA_VER_TEMPERATURA")
        y = y + fila + 2
        campo(y, tr(MSG_CIUDAD, "City"), "BARRA_CIUDAD")
        y = y + fila + 2
        campo(y, tr(MSG_LAT, "Latitude"), "BARRA_LAT")
        y = y + fila + 2
        campo(y, tr(MSG_LON, "Longitude"), "BARRA_LON")
        y = y + fila + 2
        gt_text(x, y, ancho - m * 2, f + 6, "", tr(MSG_CIUDAD_AYUDA, "Weather: a city in English (Valencia, or Valencia, ES), or lat. and long."))
        y = y + fila + 2
        # las capturas de la pantalla (JaviTecH): la tecla y dónde van; también desde los ajustes rápidos
        campo(y, tr(MSG_CAPTURA_TECLA, "Screenshot key"), "CAPTURA_TECLA")
        y = y + fila + 2
        campo(y, tr(MSG_CAPTURA_CARPETA, "Screenshots to"), "CAPTURA_CARPETA")
        y = y + fila + 2
        gt_text(x, y, ancho - m * 2, f + 6, "", tr(MSG_RTG, "The bar, the dock and their panels need an RTG screen"))
    elif n == 2
        ciclo(y, tr(MSG_POSICION, "Position"), "DOCK_POSICION", tr(MSG_POSICIONES, "Bottom|Top|Left|Right"), "ABAJO|ARRIBA|IZQUIERDA|DERECHA")
        y = y + fila + 2
        numero(y, tr(MSG_TAMANO_ICONO, "Icon size"), "DOCK_ICONO", ancho_n)
        casilla(x_campo + ancho_n + 16, y + 1, tr(MSG_ESCONDER, "Hide it until the mouse reaches its edge"), "DOCK_ESCONDER")
        y = y + fila + 2
        numero(y, tr(MSG_HUECO, "Gap"), "DOCK_HUECO", ancho_n)
        y = y + fila + 2
        ciclo(y, tr(MSG_FONDO, "Background"), "DOCK_FONDO", tr(MSG_D_FONDOS, "Theme|See-through|Colour"), "TEMA|TRANSPARENTE|COLOR")
        y = y + fila + 2
        campo(y, tr(MSG_D_COLOR, "Colour (R,G,B)"), "DOCK_COLOR")
        y = y + fila + 2
        t_lanz = tr(MSG_LANZADORES, "Launchers...")
        ancho_l = screen_font_text_width(t_lanz) + 24
        g_lanzadores = gt_button(x_campo, y, ancho_l, alto_boton, t_lanz)
        y = y + fila + 2
        gt_text(x, y, ancho - m * 2, f + 6, "", tr(MSG_L_AYUDA, "The programs of the dock, in their order"))
    elif n == 3
        numero(y, tr(MSG_HUECO, "Gap"), "VENTANAS_HUECO", ancho_n)
        casilla(x_campo + ancho_n + 16, y + 1, tr(MSG_MOSAICO, "Tile new windows automatically"), "VENTANAS_MOSAICO")
        y = y + fila + 2
        # con el ratón, como en los escritorios de ahora: en dos columnas si caben
        c2 = v_columna()
        casilla(x, y, tr(MSG_V_ENCAJAR, "Snap at the edges"), "VENTANAS_ENCAJAR")
        if c2 == 0
            y = y + fila
        end
        casilla(x + c2, y, tr(MSG_V_DOBLE_CLIC, "Double-click maximizes"), "VENTANAS_DOBLE_CLIC")
        y = y + fila
        casilla(x, y, tr(MSG_V_MENU, "Window menu"), "VENTANAS_MENU")
        if c2 == 0
            y = y + fila
        end
        casilla(x + c2, y, tr(MSG_V_ALT_TAB, "Alt+Tab"), "VENTANAS_ALT_TAB")
        y = y + fila + 4
        var teclas: [String] = ["TECLA_MAXIMIZAR", "TECLA_IZQUIERDA", "TECLA_DERECHA", "TECLA_RESTAURAR", "TECLA_MOSAICO", "TECLA_AUTOMATICO", "TECLA_MENU", "RATON_MOVER", "RATON_TAMANO"]
        var nombres_t: [String] = [tr(MSG_T_MAXIMIZAR, "Maximize"), tr(MSG_T_IZQUIERDA, "Left half"), tr(MSG_T_DERECHA, "Right half"), tr(MSG_T_RESTAURAR, "Restore"), tr(MSG_T_MOSAICO, "Tile"), tr(MSG_T_AUTOMATICO, "Auto tile"), tr(MSG_V_T_MENU, "Window menu"), tr(MSG_T_MOVER, "Move"), tr(MSG_T_TAMANO, "Resize")]
        i = 0
        while i < teclas.length
            campo(y, nombres_t[i], "VENTANAS_" + teclas[i])
            y = y + fila + 2
            i = i + 1
        end
    elif n == 4
        ciclo(y, tr(MSG_COLORES_DE, "Colours"), "TEMA", tr(MSG_TEMAS, "Usual|From the background"), "FIJO|FONDO")
        y = y + fila + 2
        ciclo(y, tr(MSG_MODO, "Mode"), "TEMA_MODO", tr(MSG_MODOS, "Dark|Light"), "OSCURO|CLARO")
        y = y + fila + 2
        ciclo(y, tr(MSG_ESQUEMA, "Scheme"), "TEMA_ESQUEMA", tr(MSG_ESQUEMAS, "Background|Monochrome|Analogous|Complementary|Triad|Vivid|Workbench"), ESQUEMAS)
        y = y + fila + 2
        campo(y, tr(MSG_IMAGEN, "Picture"), "TEMA_IMAGEN")
        y = y + fila + 2
        gt_text(x, y, ancho - m * 2, f + 6, "", tr(MSG_IMAGEN_AYUDA, "Empty: the Workbench backdrop picture"))
        y = y + fila + 6
        y_muestras = y
    else
        var piezas: [String] = str_split(PIEZAS, "|")
        var textos_a: [String] = [tr(MSG_ARR_FONDO, "The background: on, and with the Workbench"), tr(MSG_ARR_BARRA, "The bar: on, and with the Workbench"), tr(MSG_ARR_DOCK, "The dock: on, and with the Workbench"), tr(MSG_ARR_VENTANAS, "The window keys: on, and with the Workbench")]
        i = 0
        while i < piezas.length
            casilla(x, y, textos_a[i], "ARR_" + piezas[i])
            y = y + fila
            i = i + 1
        end
        if cajon == ""
            y = y + 4
            gt_text(x, y, ancho - m * 2, f + 6, "", tr(MSG_SIN_CAJON, "Install Trasfondo with its installer to choose this"))
        end
    end
    y = alto - m - alto_boton
    boton = (ancho - m * 2 - 16) / 3
    g_guardar = gt_button(m, y, boton, alto_boton, tr(MSG_GUARDAR, "Save"))
    g_usar = gt_button(m + boton + 8, y, boton, alto_boton, tr(MSG_USAR, "Use"))
    g_cancelar = gt_button(m + (boton + 8) * 2, y, boton, alto_boton, tr(MSG_CANCELAR, "Cancel"))
    gt_attach()
    gt_set_value(g_seccion, n)
    i = 0
    while i < g_num.length
        if g_clase[i] == G_CICLO
            gt_set_value(g_num[i], opcion(g_opciones[i], valores[g_clave[i]]))
        end
        if cajon == "" and str_starts(g_clave[i], "ARR_")
            gt_disable(g_num[i])
        end
        i = i + 1
    end
    if n == 4
        muestras()
    end
end

# la página Ventanas: dónde va la segunda columna de casillas (lo del ratón), o 0 si no caben dos
func v_columna() -> Int
    a = screen_font_text_width(tr(MSG_V_ENCAJAR, "Snap at the edges"))
    b = screen_font_text_width(tr(MSG_V_MENU, "Window menu"))
    if b > a
        a = b
    end
    c = screen_font_text_width(tr(MSG_V_DOBLE_CLIC, "Double-click maximizes"))
    d = screen_font_text_width(tr(MSG_V_ALT_TAB, "Alt+Tab"))
    if d > c
        c = d
    end
    col = 26 + 8 + a + 16
    if m + col + 26 + 8 + c + m > ancho
        return 0
    end
    return col
end

# el alto de dentro de la ventana: el de la página más alta (el fondo o las ventanas, como las pone pagina) y los botones
func alto_ventana() -> Int
    fondo = m + fila + hueco + filas_s * fila + 4 + 8 * (fila + 2) + alto_boton
    ventanas = m + fila + hueco + 11 * (fila + 2) + 2 * fila + 4
    if v_columna() == 0
        ventanas = ventanas + 2 * fila
    end
    if ventanas > fondo
        fondo = ventanas
    end
    barra = m + fila + hueco + 10 * (fila + 2)
    if barra > fondo
        fondo = barra
    end
    return fondo + hueco * 2 + alto_boton + m
end

# las secciones marcadas del fondo, en el orden que tenían; las nuevas, detrás (cada gráfica bajo la suya)
func mostrar_texto() -> String
    var mostrar: [String] = []
    for s in antes
        if valores["VER_" + s] == "SI"
            mostrar.push(s)
        end
    end
    for c in claves
        if valores["VER_" + c] == "SI" and not esta(mostrar, c)
            madre = ""
            if c == "grafica_red"
                madre = "red"
            elif c == "grafica_memoria"
                madre = "memoria"
            end
            if madre != "" and esta(mostrar, madre)
                var con_g: [String] = []
                for k in mostrar
                    con_g.push(k)
                    if k == madre
                        con_g.push(c)
                    end
                end
                mostrar = con_g
            else
                mostrar.push(c)
            end
        end
    end
    texto = ""
    for s in mostrar
        if texto != ""
            texto = texto + ","
        end
        texto = texto + str_upper(s)
    end
    return texto
end

# el fichero de ajustes, con todo
func fichero() -> String
    n = Int(valores["TAREAS"])
    if n < 1
        n = 1
    elif n > 20
        n = 20
    end
    popup = "YES"
    if valores["OCULTO"] == "SI"
        popup = "NO"
    end
    # PREFS=2: escritas sabiendo de la fecha; 3, de la temperatura
    texto = "PREFS=3\nMOSTRAR=" + mostrar_texto() + "\nTAREAS=#{n}\nCX_POPKEY=" + valores["CX_POPKEY"] + "\nCX_POPUP=" + popup
    texto = texto + "\nBUSCAR=" + valores["BUSCAR"] + "\nSEGUNDOS=" + valores["SEGUNDOS"] + "\nCADA=" + valores["CADA"] + "\nFONDO=" + valores["FONDO"] + "\nPOSICION=" + valores["POSICION"] + "\nCOLOR=" + valores["COLOR"] + "\n"
    var mas: [String] = ["UNIDADES", "BARRA_ESTILO", "BARRA_PROFUNDIDAD", "BARRA_CIUDAD", "BARRA_LAT", "BARRA_LON", "BARRA_VER_FECHA", "BARRA_VER_TIEMPO", "BARRA_VER_CPU", "BARRA_VER_MEMORIA", "BARRA_VER_TEMPERATURA", "CAPTURA_TECLA", "CAPTURA_CARPETA", "DOCK_POSICION", "DOCK_ICONO", "DOCK_ESCONDER", "DOCK_HUECO", "DOCK_FONDO", "DOCK_COLOR", "TEMA", "TEMA_MODO", "TEMA_ESQUEMA", "TEMA_IMAGEN", "VENTANAS_HUECO", "VENTANAS_MOSAICO", "VENTANAS_TECLA_MAXIMIZAR", "VENTANAS_TECLA_IZQUIERDA", "VENTANAS_TECLA_DERECHA", "VENTANAS_TECLA_RESTAURAR", "VENTANAS_TECLA_MOSAICO", "VENTANAS_TECLA_AUTOMATICO", "VENTANAS_RATON_MOVER", "VENTANAS_RATON_TAMANO", "VENTANAS_ENCAJAR", "VENTANAS_DOBLE_CLIC", "VENTANAS_MENU", "VENTANAS_ALT_TAB", "VENTANAS_TECLA_MENU"]
    for k in mas
        texto = texto + k + "=" + valores[k] + "\n"
    end
    return texto
end

# ¿cambió algún ajuste que empieza así?
func cambio(prefijo: String) -> Bool
    for k in valores.keys()
        if str_starts(k, prefijo) and valores[k] != antes_v[k]
            return true
        end
    end
    return false
end

# los iconos de SYS:WBStartup como dice la sección Arranque (una pieza que se marca, además, arranca ya)
func poner_arranque()
    if cajon == ""
        return
    end
    var piezas: [String] = str_split(PIEZAS, "|")
    for p in piezas
        quiere = valores["ARR_" + p] == "SI"
        # solo las que se cambiaron: una pieza arrancada después de abrir las Prefs no se para por estar sin marcar
        if valores["ARR_" + p] == arr_antes["ARR_" + p]
            continue
        end
        if quiere
            if not en_arranque(p)
                file_copy(cajon + "Arranque/" + p + ".info", "SYS:WBStartup/" + p + ".info")
            end
            if not corriendo(p)
                arrancar(p)                  # y ya, sin esperar a reiniciar
            end
        else
            if en_arranque(p)
                file_delete("SYS:WBStartup/" + p + ".info")
            end
            if corriendo(p)
                parar(p)                     # y se apaga ya
            end
        end
    end
end

# los lanzadores del dock, en una página de esta ventana (Ferrán García: "hacerlo en un fichero de texto es tan
# siglo veinte"): una fila por programa (pulsarla la elige), Añadir con el selector de ficheros, Quitar, Subir y
# Bajar; Aceptar los deja en ENVARC: y ENV:Trasfondo.dock, y el dock arranca otra vez al Usar o Guardar
const FILAS_L = 8

func editar_lanzadores()
    t = file_read_text("ENVARC:Trasfondo.dock")
    if t == nil or str_trim(t) == ""
        t = file_read_text("ENV:Trasfondo.dock")
    end
    if t == nil or str_trim(t) == ""
        t = DOCK_DE_SERIE
    end
    var lista: [String] = []
    for l in str_split(str_replace(t, "\r", ""), "\n")
        if str_trim(l) != ""
            lista.push(str_trim(l))
        end
    end
    sel = 0
    arriba = 0
    while true
        gt_init()
        gfx_clear()
        y = m
        gt_text(m, y, ancho - m * 2, f + 6, "", tr(MSG_L_TITULO, "Dock launchers: click one to choose it"))
        y = y + fila + 2
        y_filas = y
        alto_f = f + 4
        var g_filas: [Int] = []
        i = 0
        while i < FILAS_L
            k = arriba + i
            texto = ""
            if k < lista.length
                texto = lista[k]
                if k == sel
                    texto = "> " + texto + " <"
                end
            end
            g_filas.push(gt_button(m, y, ancho - m * 2 - 30, alto_f, texto))
            y = y + alto_f + 1
            i = i + 1
        end
        g_arriba = gt_button(ancho - m - 26, y_filas, 26, alto_f, "^")
        g_abajo = gt_button(ancho - m - 26, y - alto_f - 1, 26, alto_f, "v")
        y = y + 4
        b4 = (ancho - m * 2 - 32) / 5
        g_anadir = gt_button(m, y, b4, alto_boton, tr(MSG_L_ANADIR, "Add..."))
        g_imagen = gt_button(m + b4 + 8, y, b4, alto_boton, tr(MSG_L_IMAGEN, "Picture..."))
        g_quitar = gt_button(m + (b4 + 8) * 2, y, b4, alto_boton, tr(MSG_L_QUITAR, "Remove"))
        g_subir = gt_button(m + (b4 + 8) * 3, y, b4, alto_boton, tr(MSG_L_SUBIR, "Up"))
        g_bajar = gt_button(m + (b4 + 8) * 4, y, b4, alto_boton, tr(MSG_L_BAJAR, "Down"))
        y = alto - m - alto_boton
        b2 = (ancho - m * 2 - 8) / 2
        g_aceptar = gt_button(m, y, b2, alto_boton, tr(MSG_L_ACEPTAR, "OK"))
        g_volver = gt_button(m + b2 + 8, y, b2, alto_boton, tr(MSG_CANCELAR, "Cancel"))
        gt_attach()
        e = -1
        while e == -1
            e = gt_event()
            if e == -1
                time_delay(5)
            end
        end
        if e == -2 or e == g_volver
            return
        elif e == g_aceptar
            texto = ""
            for l in lista
                texto = texto + l + "\n"
            end
            file_write_text("ENVARC:Trasfondo.dock", texto)
            file_write_text("ENV:Trasfondo.dock", texto)
            dock_editado = true
            return
        elif e == g_anadir
            if file_open_dialog(tr(MSG_L_ELEGIR, "Choose a program for the dock"), "")
                r = file_fullpath()
                if r != ""
                    if lista.length == 0
                        lista.push(r)
                        sel = 0
                    else
                        lista.insert(sel + 1, r)
                        sel = sel + 1
                    end
                end
            end
        elif e == g_imagen and sel < lista.length   # ruta|imagen: una imagen PNG propia para el dock
            if file_open_dialog(tr(MSG_L_ELEGIR_IMAGEN, "Choose a picture (PNG) for this launcher"), "#?.png")
                r = file_fullpath()
                if r != ""
                    ruta = lista[sel]
                    barra = str_find(ruta, "|")
                    if barra > 0
                        ruta = ruta[0:barra]
                    end
                    lista[sel] = ruta + "|" + r
                end
            end
        elif e == g_quitar and sel < lista.length
            lista.remove(sel)
            if sel >= lista.length and sel > 0
                sel = lista.length - 1
            end
        elif e == g_subir and sel > 0 and sel < lista.length
            a = lista[sel - 1]
            lista[sel - 1] = lista[sel]
            lista[sel] = a
            sel = sel - 1
        elif e == g_bajar and sel + 1 < lista.length
            a = lista[sel + 1]
            lista[sel + 1] = lista[sel]
            lista[sel] = a
            sel = sel + 1
        elif e == g_arriba and arriba > 0
            arriba = arriba - 1
        elif e == g_abajo and arriba + FILAS_L < lista.length
            arriba = arriba + 1
        else
            i = 0
            while i < FILAS_L
                if e == g_filas[i] and arriba + i < lista.length
                    sel = arriba + i
                end
                i = i + 1
            end
        end
        if sel < arriba                  # la elegida, a la vista
            arriba = sel
        elif sel >= arriba + FILAS_L
            arriba = sel - FILAS_L + 1
        end
    end
end

Main
    cajon = ""
    t_cajon = file_read_text("ENV:Trasfondo.cajon")
    if t_cajon != nil
        cajon = str_trim(str_replace(t_cajon, "\n", ""))
        if cajon != "" and not str_ends(cajon, ":") and not str_ends(cajon, "/")
            cajon = cajon + "/"
        end
    end

    # TrasfondoPrefs ARRANCAR: las piezas que arrancan con el Workbench, ya (el instalador)
    if arg_count() > 0 and str_upper(arg(0)) == "ARRANCAR"
        var piezas_a: [String] = str_split(PIEZAS, "|")
        for p in piezas_a
            if en_arranque(p)
                arrancar(p)
            end
        end
        return
    end

    prefs = file_read_text("ENV:Trasfondo.prefs")
    if prefs == nil
        prefs = file_read_text("ENVARC:Trasfondo.prefs")
    end
    if prefs == nil
        prefs = ""
    end
    antes = secciones_de(conf("MOSTRAR", SECCIONES))
    # unas de antes de la 0.7 (sin PREFS=) no conocían la fecha: sale marcada, arriba, como en Trasfondo
    if conf("MOSTRAR", "") != "" and conf("PREFS", "") == "" and not esta(antes, "fecha")
        var con_fecha: [String] = ["fecha"]
        for s in antes
            con_fecha.push(s)
        end
        antes = con_fecha
    end
    # y las de antes de la 0.11 (PREFS menor que 3) no conocían la temperatura: marcada, tras la CPU, como en Trasfondo
    if Int(conf("PREFS", "0")) < 3 and not esta(antes, "temperatura")
        var con_temp: [String] = []
        for s in antes
            con_temp.push(s)
            if s == "cpu"
                con_temp.push("temperatura")
            end
        end
        if con_temp.length == antes.length
            con_temp.push("temperatura")
        end
        antes = con_temp
    end
    for c in claves
        valores["VER_" + c] = si(esta(antes, c))
    end
    valores["TAREAS"] = conf("TAREAS", "6")
    valores["OCULTO"] = si(str_upper(conf("CX_POPUP", "YES")) == "NO")
    valores["CX_POPKEY"] = conf("CX_POPKEY", "")
    valores["UNIDADES"] = conf("UNIDADES", "")
    cada = Int(conf("CADA", "2"))
    valores["CADA"] = "1"
    for s in [2, 5, 10]
        if s <= cada
            valores["CADA"] = "#{s}"
        end
    end
    valores["FONDO"] = "VELO"
    f_puesto = str_upper(conf("FONDO", "VELO"))
    if f_puesto == "FIJO" or f_puesto == "SOLID"
        valores["FONDO"] = "FIJO"
    end
    valores["COLOR"] = str_replace(conf("COLOR", "16,24,32"), " ", "")
    valores["POSICION"] = str_upper(conf("POSICION", "ARRIBA_DERECHA"))
    valores["BUSCAR"] = si(str_upper(conf("BUSCAR", "SI")) != "NO")
    valores["SEGUNDOS"] = si(str_upper(conf("SEGUNDOS", "NO")) == "SI")
    valores["BARRA_ESTILO"] = str_upper(conf("BARRA_ESTILO", "COMPLETA"))
    valores["BARRA_PROFUNDIDAD"] = str_upper(conf("BARRA_PROFUNDIDAD", "DETRAS"))
    valores["BARRA_CIUDAD"] = conf("BARRA_CIUDAD", "")
    valores["BARRA_LAT"] = conf("BARRA_LAT", "")
    valores["BARRA_LON"] = conf("BARRA_LON", "")
    valores["CAPTURA_TECLA"] = conf("CAPTURA_TECLA", "ctrl lalt s")
    valores["CAPTURA_CARPETA"] = conf("CAPTURA_CARPETA", "RAM:")
    for k in ["FECHA", "TIEMPO", "CPU", "MEMORIA", "TEMPERATURA"]
        valores["BARRA_VER_" + k] = si(str_upper(conf("BARRA_VER_" + k, "SI")) != "NO")
    end
    valores["DOCK_POSICION"] = str_upper(conf("DOCK_POSICION", "ABAJO"))
    valores["DOCK_ICONO"] = conf("DOCK_ICONO", "40")
    valores["DOCK_ESCONDER"] = si(str_upper(conf("DOCK_ESCONDER", "NO")) == "SI")
    valores["DOCK_HUECO"] = conf("DOCK_HUECO", "4")
    valores["DOCK_FONDO"] = str_upper(conf("DOCK_FONDO", "TEMA"))
    valores["DOCK_COLOR"] = str_replace(conf("DOCK_COLOR", "27,30,35"), " ", "")
    valores["TEMA"] = str_upper(conf("TEMA", "FIJO"))
    valores["TEMA_MODO"] = str_upper(conf("TEMA_MODO", "OSCURO"))
    valores["TEMA_ESQUEMA"] = str_upper(conf("TEMA_ESQUEMA", "FONDO"))
    valores["TEMA_IMAGEN"] = conf("TEMA_IMAGEN", "")
    valores["VENTANAS_HUECO"] = conf("VENTANAS_HUECO", "4")
    valores["VENTANAS_MOSAICO"] = si(str_upper(conf("VENTANAS_MOSAICO", "NO")) == "SI")
    valores["VENTANAS_TECLA_MAXIMIZAR"] = conf("VENTANAS_TECLA_MAXIMIZAR", "ctrl alt up")
    valores["VENTANAS_TECLA_IZQUIERDA"] = conf("VENTANAS_TECLA_IZQUIERDA", "ctrl alt left")
    valores["VENTANAS_TECLA_DERECHA"] = conf("VENTANAS_TECLA_DERECHA", "ctrl alt right")
    valores["VENTANAS_TECLA_RESTAURAR"] = conf("VENTANAS_TECLA_RESTAURAR", "ctrl alt down")
    valores["VENTANAS_TECLA_MOSAICO"] = conf("VENTANAS_TECLA_MOSAICO", "ctrl alt t")
    valores["VENTANAS_TECLA_AUTOMATICO"] = conf("VENTANAS_TECLA_AUTOMATICO", "ctrl alt a")
    valores["VENTANAS_RATON_MOVER"] = conf("VENTANAS_RATON_MOVER", "rawmouse lalt mouse_leftpress")
    valores["VENTANAS_RATON_TAMANO"] = conf("VENTANAS_RATON_TAMANO", "rawmouse lalt mouse_rightpress")
    valores["VENTANAS_ENCAJAR"] = si(str_upper(conf("VENTANAS_ENCAJAR", "SI")) != "NO")
    valores["VENTANAS_DOBLE_CLIC"] = si(str_upper(conf("VENTANAS_DOBLE_CLIC", "SI")) != "NO")
    valores["VENTANAS_MENU"] = si(str_upper(conf("VENTANAS_MENU", "SI")) != "NO")
    valores["VENTANAS_ALT_TAB"] = si(str_upper(conf("VENTANAS_ALT_TAB", "SI")) != "NO")
    valores["VENTANAS_TECLA_MENU"] = conf("VENTANAS_TECLA_MENU", "ctrl alt space")
    var piezas: [String] = str_split(PIEZAS, "|")
    for p in piezas
        valores["ARR_" + p] = si(en_arranque(p) or corriendo(p))   # marcada: en marcha (y al arrancar)
        arr_antes["ARR_" + p] = valores["ARR_" + p]
    end
    for k in valores.keys()
        antes_v[k] = valores[k]
    end

    # medido con la fuente de la pantalla, la que usan los gadgets (en Coffin, más grande que la Topaz 8)
    f = screen_font_height()
    fila = f + 8
    if fila < 16
        fila = 16
    end
    alto_boton = f + 6
    # el ancho de las etiquetas de la izquierda: el de la más larga de todas las páginas
    var izquierdas: [String] = [tr(MSG_SECCION, "Section"), tr(MSG_CUANTAS, "Tasks shown"), tr(MSG_TECLA, "Hotkey"), tr(MSG_UNIDADES, "Disks shown"), tr(MSG_CADA, "Measure every"), tr(MSG_FONDO, "Background"), tr(MSG_COLOR, "Colour"), tr(MSG_ESTILO, "Style"), tr(MSG_PROFUNDIDAD, "Depth"), tr(MSG_CIUDAD, "City"), tr(MSG_LAT, "Latitude"), tr(MSG_LON, "Longitude"), tr(MSG_POSICION, "Position"), tr(MSG_TAMANO_ICONO, "Icon size"), tr(MSG_HUECO, "Gap"), tr(MSG_D_COLOR, "Colour (R,G,B)"), tr(MSG_T_MAXIMIZAR, "Maximize"), tr(MSG_T_IZQUIERDA, "Left half"), tr(MSG_T_DERECHA, "Right half"), tr(MSG_T_RESTAURAR, "Restore"), tr(MSG_T_MOSAICO, "Tile"), tr(MSG_T_AUTOMATICO, "Auto tile"), tr(MSG_T_MOVER, "Move"), tr(MSG_T_TAMANO, "Resize")]
    for t in izquierdas
        if x_campo < m + screen_font_text_width(t) + 10
            x_campo = m + screen_font_text_width(t) + 10
        end
    end
    # lo que va a la derecha de una casilla: el más largo
    var derechas: [String] = [tr(MSG_BUSCAR, "Look for new versions on GitHub"), tr(MSG_ARR_FONDO, "The background: on, and with the Workbench"), tr(MSG_ARR_BARRA, "The bar: on, and with the Workbench"), tr(MSG_ARR_DOCK, "The dock: on, and with the Workbench"), tr(MSG_ARR_VENTANAS, "The window keys: on, and with the Workbench"), tr(MSG_SIN_CAJON, "Install Trasfondo with its installer to choose this"), tr(MSG_RTG, "The bar, the dock and their panels need an RTG screen")]
    largo = 0
    for t in derechas
        if largo < screen_font_text_width(t)
            largo = screen_font_text_width(t)
        end
    end
    var etiquetas_s: [String] = [tr(MSG_VER_FECHA, "Show the date and time"), tr(MSG_VER_CPU, "Show the CPU graph"), tr(MSG_VER_TEMP, "Show the Pi temperature"), tr(MSG_VER_MEMORIA, "Show the free memory"), tr(MSG_VER_GMEM, "Show the memory graph"), tr(MSG_VER_TAREAS, "Show the tasks"), tr(MSG_VER_DISCOS, "Show the disks"), tr(MSG_VER_RED, "Show the network and WiFi"), tr(MSG_VER_GRED, "Show the network graph"), tr(MSG_SEGUNDOS, "Show the seconds")]
    largo_s = 0                                                 # las secciones del fondo, en dos columnas
    for t in etiquetas_s
        if largo_s < screen_font_text_width(t)
            largo_s = screen_font_text_width(t)
        end
    end
    filas_s = (claves.length + 2) / 2                           # (+1: los segundos van en la rejilla)
    columna = 26 + 8 + largo_s + 12
    if m * 2 + columna * 2 > screen_width() - 8
        filas_s = claves.length + 1                             # no caben dos: una
        columna = 0
    end
    ancho = m + 26 + 8 + largo + m
    t_oculto = tr(MSG_OCULTO, "Start hidden")
    t_mosaico = tr(MSG_MOSAICO, "Tile new windows automatically")
    t_esconder = tr(MSG_ESCONDER, "Hide it until the mouse reaches its edge")
    for t in [t_oculto, t_mosaico, t_esconder]
        if ancho < x_campo + screen_font_text_width("000") + 24 + 16 + 26 + 8 + screen_font_text_width(t) + m
            ancho = x_campo + screen_font_text_width("000") + 24 + 16 + 26 + 8 + screen_font_text_width(t) + m
        end
    end
    if ancho < m * 2 + columna + 26 + 8 + largo_s
        ancho = m * 2 + columna + 26 + 8 + largo_s
    end
    if ancho < x_campo + 220
        ancho = x_campo + 220
    end
    if ancho > screen_width() - 8
        ancho = screen_width() - 8
    end
    alto = alto_ventana()
    # en una pantalla baja (640x256 con una fuente grande) no cabe: todo más junto. El borde de arriba es el
    # título, con la fuente de la pantalla
    cabe = screen_height() - (f + 3) - 4
    if alto > cabe
        fila = f + 4
        if fila < 12
            fila = 12
        end
        hueco = 4
        m = 6
        alto = alto_ventana()
    end
    izquierda = 60                           # y la ventana, más a la izquierda y más arriba si hace falta
    if izquierda + ancho + 8 > screen_width()
        izquierda = screen_width() - ancho - 8
        if izquierda < 0
            izquierda = 0
        end
    end
    arriba = 30
    if arriba + alto + f + 3 + 4 > screen_height()
        arriba = screen_height() - alto - f - 3 - 4
        if arriba < 0
            arriba = 0
        end
    end

    # la versión: la que hay, o la nueva que encontró Trasfondo (ENV:Trasfondo.nueva)
    yo = str_replace(program_version(), "TrasfondoPrefs ", "")
    hay_nueva = file_read_text("ENV:Trasfondo.nueva")
    linea_version = con(tr(MSG_TIENES, "You have %s"), yo)
    if hay_nueva != nil and str_trim(hay_nueva) != ""
        linea_version = con(tr(MSG_HAY_NUEVA, "There is a new version: %s"), str_trim(hay_nueva))
    end
    # flag 8: ancho y alto son el interior, que es desde donde cuentan los gadgets (la ventana es GimmeZeroZero)
    if window_create(tr(MSG_TITULO, "Trasfondo Preferences"), izquierda, arriba, ancho, alto, 8) == 0
        Print tr(MSG_SIN_VENTANA, "TrasfondoPrefs: cannot open the window")
        return
    end
    # recién actualizado: esta es la versión nueva, que abrió la vieja; en la sección que tenía y con lo que pasó
    t_vuelta = file_read_text("ENV:Trasfondo.prefs_seccion")
    vuelta = t_vuelta != nil and str_trim(t_vuelta) != ""
    if vuelta
        file_delete("ENV:Trasfondo.prefs_seccion")
        est_antes = file_read_text("ENV:Trasfondo.estado")
        if est_antes != nil and str_trim(est_antes) != ""
            linea_version = str_trim(est_antes)
        end
        pagina(Int(str_trim(t_vuelta)), linea_version)
    else
        pagina(0, linea_version)
    end

    ultimo = ""
    pedido = 0                               # time_ms de cuando se pidió actualizar (0: no se ha pedido)
    file_delete("ENV:Trasfondo.instalada")
    while true
        e = gt_event()
        if e == -1                           # nada: mira cómo va lo que se pidió a Trasfondo
            time_delay(10)
            if pedido != 0 and g_estado >= 0
                est = file_read_text("ENV:Trasfondo.estado")
                if est != nil and str_trim(est) != "" and str_trim(est) != ultimo
                    ultimo = str_trim(est)
                    gt_set_text(g_estado, ultimo)
                    pedido = time_ms()
                elif ultimo == "" and time_ms() - pedido > 8000
                    ultimo = tr(MSG_NO_ESTA, "Trasfondo is not running: start it and try again")
                    gt_set_text(g_estado, ultimo)
                end
                # instalada: estas Prefs son las viejas (no verían lo nuevo); se abren otra vez, ya las nuevas
                if file_exists("ENV:Trasfondo.instalada")
                    file_delete("ENV:Trasfondo.instalada")
                    time_delay(100)
                    file_write_text("ENV:Trasfondo.prefs_seccion", "#{seccion}\n")
                    program_relaunch()
                    break
                end
            end
        elif e == g_seccion
            nueva = gt_get_value(g_seccion)
            if nueva != seccion
                recoger()
                pagina(nueva, linea_version)
            end
        elif e == g_actualizar and g_actualizar >= 0
            file_delete("ENV:Trasfondo.estado")
            file_write_text("ENV:Trasfondo.orden", "actualizar\n")
            gt_set_text(g_estado, tr(MSG_PEDIDO, "Asked Trasfondo..."))
            ultimo = ""
            pedido = time_ms()
        elif e == g_lanzadores and g_lanzadores >= 0
            recoger()                        # (lo de la página, que se pinta otra vez al volver)
            editar_lanzadores()
            pagina(seccion, linea_version)
        elif seccion == 4 and de_la_pagina(e)
            recoger()                        # (las muestras, al momento)
            muestras()
        elif e == -2 or e == g_cancelar
            break
        elif e == g_guardar or e == g_usar
            recoger()
            texto = fichero()
            file_write_text("ENV:Trasfondo.prefs", texto)
            if e == g_guardar
                file_write_text("ENVARC:Trasfondo.prefs", texto)
            end
            poner_arranque()
            # las piezas en marcha cuyos ajustes cambiaron, otra vez (el fondo los lee él solo)
            if cambio("BARRA_")
                rearrancar("TrasfondoBarra")
            end
            if cambio("DOCK_") or dock_editado
                rearrancar("TrasfondoDock")
            end
            if cambio("VENTANAS_")
                rearrancar("TrasfondoVentanas")
            end
            if cambio("TEMA")
                escribir_tema(e == g_guardar)
                rearrancar("TrasfondoBarra")    # (sus paneles, los ajustes rápidos y los avisos, al abrirlos)
                rearrancar("TrasfondoDock")
            elif e == g_guardar and valores["TEMA"] == "FONDO"
                escribir_tema(true)             # (lo de Usar, también a ENVARC:)
            end
            break
        end
    end
    gt_cleanup()
end
