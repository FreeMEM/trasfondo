# TrasfondoPrefs: las preferencias de Trasfondo en una ventana, como las de SYS:Prefs. Qué secciones se ven,
# cuántas tareas, la tecla rápida, cada cuánto mide, el fondo (con velo o fijo) y su color, y si arranca oculto. Usar las deja en ENV:Trasfondo.prefs (hasta
# reiniciar); Guardar, también en ENVARC:. Trasfondo, si está en marcha, las nota en un segundo.
# Lo que no está en ese fichero lo siguen diciendo los tooltypes del icono de Trasfondo.

@workbench_output "NIL:"
@version "TrasfondoPrefs 0.11"
@catalog "Trasfondo.catalog" 1       # el mismo que Trasfondo: los textos, en inglés; el castellano, en el catálogo

import "textos.dash"

const SECCIONES = "fecha,cpu,temperatura,memoria,tareas,discos,red"
const COLORES = "16,24,32|0,0,0|48,48,48|16,40,96|16,56,32|72,16,24|48,24,72"   # los de MSG_COLORES, en su orden

var prefs: String = ""

# un ajuste de las preferencias (NOMBRE=valor), o el defecto
func conf(nombre: String, defecto: String) -> String
    var lineas: [String] = str_split(str_replace(prefs, "\r", ""), "\n")
    for i in (0..lineas.length - 1)
        l = str_trim(lineas[i])
        igual = str_find(l, "=")
        if igual > 0 and str_upper(str_trim(l[0:igual])) == nombre
            return str_trim(l[igual + 1:l.length])
        end
    end
    return defecto
end

# las secciones de MOSTRAR, en su orden y con los nombres de Trasfondo (también acepta los ingleses)
func secciones_de(texto: String) -> [String]
    var r: [String] = []
    var nombres: [String] = str_split(str_replace(str_lower(texto), ",", " "), " ")
    for i in (0..nombres.length - 1)
        s = str_trim(nombres[i])
        if s == "memory" or s == "mem"
            s = "memoria"
        elif s == "tasks"
            s = "tareas"
        elif s == "disks"
            s = "discos"
        elif s == "net" or s == "network" or s == "wifi"
            s = "red"
        elif s == "date" or s == "time" or s == "clock" or s == "hora" or s == "reloj"
            s = "fecha"
        elif s == "temp" or s == "temperature" or s == "pistorm"
            s = "temperatura"
        elif s == "netgraph" or s == "graficared"
            s = "grafica_red"
        elif s == "memgraph" or s == "graficamemoria"
            s = "grafica_memoria"
        end
        if s == "fecha" or s == "cpu" or s == "temperatura" or s == "memoria" or s == "grafica_memoria" or s == "tareas" or s == "discos" or s == "red" or s == "grafica_red"
            r.push(s)
        end
    end
    return r
end

func esta(lista: [String], s: String) -> Bool
    for i in (0..lista.length - 1)
        if lista[i] == s
            return true
        end
    end
    return false
end

Main
    prefs = file_read_text("ENV:Trasfondo.prefs")
    if prefs == nil
        prefs = file_read_text("ENVARC:Trasfondo.prefs")
    end
    if prefs == nil
        prefs = ""
    end
    var antes: [String] = secciones_de(conf("MOSTRAR", SECCIONES))
    # unas de antes de la 0.7 (sin PREFS=) no conocían la fecha: sale marcada, arriba, como en Trasfondo
    if conf("MOSTRAR", "") != "" and conf("PREFS", "") == "" and not esta(antes, "fecha")
        var con_fecha: [String] = ["fecha"]
        for i in (0..antes.length - 1)
            con_fecha.push(antes[i])
        end
        antes = con_fecha
    end
    # y las de antes de la 0.11 (PREFS menor que 3) no conocían la temperatura: marcada, tras la CPU, como en Trasfondo
    if Int(conf("PREFS", "0")) < 3 and not esta(antes, "temperatura")
        var con_temp: [String] = []
        for i in (0..antes.length - 1)
            con_temp.push(antes[i])
            if antes[i] == "cpu"
                con_temp.push("temperatura")
            end
        end
        if con_temp.length == antes.length
            con_temp.push("temperatura")
        end
        antes = con_temp
    end

    # medido con la fuente de la pantalla, la que usan los gadgets (en Coffin, más grande que la Topaz 8)
    f = screen_font_height()
    fila = f + 8
    if fila < 16
        fila = 16
    end
    m = 12                                   # el margen, por dentro de los bordes
    var etiquetas: [String] = [tr(MSG_VER_FECHA, "Show the date and time"), tr(MSG_VER_CPU, "Show the CPU graph"), tr(MSG_VER_TEMP, "Show the Pi temperature"), tr(MSG_VER_MEMORIA, "Show the free memory"), tr(MSG_VER_GMEM, "Show the memory graph"), tr(MSG_VER_TAREAS, "Show the tasks"), tr(MSG_VER_DISCOS, "Show the disks"), tr(MSG_VER_RED, "Show the network and WiFi"), tr(MSG_VER_GRED, "Show the network graph")]
    t_cuantas = tr(MSG_CUANTAS, "Tasks shown")
    t_tecla = tr(MSG_TECLA, "Hotkey")
    t_cada = tr(MSG_CADA, "Measure every")
    t_fondo = tr(MSG_FONDO, "Background")
    t_color = tr(MSG_COLOR, "Colour")
    t_oculto = tr(MSG_OCULTO, "Start hidden")
    t_buscar = tr(MSG_BUSCAR, "Look for new versions on GitHub")
    t_actualizar = tr(MSG_ACTUALIZAR, "Update")
    x_campo = 0                                                 # los campos, con su texto a la izquierda
    var campos: [String] = [t_cuantas, t_tecla, t_cada, t_fondo, t_color]
    for i in (0..campos.length - 1)
        if x_campo < m + screen_font_text_width(campos[i]) + 10
            x_campo = m + screen_font_text_width(campos[i]) + 10
        end
    end
    largo = screen_font_text_width(t_buscar)                    # las casillas, con el texto a la derecha
    if largo < screen_font_text_width(t_oculto)
        largo = screen_font_text_width(t_oculto)
    end
    largo_s = 0                                                 # las de las secciones, en dos columnas
    for i in (0..etiquetas.length - 1)
        if largo_s < screen_font_text_width(etiquetas[i])
            largo_s = screen_font_text_width(etiquetas[i])
        end
    end
    filas_s = (etiquetas.length + 1) / 2
    columna = 26 + 8 + largo_s + 12          # dónde empieza la segunda
    if m * 2 + columna * 2 > screen_width() - 8
        filas_s = etiquetas.length           # no caben dos: una
        columna = 0
    end
    ancho = m + 26 + 8 + largo + m
    if ancho < x_campo + screen_font_text_width("000") + 24 + 16 + 26 + 8 + screen_font_text_width(t_oculto) + m
        ancho = x_campo + screen_font_text_width("000") + 24 + 16 + 26 + 8 + screen_font_text_width(t_oculto) + m
    end
    if ancho < m * 2 + columna + 26 + 8 + largo_s
        ancho = m * 2 + columna + 26 + 8 + largo_s
    end
    if ancho < x_campo + 200
        ancho = x_campo + 200
    end
    alto_boton = f + 6
    hueco = 8                                # lo que separa los grupos (el doble, antes de los botones)
    alto = m * 2 + fila * (filas_s + 6) + 4 + 10 + hueco * 3 + alto_boton * 2
    # en una pantalla baja (640x256 con una fuente grande) no cabe: todo más junto. El borde de arriba es el
    # título, con la fuente de la pantalla
    cabe = screen_height() - (f + 3) - 4
    if alto > cabe
        fila = f + 4
        if fila < 12
            fila = 12
        end
        hueco = 4
        m = 6
        alto = m * 2 + fila * (filas_s + 6) + 4 + 10 + hueco * 3 + alto_boton * 2
    end
    izquierda = 60                           # y la ventana, más a la izquierda y más arriba si hace falta
    if izquierda + ancho + 8 > screen_width()
        izquierda = screen_width() - ancho - 8
        if izquierda < 0
            izquierda = 0
        end
    end
    arriba = 30
    if arriba + alto + f + 3 + 4 > screen_height()
        arriba = screen_height() - alto - f - 3 - 4
        if arriba < 0
            arriba = 0
        end
    end

    # la versión: la que hay, o la nueva que encontró Trasfondo (ENV:Trasfondo.nueva)
    yo = str_replace(program_version(), "TrasfondoPrefs ", "")
    hay_nueva = file_read_text("ENV:Trasfondo.nueva")
    linea_version = con(tr(MSG_TIENES, "You have %s"), yo)
    if hay_nueva != nil and str_trim(hay_nueva) != ""
        linea_version = con(tr(MSG_HAY_NUEVA, "There is a new version: %s"), str_trim(hay_nueva))
    end
    # flag 8: ancho y alto son el interior, que es desde donde cuentan los gadgets (la ventana es GimmeZeroZero)
    if window_create(tr(MSG_TITULO, "Trasfondo Preferences"), izquierda, arriba, ancho, alto, 8) == 0
        Print tr(MSG_SIN_VENTANA, "TrasfondoPrefs: cannot open the window")
    else
        gt_init()
        y = m
        x = m
        var claves: [String] = ["fecha", "cpu", "temperatura", "memoria", "grafica_memoria", "tareas", "discos", "red", "grafica_red"]
        var casillas: [Int] = []
        for i in (0..claves.length - 1)
            x_s = x
            if i >= filas_s
                x_s = x + columna
            end
            casillas.push(gt_checkbox(x_s, y + (i % filas_s) * fila, 26, f + 3, etiquetas[i], esta(antes, claves[i])))
        end
        y = y + filas_s * fila
        y = y + 4
        ancho_n = screen_font_text_width("000") + 24
        tareas = gt_integer(x_campo, y, ancho_n, f + 6, t_cuantas, Int(conf("TAREAS", "6")))
        # arrancar oculto, en la misma fila (en una pantalla de 640x256 no sobra ni una)
        oculto = gt_checkbox(x_campo + ancho_n + 16, y + 1, 26, f + 3, t_oculto, str_upper(conf("CX_POPUP", "YES")) == "NO")
        y = y + fila + 2
        tecla = gt_string(x_campo, y, ancho - x_campo - m, f + 6, t_tecla, conf("CX_POPKEY", ""), 40)
        y = y + fila + 2
        var segundos: [Int] = [1, 2, 5, 10]
        medir = gt_cycle(x_campo, y, ancho - x_campo - m, f + 6, t_cada, "1 s|2 s|5 s|10 s")
        y = y + fila + 2
        fondo = gt_cycle(x_campo, y, ancho - x_campo - m, f + 6, t_fondo, tr(MSG_FONDOS, "See-through|Solid"))
        y = y + fila + 2
        # los colores de la lista; uno puesto a mano (tooltype o prefs) sale al final, para no perderlo
        var rgb: [String] = str_split(COLORES, "|")
        nombres = tr(MSG_COLORES, "Night blue|Black|Grey|Blue|Green|Wine|Purple")
        puesto = str_replace(conf("COLOR", rgb[0]), " ", "")
        n_color = -1
        for i in (0..rgb.length - 1)
            if rgb[i] == puesto
                n_color = i
            end
        end
        if n_color < 0
            n_color = rgb.length
            rgb.push(puesto)
            nombres = nombres + "|" + con(tr(MSG_OTRO, "Other (%s)"), puesto)
        end
        g_color = gt_cycle(x_campo, y, ancho - x_campo - m, f + 6, t_color, nombres)
        y = y + fila + 2
        buscar = gt_checkbox(x, y, 26, f + 3, t_buscar, str_upper(conf("BUSCAR", "SI")) != "NO")
        y = y + fila + hueco
        ancho_act = screen_font_text_width(t_actualizar) + 24
        estado = gt_text(x, y, ancho - m * 2 - ancho_act - 8, alto_boton, "", linea_version)
        actualizar = gt_button(ancho - m - ancho_act, y, ancho_act, alto_boton, t_actualizar)
        y = y + alto_boton + hueco * 2
        boton = (ancho - m * 2 - 16) / 3
        guardar = gt_button(x, y, boton, alto_boton, tr(MSG_GUARDAR, "Save"))
        usar = gt_button(x + boton + 8, y, boton, alto_boton, tr(MSG_USAR, "Use"))
        cancelar = gt_button(x + (boton + 8) * 2, y, boton, alto_boton, tr(MSG_CANCELAR, "Cancel"))
        gt_attach()
        cada = Int(conf("CADA", "2"))
        n_cada = 0
        for i in (0..segundos.length - 1)
            if segundos[i] <= cada
                n_cada = i
            end
        end
        gt_set_value(medir, n_cada)
        f_puesto = str_upper(conf("FONDO", "VELO"))
        if f_puesto == "FIJO" or f_puesto == "SOLID"
            gt_set_value(fondo, 1)
        end
        gt_set_value(g_color, n_color)

        ultimo = ""
        pedido = 0                           # time_ms de cuando se pidió actualizar (0: no se ha pedido)
        while true
            e = gt_event()
            if e == -1                       # nada: mira cómo va lo que se pidió a Trasfondo
                time_delay(10)
                if pedido != 0
                    est = file_read_text("ENV:Trasfondo.estado")
                    if est != nil and str_trim(est) != "" and str_trim(est) != ultimo
                        ultimo = str_trim(est)
                        gt_set_text(estado, ultimo)
                        pedido = time_ms()
                    elif ultimo == "" and time_ms() - pedido > 8000
                        ultimo = tr(MSG_NO_ESTA, "Trasfondo is not running: start it and try again")
                        gt_set_text(estado, ultimo)
                    end
                end
            elif e == actualizar
                file_delete("ENV:Trasfondo.estado")
                file_write_text("ENV:Trasfondo.orden", "actualizar\n")
                gt_set_text(estado, tr(MSG_PEDIDO, "Asked Trasfondo..."))
                ultimo = ""
                pedido = time_ms()
            elif e == -2 or e == cancelar
                break
            elif e == guardar or e == usar
                # las marcadas, en el orden que tenían; las nuevas, detrás
                var mostrar: [String] = []
                for i in (0..antes.length - 1)
                    for j in (0..claves.length - 1)
                        if claves[j] == antes[i] and gt_get_value(casillas[j]) != 0
                            mostrar.push(antes[i])
                        end
                    end
                end
                for j in (0..claves.length - 1)
                    if gt_get_value(casillas[j]) != 0 and not esta(mostrar, claves[j])
                        # cada gráfica, debajo de su sección si está
                        madre = ""
                        if claves[j] == "grafica_red"
                            madre = "red"
                        elif claves[j] == "grafica_memoria"
                            madre = "memoria"
                        end
                        if madre != "" and esta(mostrar, madre)
                            var con_g: [String] = []
                            for k in (0..mostrar.length - 1)
                                con_g.push(mostrar[k])
                                if mostrar[k] == madre
                                    con_g.push(claves[j])
                                end
                            end
                            mostrar = con_g
                        else
                            mostrar.push(claves[j])
                        end
                    end
                end
                n = gt_get_value(tareas)
                if n < 1
                    n = 1
                elif n > 20
                    n = 20
                end
                texto = "PREFS=3\nMOSTRAR="     # PREFS=2: escritas sabiendo de la fecha; 3, de la temperatura
                for i in (0..mostrar.length - 1)
                    if i > 0
                        texto = texto + ","
                    end
                    texto = texto + str_upper(mostrar[i])
                end
                popup = "YES"
                if gt_get_value(oculto) != 0
                    popup = "NO"
                end
                busca = "SI"
                if gt_get_value(buscar) == 0
                    busca = "NO"
                end
                capa = "VELO"
                if gt_get_value(fondo) == 1
                    capa = "FIJO"
                end
                texto = texto + "\nTAREAS=#{n}\nCX_POPKEY=" + str_trim(gt_get_string(tecla)) + "\nCX_POPUP=" + popup + "\nBUSCAR=" + busca
                s_cada = segundos[gt_get_value(medir)]
                texto = texto + "\nCADA=#{s_cada}\nFONDO=" + capa + "\nCOLOR=" + rgb[gt_get_value(g_color)] + "\n"
                file_write_text("ENV:Trasfondo.prefs", texto)
                if e == guardar
                    file_write_text("ENVARC:Trasfondo.prefs", texto)
                end
                break
            end
        end
        gt_cleanup()
    end
end
