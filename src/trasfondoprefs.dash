# TrasfondoPrefs: las preferencias de Trasfondo en una ventana, como las de SYS:Prefs. Qué secciones se ven,
# cuántas tareas, la tecla rápida y si arranca oculto. Usar las deja en ENV:Trasfondo.prefs (hasta
# reiniciar); Guardar, también en ENVARC:. Trasfondo, si está en marcha, las nota en un segundo.
# Lo que no está en ese fichero lo siguen diciendo los tooltypes del icono de Trasfondo.

@workbench_output "NIL:"
@version "TrasfondoPrefs 0.9.2"
@catalog "Trasfondo.catalog" 1       # el mismo que Trasfondo: los textos, en inglés; el castellano, en el catálogo

import "textos.dash"

const SECCIONES = "fecha,cpu,memoria,tareas,discos,red"

var prefs: String = ""

# un ajuste de las preferencias (NOMBRE=valor), o el defecto
func conf(nombre: String, defecto: String) -> String
    var lineas: [String] = str_split(str_replace(prefs, "\r", ""), "\n")
    for i in (0..lineas.length - 1)
        l = str_trim(lineas[i])
        igual = str_find(l, "=")
        if igual > 0 and str_upper(str_trim(l[0:igual])) == nombre
            return str_trim(l[igual + 1:l.length])
        end
    end
    return defecto
end

# las secciones de MOSTRAR, en su orden y con los nombres de Trasfondo (también acepta los ingleses)
func secciones_de(texto: String) -> [String]
    var r: [String] = []
    var nombres: [String] = str_split(str_replace(str_lower(texto), ",", " "), " ")
    for i in (0..nombres.length - 1)
        s = str_trim(nombres[i])
        if s == "memory" or s == "mem"
            s = "memoria"
        elif s == "tasks"
            s = "tareas"
        elif s == "disks"
            s = "discos"
        elif s == "net" or s == "network" or s == "wifi"
            s = "red"
        elif s == "date" or s == "time" or s == "clock" or s == "hora" or s == "reloj"
            s = "fecha"
        end
        if s == "fecha" or s == "cpu" or s == "memoria" or s == "tareas" or s == "discos" or s == "red"
            r.push(s)
        end
    end
    return r
end

func esta(lista: [String], s: String) -> Bool
    for i in (0..lista.length - 1)
        if lista[i] == s
            return true
        end
    end
    return false
end

Main
    prefs = file_read_text("ENV:Trasfondo.prefs")
    if prefs == nil
        prefs = file_read_text("ENVARC:Trasfondo.prefs")
    end
    if prefs == nil
        prefs = ""
    end
    var antes: [String] = secciones_de(conf("MOSTRAR", SECCIONES))
    # unas de antes de la 0.7 (sin PREFS=) no conocían la fecha: sale marcada, arriba, como en Trasfondo
    if conf("MOSTRAR", "") != "" and conf("PREFS", "") == "" and not esta(antes, "fecha")
        var con_fecha: [String] = ["fecha"]
        for i in (0..antes.length - 1)
            con_fecha.push(antes[i])
        end
        antes = con_fecha
    end

    # medido con la fuente de la pantalla, la que usan los gadgets (en Coffin, más grande que la Topaz 8)
    f = screen_font_height()
    fila = f + 8
    if fila < 16
        fila = 16
    end
    m = 12                                   # el margen, por dentro de los bordes
    var etiquetas: [String] = [tr(MSG_VER_FECHA, "Show the date and time"), tr(MSG_VER_CPU, "Show the CPU graph"), tr(MSG_VER_MEMORIA, "Show the free memory"), tr(MSG_VER_TAREAS, "Show the tasks"), tr(MSG_VER_DISCOS, "Show the disks"), tr(MSG_VER_RED, "Show the network and WiFi")]
    t_cuantas = tr(MSG_CUANTAS, "Tasks shown")
    t_tecla = tr(MSG_TECLA, "Hotkey")
    t_oculto = tr(MSG_OCULTO, "Start hidden")
    t_buscar = tr(MSG_BUSCAR, "Look for new versions on GitHub")
    t_actualizar = tr(MSG_ACTUALIZAR, "Update")
    x_campo = m + screen_font_text_width(t_cuantas) + 10        # los campos, con su texto a la izquierda
    if x_campo < m + screen_font_text_width(t_tecla) + 10
        x_campo = m + screen_font_text_width(t_tecla) + 10
    end
    largo = screen_font_text_width(t_buscar)                    # las casillas, con el texto a la derecha
    if largo < screen_font_text_width(t_oculto)
        largo = screen_font_text_width(t_oculto)
    end
    for i in (0..etiquetas.length - 1)
        if largo < screen_font_text_width(etiquetas[i])
            largo = screen_font_text_width(etiquetas[i])
        end
    end
    ancho = m + 26 + 8 + largo + m
    if ancho < x_campo + 200
        ancho = x_campo + 200
    end
    alto_boton = f + 6
    hueco = 8                                # lo que separa los grupos (el doble, antes de los botones)
    alto = m * 2 + fila * 10 + 4 + 4 + hueco * 3 + alto_boton * 2
    # en una pantalla baja (640x256 con una fuente grande) no cabe: todo más junto. El borde de arriba es el
    # título, con la fuente de la pantalla
    cabe = screen_height() - (f + 3) - 4
    if alto > cabe
        fila = f + 4
        if fila < 12
            fila = 12
        end
        hueco = 4
        m = 6
        alto = m * 2 + fila * 10 + 4 + 4 + hueco * 3 + alto_boton * 2
    end
    arriba = 30                              # y la ventana, más arriba si hace falta
    if arriba + alto + f + 3 + 4 > screen_height()
        arriba = screen_height() - alto - f - 3 - 4
        if arriba < 0
            arriba = 0
        end
    end

    # la versión: la que hay, o la nueva que encontró Trasfondo (ENV:Trasfondo.nueva)
    yo = str_replace(program_version(), "TrasfondoPrefs ", "")
    hay_nueva = file_read_text("ENV:Trasfondo.nueva")
    linea_version = con(tr(MSG_TIENES, "You have %s"), yo)
    if hay_nueva != nil and str_trim(hay_nueva) != ""
        linea_version = con(tr(MSG_HAY_NUEVA, "There is a new version: %s"), str_trim(hay_nueva))
    end
    # flag 8: ancho y alto son el interior, que es desde donde cuentan los gadgets (la ventana es GimmeZeroZero)
    if window_create(tr(MSG_TITULO, "Trasfondo Preferences"), 60, arriba, ancho, alto, 8) == 0
        Print tr(MSG_SIN_VENTANA, "TrasfondoPrefs: cannot open the window")
    else
        gt_init()
        y = m
        x = m
        var claves: [String] = ["fecha", "cpu", "memoria", "tareas", "discos", "red"]
        var casillas: [Int] = []
        for i in (0..5)
            casillas.push(gt_checkbox(x, y, 26, f + 3, etiquetas[i], esta(antes, claves[i])))
            y = y + fila
        end
        y = y + 4
        ancho_n = screen_font_text_width("000") + 24
        tareas = gt_integer(x_campo, y, ancho_n, f + 6, t_cuantas, Int(conf("TAREAS", "6")))
        y = y + fila + 2
        tecla = gt_string(x_campo, y, ancho - x_campo - m, f + 6, t_tecla, conf("CX_POPKEY", ""), 40)
        y = y + fila + 2
        oculto = gt_checkbox(x, y, 26, f + 3, t_oculto, str_upper(conf("CX_POPUP", "YES")) == "NO")
        y = y + fila
        buscar = gt_checkbox(x, y, 26, f + 3, t_buscar, str_upper(conf("BUSCAR", "SI")) != "NO")
        y = y + fila + hueco
        ancho_act = screen_font_text_width(t_actualizar) + 24
        estado = gt_text(x, y, ancho - m * 2 - ancho_act - 8, alto_boton, "", linea_version)
        actualizar = gt_button(ancho - m - ancho_act, y, ancho_act, alto_boton, t_actualizar)
        y = y + alto_boton + hueco * 2
        boton = (ancho - m * 2 - 16) / 3
        guardar = gt_button(x, y, boton, alto_boton, tr(MSG_GUARDAR, "Save"))
        usar = gt_button(x + boton + 8, y, boton, alto_boton, tr(MSG_USAR, "Use"))
        cancelar = gt_button(x + (boton + 8) * 2, y, boton, alto_boton, tr(MSG_CANCELAR, "Cancel"))
        gt_attach()

        ultimo = ""
        pedido = 0                           # time_ms de cuando se pidió actualizar (0: no se ha pedido)
        while true
            e = gt_event()
            if e == -1                       # nada: mira cómo va lo que se pidió a Trasfondo
                time_delay(10)
                if pedido != 0
                    est = file_read_text("ENV:Trasfondo.estado")
                    if est != nil and str_trim(est) != "" and str_trim(est) != ultimo
                        ultimo = str_trim(est)
                        gt_set_text(estado, ultimo)
                        pedido = time_ms()
                    elif ultimo == "" and time_ms() - pedido > 8000
                        ultimo = tr(MSG_NO_ESTA, "Trasfondo is not running: start it and try again")
                        gt_set_text(estado, ultimo)
                    end
                end
            elif e == actualizar
                file_delete("ENV:Trasfondo.estado")
                file_write_text("ENV:Trasfondo.orden", "actualizar\n")
                gt_set_text(estado, tr(MSG_PEDIDO, "Asked Trasfondo..."))
                ultimo = ""
                pedido = time_ms()
            elif e == -2 or e == cancelar
                break
            elif e == guardar or e == usar
                # las marcadas, en el orden que tenían; las nuevas, detrás
                var mostrar: [String] = []
                for i in (0..antes.length - 1)
                    for j in (0..5)
                        if claves[j] == antes[i] and gt_get_value(casillas[j]) != 0
                            mostrar.push(antes[i])
                        end
                    end
                end
                for j in (0..5)
                    if gt_get_value(casillas[j]) != 0 and not esta(mostrar, claves[j])
                        mostrar.push(claves[j])
                    end
                end
                n = gt_get_value(tareas)
                if n < 1
                    n = 1
                elif n > 20
                    n = 20
                end
                texto = "PREFS=2\nMOSTRAR="     # PREFS=2: escritas sabiendo de la fecha
                for i in (0..mostrar.length - 1)
                    if i > 0
                        texto = texto + ","
                    end
                    texto = texto + str_upper(mostrar[i])
                end
                popup = "YES"
                if gt_get_value(oculto) != 0
                    popup = "NO"
                end
                busca = "SI"
                if gt_get_value(buscar) == 0
                    busca = "NO"
                end
                texto = texto + "\nTAREAS=#{n}\nCX_POPKEY=" + str_trim(gt_get_string(tecla)) + "\nCX_POPUP=" + popup + "\nBUSCAR=" + busca + "\n"
                file_write_text("ENV:Trasfondo.prefs", texto)
                if e == guardar
                    file_write_text("ENVARC:Trasfondo.prefs", texto)
                end
                break
            end
        end
        gt_cleanup()
    end
end
